<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- Why: the PostgreSQL VOCABULARY — native types, converters, container kinds, data nodes,
       paths and the command translators. Deliberately free of Fdw.Services.Connections so the
       dialect can be consumed without the connection service domain. Mirrors Fdw.Data.MsSql. -->
  <ItemGroup>
    <ProjectReference Include="..\..\foundation\abstractions\Fdw.Abstractions\Fdw.Abstractions.csproj" />
    <ProjectReference Include="..\..\foundation\collections\Fdw.Collections\Fdw.Collections.csproj" />
    <ProjectReference Include="..\..\commands\Fdw.Commands.Data.Abstractions\Fdw.Commands.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\commands\Fdw.Commands.Data\Fdw.Commands.Data.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\foundation\messagelogging\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
    <ProjectReference Include="..\..\foundation\messagelogging\Fdw.Messages\Fdw.Messages.csproj" />
    <ProjectReference Include="..\..\foundation\results\Fdw.Results.Abstractions\Fdw.Results.Abstractions.csproj" />
    <ProjectReference Include="..\..\foundation\results\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\..\schema\Fdw.Schema.Abstractions\Fdw.Schema.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Services.Connections.Abstractions\Fdw.Services.Connections.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Services.Connections.Sql\Fdw.Services.Connections.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\foundation\collections\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\foundation\messagelogging\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>


  <ItemGroup>
    <!-- A connection or storage adapter: it may use ADO.NET directly (FDW052, FDW-3579). -->
    <AssemblyAttribute Include="Fdw.Conventions.DataAccessAdapterAttribute" />
  </ItemGroup>

</Project>
