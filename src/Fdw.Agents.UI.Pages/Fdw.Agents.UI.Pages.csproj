<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Why: razor component namespaces derive from RootNamespace + folder path. Holding the
         original root keeps every generated component namespace identical to the consolidated
         package, so no page type's typeof(...) reference has to change. -->
    <RootNamespace>Fdw.UI.Pages</RootNamespace>
    <PackageId>Fdw.Agents.UI.Pages</PackageId>
    <Title>Fdw Agents UI Pages</Title>
    <Description>Razor pages for the Agents domain.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Agents.Clients\Fdw.Agents.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Agents.Components\Fdw.Agents.Components.csproj" />
    <ProjectReference Include="..\Fdw.Configuration\Fdw.Configuration.csproj" />
    <ProjectReference Include="..\Fdw.Configuration.Components\Fdw.Configuration.Components.csproj" />
    <ProjectReference Include="..\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Operations.Abstractions\Fdw.Operations.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Operations.Clients\Fdw.Operations.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Operations.Components\Fdw.Operations.Components.csproj" />
    <ProjectReference Include="..\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\Fdw.Services.Abstractions\Fdw.Services.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.UI\Fdw.UI.csproj" />
    <ProjectReference Include="..\Fdw.UI.Canvas.Blazor\Fdw.UI.Canvas.Blazor.csproj" />
    <ProjectReference Include="..\Fdw.UI.Charts.Blazor\Fdw.UI.Charts.Blazor.csproj" />
    <ProjectReference Include="..\Fdw.UI.Components\Fdw.UI.Components.csproj" />
    <ProjectReference Include="..\Fdw.UI.Pipelines.Clients\Fdw.UI.Pipelines.Clients.csproj" />
    <ProjectReference Include="..\Fdw.UI.Pipelines.Clients.Models\Fdw.UI.Pipelines.Clients.Models.csproj" />
    <ProjectReference Include="..\Fdw.UI.Themes.Clients\Fdw.UI.Themes.Clients.csproj" />
  </ItemGroup>

</Project>
