@page "/agent-actions"
@namespace Fdw.Agents.UI.Pages.Pages
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Agent Actions</PageTitle>

<AgentActionProvider AutoLoadList="true">
    <ChildContent Context="ctx">
        <div>
            <PageHeader Eyebrow="AI Agent Queue" Title="Pending Actions">
                <Actions>
                    <button class="btn btn-secondary btn-sm" @onclick="async () => await ctx.OnLoadActions()" disabled="@ctx.IsLoading">
                        @(ctx.IsLoading ? "Loading..." : "Refresh")
                    </button>
                </Actions>
            </PageHeader>

            @if (ctx.IsLoading && ctx.Actions.Count == 0)
            {
                <div class="card"><div class="card-b" style="padding:24px;color:var(--n-500);">Loading…</div></div>
            }
            else if (ctx.Actions.Count == 0)
            {
                <EmptyState SquarePadding="true" Class="mono u-fg-n500">NO_PENDING_ACTIONS</EmptyState>
            }
            else
            {
                <div class="card">
                    <div class="card-b">
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Agent</th>
                                    <th>Method</th>
                                    <th>Route</th>
                                    <th>Status</th>
                                    <th>Requested</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var action in ctx.Actions)
                                {
                                    <tr>
                                        <td class="cellpad mut">@action.Id</td>
                                        <td class="cellpad">
                                            <div class="nm">@action.AgentLabel</div>
                                            <div class="mut">@action.UserId</div>
                                        </td>
                                        <td class="cellpad">
                                            <Badge Variant="HttpMethodBadge.Variant(action.Method)">@action.Method</Badge>
                                        </td>
                                        <td class="cellpad mut">@action.Route</td>
                                        <td class="cellpad">
                                            <Badge Variant="StatusVariantFor(action.Status)">@action.Status</Badge>
                                        </td>
                                        <td class="cellpad mut">@action.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="cellpad">
                                            @if (string.Equals(action.Status, "Pending", StringComparison.Ordinal))
                                            {
                                                <button class="btn btn-primary btn-sm"
                                                        @onclick="@(() => Nav.NavigateTo("/review/" + action.Id))">
                                                    Review
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</AgentActionProvider>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private static StatusVariantBase StatusVariantFor(string status) => status switch
    {
        "Pending"  => StatusVariants.Warning,
        "Approved" => StatusVariants.Success,
        "Denied"   => StatusVariants.Error,
        _          => StatusVariants.Neutral
    };
}
