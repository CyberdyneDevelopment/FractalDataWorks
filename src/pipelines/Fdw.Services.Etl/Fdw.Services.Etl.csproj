<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fdw.Services.Etl</RootNamespace>
    <Description>ETL pipeline services for Fdw.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Enable generator debugging -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Services.Etl.Abstractions\Fdw.Services.Etl.Abstractions.csproj" />
    <ProjectReference Include="..\..\foundation\services\Fdw.Services\Fdw.Services.csproj" />
    <ProjectReference Include="..\..\foundation\services\Fdw.Services.Abstractions\Fdw.Services.Abstractions.csproj" />
    <ProjectReference Include="..\..\foundation\collections\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\foundation\messagelogging\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\configuration\Fdw.Configuration.SourceGenerators\Fdw.Configuration.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\configuration\Fdw.Configuration\Fdw.Configuration.csproj" />
    <ProjectReference Include="..\..\connections\Fdw.Services.Connections.Abstractions\Fdw.Services.Connections.Abstractions.csproj" />
    <!-- Why: IHttpRecordWriterConnection is in Http.Abstractions — needed for write-capability feature detection
         in the HTTP record loads (connection type invisible above the connection layer). -->
    <ProjectReference Include="..\..\connections\Fdw.Services.Connections.Http.Abstractions\Fdw.Services.Connections.Http.Abstractions.csproj" />
    <ProjectReference Include="..\..\commands\Fdw.Commands.Data\Fdw.Commands.Data.csproj" />
    <ProjectReference Include="..\..\commands\Fdw.Commands.Data.Fluency\Fdw.Commands.Data.Fluency.csproj" />
    <ProjectReference Include="..\Fdw.Operations.Abstractions\Fdw.Operations.Abstractions.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Services.Data.Abstractions\Fdw.Services.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Services.Pipelines\Fdw.Services.Pipelines.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Data\Fdw.Data.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Data.SourceGenerators\Fdw.Data.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\foundation\validation\Fdw.Validation\Fdw.Validation.csproj" />
    <ProjectReference Include="..\..\identity\authentication\Fdw.Services.Authentication.Abstractions\Fdw.Services.Authentication.Abstractions.csproj" />
    <ProjectReference Include="..\..\datasets\Fdw.Data.DataSets\Fdw.Data.DataSets.csproj" />
    <ProjectReference Include="..\..\identity\authorization\Fdw.Services.Authorization.Abstractions\Fdw.Services.Authorization.Abstractions.csproj" />
    <ProjectReference Include="..\..\connections\Fdw.Services.Connections\Fdw.Services.Connections.csproj" />
    <ProjectReference Include="..\Fdw.Services.EtlGateway\Fdw.Services.EtlGateway.csproj" />
    <ProjectReference Include="..\..\notifications\Fdw.Services.Notifications.Abstractions\Fdw.Services.Notifications.Abstractions.csproj" />
    <ProjectReference Include="..\..\configuration\Fdw.Services.Settings\Fdw.Services.Settings.csproj" />
    <ProjectReference Include="..\..\calculations\Fdw.Services.Calculations\Fdw.Services.Calculations.csproj" />
    <ProjectReference Include="..\Fdw.Operations\Fdw.Operations.csproj" />
    <!-- Why: IExecutionCompletionSignaler lives in Projects.Abstractions so the optional signaler
         hook in PipelineExecutionBackgroundService can call Signal without a circular reference.
         Services.Etl.Projects depends on Services.Etl, not the reverse. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why: lets Fdw.Services.Etl.Tests unit-test PipelineExecutionBackgroundService's internal
         EstablishSystemAuthenticationContext seam directly, without standing up the full pipeline
         execution dependency graph (IExecutionTracker, IDataGateway, etc.). -->
    <InternalsVisibleTo Include="Fdw.Services.Etl.Tests" />
  </ItemGroup>
</Project>
