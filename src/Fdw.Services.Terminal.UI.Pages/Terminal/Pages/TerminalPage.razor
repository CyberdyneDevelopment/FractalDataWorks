@page "/terminal"
@using Fdw.Services.Terminal.Components.Terminal
@using Fdw.Services.Terminal
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject ITerminalService TerminalService

<PageTitle>Terminal | Cyberdyne</PageTitle>

<CascadingValue Value="this">
    <div class="content" style="display:flex;flex-direction:column;height:100%;">
        <!-- Header -->
        <div class="pagehead">
            <div>
                <div class="ey">System</div>
                <h1>Terminal</h1>
                <div class="sub mono">
                    @(_activeSessionId == Guid.Empty ? "WAITING_FOR_SESSION" : $"SID: {_activeSessionId}")
                </div>
            </div>
            <div class="actions">
                <select @bind="_selectedAgent" class="finput mono" style="padding:7px 12px;">
                    <option value="bash">Standard Bash</option>
                    <option value="claude">Claude Code</option>
                    <option value="ollama">Ollama (Qwen2.5)</option>
                    <option value="gemini">Gemini Flash</option>
                </select>

                <button @onclick="CreateNewSession" class="btn btn-primary">
                    <Icon Name="AddAlt" />
                    New Session
                </button>

                <button @onclick="ToggleFullscreen" class="btn btn-ghost">
                    @if (_isFullscreen)
                    {
                        <Icon Name="FullscreenExit" />
                    }
                    else
                    {
                        <Icon Name="Fullscreen" />
                    }
                </button>
            </div>
        </div>

        <!-- Terminal Container -->
        <div class="card" style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
            <div class="card-h"><h3>fdw — admin console</h3><span class="meta">AUDITED</span></div>
            <HeadlessTerminal UserId="_userId" SessionId="_activeSessionId" Command="@_selectedAgent" OnSessionCreated="HandleSessionCreated">
                <ChildContent Context="terminal">
                    <XTermTerminal Context="terminal" Class="term" />
                    
                    <!-- Mobile Toolbar -->
                    <div class="seg" style="display:flex;align-items:center;gap:8px;padding:8px;border-top:1px solid var(--hair);overflow-x:auto;">
                        <button @onclick='() => terminal.SendCommand("\x1b")'>ESC</button>
                        <button class="@(_ctrlActive ? "on" : "")" @onclick='() => _ctrlActive = !_ctrlActive'>CTRL</button>
                        <button class="@(_altActive ? "on" : "")" @onclick='() => _altActive = !_altActive'>ALT</button>
                        <button @onclick='() => terminal.SendCommand("\t")'>TAB</button>

                        <div class="u-flex-1"></div>

                        <button @onclick='() => terminal.SendCommand("\x1b[A")'><Icon Name="ChevronUp" Style="width:14px;height:14px;" /></button>
                        <button @onclick='() => terminal.SendCommand("\x1b[D")'><Icon Name="ChevronLeft" Style="width:14px;height:14px;" Rounded="false" /></button>
                        <button @onclick='() => terminal.SendCommand("\x1b[B")'><Icon Name="ChevronDown" Style="width:14px;height:14px;" Rounded="false" /></button>
                        <button @onclick='() => terminal.SendCommand("\x1b[C")'><Icon Name="ChevronRight" Style="width:14px;height:14px;" Rounded="false" /></button>
                    </div>
                </ChildContent>
            </HeadlessTerminal>
        </div>
    </div>
</CascadingValue>

@code {
    [CascadingParameter] public MainLayoutBase? Layout { get; set; }

    private bool _isFullscreen;
    private Guid _userId;
    private Guid _activeSessionId = Guid.Empty;
    private string _selectedAgent = "bash";
    private bool _ctrlActive;
    private bool _altActive;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        
        if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var id))
        {
            _userId = id;
            
            var sessions = await TerminalService.GetUserSessions(_userId);
            if (sessions.IsSuccess && sessions.Value is { Count: > 0 } list)
            {
                _activeSessionId = list[0].SessionId;
            }
        }
    }

    protected override void OnInitialized()
    {
        Layout?.SetNoPadding(true);
    }

    public void Dispose()
    {
        Layout?.SetNoPadding(false);
    }

    private void HandleSessionCreated(Guid sessionId)
    {
        _activeSessionId = sessionId;
        StateHasChanged();
    }

    private async Task CreateNewSession()
    {
        _activeSessionId = Guid.Empty;
        await Task.Delay(10);
        StateHasChanged();
    }

    private void ToggleFullscreen()
    {
        _isFullscreen = !_isFullscreen;
        Layout?.SetFullscreen(_isFullscreen);
    }
}
