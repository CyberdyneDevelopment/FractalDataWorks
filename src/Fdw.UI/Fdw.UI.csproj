<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Collections\Fdw.Collections.csproj" />
    <ProjectReference Include="..\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.Types.Abstractions\Fdw.Types.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\Fdw.Services.Abstractions\Fdw.Services.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Tailwind safelist: generated by scripts/generate-tailwind-safelist.sh -->
  <ItemGroup>
    <None Include="wwwroot\tailwind-safelist.html" Pack="true" PackagePath="content\tailwind-safelist.html" Condition="Exists('wwwroot\tailwind-safelist.html')" />
    <Content Include="wwwroot\tailwind-safelist.html" CopyToOutputDirectory="PreserveNewest" Link="tailwind-safelist.html" Condition="Exists('wwwroot\tailwind-safelist.html')" />
  </ItemGroup>

</Project>
