@namespace Fdw.Services.Catalog.Components.Glossary
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Services.Catalog.Clients
@using Fdw.Services.Catalog.Clients.Models
@using Fdw.Services.Catalog.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    // ── Parameters ──────────────────────────────────────────────────────────────

    [Parameter] public RenderFragment<GlossaryContext>? ChildContent { get; set; }

    // ── Injected Services ───────────────────────────────────────────────────────

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private CatalogApiClient? _catalogApi;
    [Inject] private ILogger<GlossaryProvider>? LoggerParam { get; set; }

    private ILogger<GlossaryProvider> _logger = NullLogger<GlossaryProvider>.Instance;

    // ── State ───────────────────────────────────────────────────────────────────

    private IReadOnlyList<GlossaryTermPayload> _terms = [];
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private string? _searchQuery;
    private GlossaryContext _context = new();
    private bool _initialized;

    // ── Lifecycle ───────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _catalogApi = new CatalogApiClient(HttpClientFactory.CreateClient("CatalogClient"), LoggerFactory?.CreateLogger<CatalogApiClient>()!);
        _logger = LoggerParam ?? NullLogger<GlossaryProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadTerms();
        }
    }

    // ── Private Operations ─────────────────────────────────────────────────────

    private async Task<IGenericResult> LoadTerms(CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        GlossaryProviderLog.LoadStarted(_logger);

        try
        {
            var termsResult = string.IsNullOrEmpty(_searchQuery)
                ? await _catalogApi!.GetGlossary(ct)
                : await _catalogApi!.SearchTerms(_searchQuery, ct);

            if (!termsResult.IsSuccess)
            {
                GlossaryProviderLog.LoadFailed(_logger);
                _lastResult = termsResult;
                _terms = [];
                return termsResult;
            }

            _terms = termsResult.Value?.ToList() ?? [];
            GlossaryProviderLog.LoadCompleted(_logger, _terms.Count);
            return termsResult;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { GlossaryProviderLog.LoadException(_logger, ex) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            _terms = [];
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleSearch(string query, CancellationToken ct = default)
    {
        _searchQuery = query;
        GlossaryProviderLog.Searching(_logger, query);
        await LoadTerms(ct);
    }

    private async Task HandleCreate(CreateGlossaryTermRequest request, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        GlossaryProviderLog.Creating(_logger, request.Term);

        try
        {
            var result = await _catalogApi!.CreateTerm(request, ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(GlossaryProviderLog.CreateFailed(_logger, request.Term));
                return;
            }

            GlossaryProviderLog.Created(_logger, request.Term);
            await LoadTerms(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { GlossaryProviderLog.CreateException(_logger, ex, request.Term) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleUpdate(Guid id, UpdateGlossaryTermRequest request, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        GlossaryProviderLog.Updating(_logger, id);

        try
        {
            var result = await _catalogApi!.UpdateTerm(id, request, ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(GlossaryProviderLog.UpdateFailed(_logger, id));
                return;
            }

            GlossaryProviderLog.Updated(_logger, id);
            await LoadTerms(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { GlossaryProviderLog.UpdateException(_logger, ex, id) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleDelete(Guid id, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        GlossaryProviderLog.Deleting(_logger, id);

        try
        {
            var result = await _catalogApi!.DeleteTerm(id, ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(GlossaryProviderLog.DeleteFailed(_logger, id));
                return;
            }

            GlossaryProviderLog.Deleted(_logger, id);
            await LoadTerms(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(GlossaryProviderLog.DeleteException(_logger, ex, id));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new GlossaryContext
        {
            Terms = _terms,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            SearchQuery = _searchQuery,
            OnSearch = query => HandleSearch(query),
            OnCreate = request => HandleCreate(request),
            OnUpdate = (id, request) => HandleUpdate(id, request),
            OnDelete = id => HandleDelete(id),
            OnRefresh = () => LoadTerms()
        };
    }
}
