@page "/pipelines"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Pipelines - Cyberdyne</PageTitle>

<PipelineProvider @ref="_provider">
    <ChildContent Context="provider">
        <div>
            @* Why: Run/Execute previously gave no user feedback — both success and failure
               collapsed into the provider's unrendered ErrorMessage (FINDINGS bug #3).
               Render an explicit result banner so the outcome is visible. *@
            @if (!string.IsNullOrEmpty(_runBanner))
            {
                <div class="card @(_runBannerIsError ? "b-fail" : "b-ok")" style="margin-bottom:14px;padding:11px 16px;display:flex;justify-content:space-between;align-items:center;"
                     role="alert">
                    <span class="mono u-fs-12">@_runBanner</span>
                    <button class="btn btn-ghost btn-sm" @onclick="() => _runBanner = null" title="Dismiss">✕</button>
                </div>
            }

            <div class="pagehead">
                <div>
                    <div class="ey">Pipelines &amp; Scheduling · @provider.Pipelines.Count</div>
                    <h1>Pipelines</h1>
                    <div class="sub">Process-stage executors with SignalR status. Trigger by API, manual, event, or schedule.</div>
                </div>
                <div class="actions">
                    <a href="/pipelines/new" class="btn btn-primary">
                        <Icon Name="Add" />
                        New Pipeline
                    </a>
                </div>
            </div>

            @if (provider.IsLoading && !provider.Pipelines.Any())
            {
                <div class="card fdw-empty-square">
                    <span class="mono u-fg-n500">Loading pipelines…</span>
                </div>
            }
            else if (!provider.Pipelines.Any())
            {
                <div class="card fdw-empty-square">
                    <p class="u-fg-n500">No pipelines configured</p>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-h"><h3>All Pipelines</h3></div>
                    <div class="card-b fdw-table-body">
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in provider.FilteredPipelines)
                                {
                                    <tr>
                                        <td>
                                            <a href="/pipelines/builder/@p.Id" class="cellpad nm">
                                                @p.Name
                                            </a>
                                        </td>
                                        <td class="mut">@p.PipelineType</td>
                                        <td>
                                            <button class="btn btn-ghost btn-sm"
                                                    @onclick="() => RunPipeline(provider, p.Name)"
                                                    title="Execute">
                                                <Icon Name="Play" />
                                            </button>
                                            <a href="/pipelines/builder/@p.Id" class="btn btn-ghost btn-sm" title="Edit">
                                                <Icon Name="Edit" />
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</PipelineProvider>

@code {
    private PipelineProvider _provider = null!;

    private string? _runBanner;
    private bool _runBannerIsError;

    // Why: TriggerJob returns the response on success or null on failure (provider records the
    // reason in ErrorMessage). Surface both as a visible banner so Run/Execute is no longer silent.
    private async Task RunPipeline(PipelineContext provider, string pipelineName)
    {
        _runBanner = null;
        var response = await provider.OnTriggerJob(pipelineName, null);
        if (response is not null)
        {
            _runBannerIsError = false;
            _runBanner = $"Pipeline '{pipelineName}' triggered (execution {response.ExecutionId}).";
        }
        else
        {
            // Why: read the freshly-rebuilt provider error via the @ref, not the captured render
            // context (that snapshot predates the trigger call and still holds a null error).
            _runBannerIsError = true;
            _runBanner = _provider.LastResult?.CurrentMessage is { Length: > 0 } err
                ? err
                : $"Failed to trigger pipeline '{pipelineName}'.";
        }
    }
}
