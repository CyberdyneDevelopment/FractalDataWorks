    private async Task SelectTask(Guid id)
    {
        _selectedTaskId = id;

        // Why: write-capability detection needs IConnectionType.SupportedCommands, which is not
        // exposed over the connections API (see GetSupportedCommands). Rather than assert a
        // possibly-false "no write capability" warning when the API genuinely doesn't know,
        // GetSupportedCommands logs the capability-data gap once per connection type (not on every
        // task selection); the prior write-capability warning is retired until real capability
        // data is available to evaluate honestly.
        var selected = _tasks.FirstOrDefault(t => t.Id == id);
        if (selected is not null
            && string.Equals(selected.Category, "Destination", StringComparison.Ordinal)
            && !string.IsNullOrEmpty(selected.ConnectionName))
        {
            var connDto = _availableConnections.FirstOrDefault(c =>
                string.Equals(c.Name, selected.ConnectionName, StringComparison.OrdinalIgnoreCase));
            if (connDto is not null)
                GetSupportedCommands(connDto.ConnectionType);
        }

        if (_testExecutionId.HasValue)
            UpdateInspectorForTask(id);
        await SaveBuilderSessionState();
    }

    private void UpdateInspectorForTask(Guid taskId)
    {
        // Why: Inspector state is fetched from the in-process inspector singleton via the
        // HTTP inspect endpoint. In the UI-only package we don't have direct access to the
        // inspector singleton — instead, fetch from the API so we get a consistent snapshot.
        // For now, the task update dict gives us the counters; full sample fetch would need
        // a separate HTTP call to /etl/executions/{id}/tasks/{taskId}/inspect.
        // The counters are already tracked in _taskUpdates; create a thin state wrapper here.
        if (_taskUpdates.TryGetValue(taskId, out var update))
        {
            _inspectorTaskState = null; // Reset to trigger re-render
            var task = _tasks.FirstOrDefault(t => t.Id == taskId);
            _inspectorItemLabel = task?.Name ?? taskId.ToString();
        }
    }

    private void SelectEdge(Guid sourceTaskId, Guid targetTaskId, string sourceName, string targetName)
    {
        _inspectorItemLabel = $"{sourceName} → {targetName}";
        _inspectorTaskState = null;
        _inspectorEdgeState = null;
        // Why: edge state only available from API call — set label for display, reset inspector content.
        StateHasChanged();
    }

    private string? GetTaskTestStatus(Guid taskId)
    {
        if (!_testExecutionId.HasValue) return null;
        if (!_taskUpdates.TryGetValue(taskId, out var update)) return null;
        return update.Status;
    }

    private TaskInspectorState? GetTaskInspectorState(Guid taskId)
    {
        if (!_testExecutionId.HasValue) return null;
        if (!_taskUpdates.TryGetValue(taskId, out var update)) return null;
        // Why: Build a thin state object from the broadcast update so the canvas badge renders
        // the counters without a full inspector fetch. Samples require a separate HTTP call.
        return new TaskInspectorState
        {
            RecordsIn = update.RecordsIn,
            RecordsOut = update.RecordsOut,
            RecordsDiscarded = update.RecordsDiscarded,
            RecordsHeld = update.RecordsHeld,
            SampleBufferAtCapacity = update.SampleBufferAtCapacity,
        };
    }

    private long GetEdgeFlowCount(Guid sourceTaskId, Guid targetTaskId)
    {
        var key = $"{sourceTaskId:N}_{targetTaskId:N}";
        return _edgeUpdates.TryGetValue(key, out var update) ? update.RecordsFlowed : 0;
    }

    // Why Running takes the success tone and Complete the running one: that is what this panel has
    // always drawn, and the pass that introduced Badge changed no colour anywhere. It disagrees with
    // every other execution view in the console and is the next thing to settle.
    private static StatusVariantBase GetStatusVariant(string status)
    {
        if (string.Equals(status, "Running", StringComparison.OrdinalIgnoreCase))
            return StatusVariants.Success;
        if (string.Equals(status, "Paused", StringComparison.OrdinalIgnoreCase))
            return StatusVariants.Warning;
        if (string.Equals(status, "Complete", StringComparison.OrdinalIgnoreCase))
            return StatusVariants.Info;
        if (string.Equals(status, "Failed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            return StatusVariants.Error;
        return StatusVariants.Neutral;
    }

    // Why: IAsyncDisposable implementation ensures the SignalR connection is cleanly
    // closed when the component is navigated away from.
    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    // Why: Private DTO for deserializing the test run response from the ETL API. This
    // avoids a dependency on the reference-etl package from the FDW UI package.
    private sealed class TestRunResponseDto
    {
        public Guid? ExecutionId { get; set; }
        public string? Status { get; set; }
    }

    private bool ValidatePipeline()
    {
        if (string.IsNullOrWhiteSpace(_pipelineName))
        {
            _validationError = "Pipeline name is required";
            return false;
        }
        if (_tasks.Count == 0)
        {
            _validationError = "Pipeline must have at least one task";
            return false;
        }
        _validationError = null;
        return true;
    }

    private async Task SavePipeline()
    {
        if (!ValidatePipeline()) return;
        _isSaving = true;
        try
        {
            // Why: delegate save to the provider which projects the canvas model to an
            // EtlPipelineConfiguration and persists via PipelineServiceConfigurationProvider.Save.
            // No client-side task-list serialization — the canvas model is authoritative.
            var success = await _builderProvider.Save(_pipelineName, _pipelineDescription);
            if (success)
            {
                // Why: refresh pipelineId after save so test-run dispatch and Publish button
                // work immediately for a pipeline that was just created (was null before save).
                _pipelineId = _builderProvider.PipelineConfigurationId;
                Nav.NavigateTo("/pipelines");
            }
            else
            {
                _validationError = _builderProvider.LastResult?.CurrentMessage ?? "Failed to save pipeline";
            }
        }
        catch
        {
            _validationError = "Failed to save pipeline";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task PublishPipeline()
    {
        if (string.IsNullOrWhiteSpace(_pipelineName)) return;
        _isPublishing = true;
        _validationError = null;
        try
        {
            // Why: Publish projects the canvas model to ETL config and calls Save with Active status.
            var success = await _builderProvider.Context.OnPublish(_pipelineName);
            if (success)
            {
                Nav.NavigateTo("/pipelines");
            }
            else
            {
                _validationError = _builderProvider.LastResult?.CurrentMessage ?? "Failed to publish pipeline";
            }
        }
        catch
        {
            _validationError = "Failed to publish pipeline";
        }
        finally
        {
            _isPublishing = false;
        }
    }

    // Why: Node accent colors aligned to the console design palette
    // (glacier/green/signal/violet) so the canvas matches the Reference Console.
    // Why: Collapsed SqlQuery/HttpSource/FileSource into a single "Source" entry. The connection
    // selected on the task now drives which query fields appear in the properties panel via
    // IConnectionType.DataQueryType.ConfigurationFields — no need for separate palette entries
    // per connection technology. Same principle applies to Destination.
    private List<TaskCategory> _taskCategories = new()
    {
        new("Source", new List<TaskInfo>
        {
            new("Source", "Source", "Source", "Read from a connection or dataset"),
        }),
        new("Transform", new List<TaskInfo>
        {
            new("Filter", "Filter", "Transform", "Filter rows by condition"),
            new("Map", "Map", "Transform", "Transform field values"),
            new("Join", "Join", "Transform", "Join two streams"),
            new("Aggregate", "Aggregate", "Transform", "Group and aggregate data"),
            new("Sort", "Sort", "Transform", "Sort rows by columns"),
            new("Deduplicate", "Deduplicate", "Transform", "Remove duplicate rows"),
            new("Pivot", "Pivot", "Transform", "Pivot rows to columns"),
            new("Unpivot", "Unpivot", "Transform", "Unpivot columns to rows"),
        }),
        new("Destination", new List<TaskInfo>
        {
            new("Destination", "Destination", "Destination", "Write to a connection or dataset"),
        }),
        new("Control", new List<TaskInfo>
        {
            new("Conditional", "Conditional", "Control", "Branch on condition"),
            new("Union", "Union", "Control", "Combine streams"),
            new("Loop", "Loop", "Control", "Iterate over items"),
            new("ErrorHandler", "Error Handler", "Control", "Handle errors gracefully"),
        }),
        new("Diagnostics", new List<TaskInfo>
        {
            // Why: Trash is a runtime concept — records routed here are counted, optionally
            // buffered, and optionally written to a log sink (Wave 0c runtime). Placed under
            // Diagnostics rather than Control because it produces no downstream data stream.
            new("Trash", "Trash", "Diagnostics", "Discard and count rejected records"),
        }),
    };

    private class TaskNode
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string TaskType { get; set; } = "";
        public string StepType { get; set; } = "";
        public string Category { get; set; } = "";
        public int X { get; set; }
        public int Y { get; set; }
        public string ConnectionName { get; set; } = "";
        public string DataSetName { get; set; } = "";

        // Why: canvas node IDs are strings; storing the mapping here avoids a
        // O(n) scan every time the inspector needs to write back to the canvas model.
        public string? CanvasNodeId { get; set; }

        // Per-transform configuration — keyed by TransformFieldDescriptor.Key values from the
        // matching TransformationType's ConfigurationFields. Only populated when StepType=="Transform".
        // The persistence layer serializes these into the task's Configuration dict on save and
        // the server writes them to the matching pipe.PipelineTransform{Subtype} columns.
        public string TransformType { get; set; } = "";
        public Dictionary<string, string> TransformFields { get; set; } = new(StringComparer.Ordinal);

        public string GetTransformValue(string key)
            => TransformFields.TryGetValue(key, out var v) ? v : string.Empty;

        public void SetTransformValue(string key, string value)
        {
            if (string.IsNullOrEmpty(value))
                TransformFields.Remove(key);
            else
                TransformFields[key] = value;
        }

        public IDictionary<string, object?> Configuration { get; set; } = new Dictionary<string, object?>(StringComparer.Ordinal);
    }

    private class ConnectionModel
    {
        public Guid Id { get; set; }
        public Guid SourceTaskId { get; set; }
        public Guid TargetTaskId { get; set; }
    }

    private record TaskCategory(string Name, List<TaskInfo> Tasks);
    private record TaskInfo(string Name, string DisplayName, string Category, string Description);
}
