    private async Task StartTestRun()
    {
        if (_pipelineId == null)
        {
            _validationError = "Save the pipeline before running a test";
            return;
        }

        _testExecutionStatus = "Starting";
        _testRunActive = false;
        _taskUpdates.Clear();
        _edgeUpdates.Clear();
        _testLogLines.Clear();
        _inspectorTaskState = null;
        _inspectorEdgeState = null;
        _inspectorItemLabel = null;

        try
        {
            var etlBaseUrl = NavigationManager.BaseUri.TrimEnd('/').Replace(":5010", ":5011", StringComparison.Ordinal);
            var client = HttpClientFactory.CreateClient();
            var payload = System.Text.Json.JsonSerializer.Serialize(new
            {
                PipelineId = _pipelineId.Value,
                MaxRowsPerSource = 100,
                SkipDestinationWrites = true,
                TriggerSource = "TestRun:Builder"
            });
            var content = new System.Net.Http.StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync($"{etlBaseUrl}/etl/trigger/test", content);

            if (!response.IsSuccessStatusCode)
            {
                _validationError = $"Test run failed to start ({(int)response.StatusCode})";
                _testExecutionStatus = "";
                return;
            }

            var json = await response.Content.ReadAsStringAsync();
            var testResponse = System.Text.Json.JsonSerializer.Deserialize<TestRunResponseDto>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (testResponse?.ExecutionId == null)
            {
                _validationError = "Test run response was missing execution ID";
                _testExecutionStatus = "";
                return;
            }

            _testExecutionId = testResponse.ExecutionId;
            _testExecutionStatus = testResponse.Status ?? "Queued";
            _testRunActive = true;
            _testIsPaused = false;

            await ConnectSignalR(_testExecutionId.Value);
        }
        catch (Exception ex)
        {
            _validationError = $"Test run error: {ex.Message}";
            _testExecutionStatus = "";
        }

        StateHasChanged();
    }

    private async Task ConnectSignalR(Guid executionId)
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
            _hubConnection = null;
        }

        var etlBaseUrl = NavigationManager.BaseUri.TrimEnd('/').Replace(":5010", ":5011", StringComparison.Ordinal);
        // Why: HubConnectionBuilder.WithUrl requires an absolute URL. Derive it from NavigationManager
        // so it works in any deployment without hardcoding ports.
        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{etlBaseUrl}/hubs/pipelines", options =>
            {
                // Why: the pipeline hub is [Authorize]d (FDW-545). The .NET SignalR client sends this
                // token as a bearer credential on negotiate/connect; the ETL server validates it via
                // OpenIddict. No token => 401, which is the correct fail-loud behavior (no anonymous path).
                options.AccessTokenProvider = () => TokenProvider.GetAccessToken();
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<PipelineTaskStatusUpdate>("OnTaskStatusChanged", update =>
        {
            if (update.ExecutionId != executionId) return;
            _taskUpdates[update.TaskId] = update;
            // Update inspector if this task is currently selected in the inspector.
            if (_inspectorTaskState != null && _inspectorItemLabel != null)
            {
                var matchingTask = _tasks.FirstOrDefault(t => t.Id == update.TaskId);
                if (matchingTask != null && string.Equals(matchingTask.Name, _inspectorItemLabel, StringComparison.Ordinal))
                    UpdateInspectorForTask(update.TaskId);
            }
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<PipelineEdgeFlowUpdate>("OnEdgeFlow", update =>
        {
            if (update.ExecutionId != executionId) return;
            var key = $"{update.SourceTaskId:N}_{update.TargetTaskId:N}";
            _edgeUpdates[key] = update;
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<Guid>("OnExecutionPaused", id =>
        {
            if (id != executionId) return;
            _testIsPaused = true;
            _testExecutionStatus = "Paused";
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<Guid>("OnExecutionResumed", id =>
        {
            if (id != executionId) return;
            _testIsPaused = false;
            _testExecutionStatus = "Running";
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<PipelineStatusUpdate>("OnStatusChanged", update =>
        {
            if (update.ExecutionId != executionId) return;
            _testExecutionStatus = update.Status;
            if (string.Equals(update.Status, "Complete", StringComparison.OrdinalIgnoreCase)
                || string.Equals(update.Status, "Failed", StringComparison.OrdinalIgnoreCase)
                || string.Equals(update.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            {
                _testRunActive = false;
            }
            AppendLogLine($"[{update.Status}] {update.Message}");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<PipelineProgressUpdate>("OnProgressUpdated", update =>
        {
            if (update.ExecutionId != executionId) return;
            AppendLogLine($"Extracted: {update.RecordsExtracted} | Loaded: {update.RecordsLoaded} | Failed: {update.RecordsFailed}");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<PipelineExecutionComplete>("OnExecutionCompleted", complete =>
        {
            if (complete.ExecutionId != executionId) return;
            _testExecutionStatus = "Complete";
            _testRunActive = false;
            AppendLogLine($"Execution completed: {complete.PipelineName} — {complete.RecordsLoaded} loaded");
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
        // Why: SubscribeToExecution is the PipelineStatusHub verb that joins the execution:{id}
        // group. Task/edge/pause/resume events broadcast ONLY to that group, so without this the
        // live node/edge animations never arrive. (The prior "JoinGroup" verb had no hub handler.)
        await _hubConnection.SendAsync("SubscribeToExecution", executionId);
        AppendLogLine($"Connected to execution group {executionId}");
    }

    private void AppendLogLine(string? line)
    {
        if (string.IsNullOrEmpty(line)) return;
        _testLogLines.Add($"[{DateTime.UtcNow:HH:mm:ss}] {line}");
        if (_testLogLines.Count > MaxLogLines)
            _testLogLines.RemoveAt(0);
    }

