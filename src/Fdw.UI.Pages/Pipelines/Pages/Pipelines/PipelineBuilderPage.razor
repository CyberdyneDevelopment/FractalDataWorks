@page "/pipelines/{Id:guid}/edit"
@page "/pipelines/builder/{PipelineId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@using Fdw.Services.Pipelines.Hubs
@using Fdw.Services.Etl.Abstractions.Execution
@using Fdw.Services.Connections.Abstractions
@using Fdw.Services.Pipelines.Components.Canvas
@using Fdw.Services.Pipelines.Components.Logging
@using Fdw.UI.Abstractions.Canvas
@using Fdw.UI.Canvas.Blazor.Host
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@implements IAsyncDisposable

<PipelineBuilderProvider @ref="_builderProvider" PipelineId="@EffectivePipelineId" InitialSourceDataSet="@SourceDataSet" OnInitialLoadComplete="HandleProviderLoaded">
<ChildContent Context="pipelineBuilder">

<PageTitle>Pipeline Builder - Cyberdyne</PageTitle>

<div class="content builder" style="display:flex;flex-direction:column;height:calc(100vh - 90px);padding:0;">
    <!-- Toolbar -->
    <div class="bhead u-mb-12">
        <div class="l">
            <a class="back" href="/pipelines">
                <Icon Name="ChevronLeftAlt" />
                Pipelines
            </a>
            <h1>Pipeline Builder</h1>
            <input class="finput mono" style="width:200px;padding:7px 10px;" placeholder="Pipeline name..." @bind="_pipelineName" />
            @* Why: PipelineType is a required engine discriminator with no default (see
               CreatePipelineClientRequest/PipelineCreateRequestProjection) — a new pipeline's canvas
               carries no PipelineType until the user picks one here; shown only while unset so a
               loaded pipeline (which already carries its engine type) never re-prompts. *@
            @if (pipelineBuilder.CanvasModel is not null && string.IsNullOrEmpty(pipelineBuilder.CanvasModel.PipelineType))
            {
                <select class="finput mono" style="width:160px;padding:7px 10px;"
                        value="@pipelineBuilder.CanvasModel.PipelineType"
                        @onchange="@(async e => { var selected = e.Value?.ToString(); if (!string.IsNullOrEmpty(selected)) await pipelineBuilder.OnSetPipelineType(selected); })">
                    <option value="">Select engine type...</option>
                    @foreach (var pipelineType in pipelineBuilder.PipelineTypes)
                    {
                        <option value="@pipelineType.Name">@pipelineType.Name</option>
                    }
                </select>
            }
        </div>
        <div class="actions">
            <button class="btn btn-ghost btn-sm" @onclick="Undo" disabled="@(_undoStack.Count == 0)">
                <Icon Name="Undo" />
                Undo
            </button>
            <button class="btn btn-ghost btn-sm" @onclick="Redo" disabled="@(_redoStack.Count == 0)">
                <Icon Name="Redo" />
                Redo
            </button>
            <button class="btn btn-ghost btn-sm" @onclick="ZoomOut">
                <Icon Name="ZoomOut" />
            </button>
            <span class="mono u-fs-11" style="width:48px;text-align:center;color:var(--n-400);">@(Math.Round(_zoom * 100))%</span>
            <button class="btn btn-ghost btn-sm" @onclick="ZoomIn">
                <Icon Name="ZoomIn" />
            </button>
            @if (!string.IsNullOrEmpty(_validationError))
            {
                <span class="mono u-fs-11" style="color:var(--signal);">@_validationError</span>
            }

            @* Test-mode toolbar — shown when a test run is active *@
            @if (_testRunActive)
            {
                <div class="actions" style="padding-left:8px;border-left:1px solid var(--hair);">
                    @if (_testIsPaused)
                    {
                        <button class="btn btn-secondary btn-sm u-fg-success"
                                @onclick="TestResume" title="Resume execution">
                            <Icon Name="Resume" />
                            Resume
                        </button>
                        <button class="btn btn-secondary btn-sm u-fg-glacier"
                                @onclick="TestStep" title="Step one batch">
                            <Icon Name="Skip" />
                            Step
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" style="color:var(--warn);"
                                @onclick="TestPause" title="Pause execution">
                            <Icon Name="Pause" />
                            Pause
                        </button>
                    }
                    <button class="btn btn-secondary btn-sm u-fg-signal"
                            @onclick="TestStop" title="Stop execution">
                        <Icon Name="Stop" />
                        Stop
                    </button>
                    <Badge Variant="GetStatusVariant(_testExecutionStatus)">@_testExecutionStatus</Badge>
                </div>
            }
            else
            {
                <button class="btn btn-secondary btn-sm u-fg-glacier"
                        @onclick="StartTestRun"
                        title="Run pipeline in test mode (bounded, no destination writes)">
                    <Icon Name="Run" />
                    Test
                </button>
            }

            <button class="btn btn-primary btn-sm" @onclick="SavePipeline" disabled="@_isSaving">
                <Icon Name="Save" />
                @(_isSaving ? "Saving..." : "Save")
            </button>
            <button class="btn btn-secondary btn-sm u-fg-success"
                    @onclick="PublishPipeline"
                    disabled="@(_isPublishing || _pipelineId == null)"
                    title="Publish pipeline to make it active">
                <Icon Name="CheckCircle" />
                @(_isPublishing ? "Publishing..." : "Publish")
            </button>
        </div>
    </div>

    <div style="flex:1;display:flex;gap:12px;overflow:hidden;min-height:0;">
        <!-- Test execution panel (shown during active test run, replaces Properties panel) -->
        @if (_testRunActive || _testExecutionId.HasValue)
        {
            <div class="pane" style="width:320px;flex:none;overflow:hidden;">
                <PipelineExecutionPanel
                    ExecutionStatus="@_testExecutionStatus"
                    IsRunning="@(_testRunActive && !_testIsPaused)"
                    IsPaused="@_testIsPaused"
                    LogLines="@_testLogLines"
                    InspectorTaskState="@_inspectorTaskState"
                    InspectorEdgeState="@_inspectorEdgeState"
                    InspectorItemLabel="@_inspectorItemLabel"
                    OnPause="TestPause"
                    OnResume="TestResume"
                    OnStep="TestStep"
                    OnStop="TestStop"
                    OnClose="CloseExecutionPanel"
                    OnInspectorClose="CloseInspector" />
            </div>
        }

        <!-- Task Palette -->
        <div class="pane" style="width:224px;flex:none;overflow-y:auto;">
            <div class="ph">Nodes</div>
            <div class="pb">
                @foreach (var category in _taskCategories)
                {
                    <div style="margin-bottom:10px;">
                        <div class="mono u-fs-9-5 u-ls-12 u-upper" style="color:var(--n-500);margin-bottom:6px;">@category.Name</div>
                        @foreach (var task in category.Tasks)
                        {
                            <div class="palitem"
                                 style="flex-direction:column;align-items:flex-start;gap:2px;margin-bottom:4px;"
                                 draggable="true"
                                 @ondragstart="() => _draggedTaskType = task.Name">
                                <div class="mono u-fs-12" style="color:var(--n-100);">@task.DisplayName</div>
                                <div class="mono u-fs-9" style="color:var(--n-500);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%;">@task.Description</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Canvas — rendered by CanvasHost using the projected PipelineCanvasModel -->
        <div class="canvas u-r-14" style="flex:1;position:relative;overflow:hidden;"
             @ondragover:preventDefault
             @ondrop="OnCanvasDrop">
            @if (_builderProvider.CanvasModel is not null)
            {
                @* Why: CanvasHost dispatches to the registered renderer via DynamicComponent,
                   keeping Builder.razor free of any direct dependency on a specific SVG or
                   WebGL renderer implementation. *@
                <CanvasHost Model="@_builderProvider.CanvasModel" />
            }
            else if (!_builderProvider.Context.IsLoading)
            {
                <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
                    <div style="text-align:center;color:var(--n-500);">
                        <p class="mono u-fs-13">Drag tasks from the palette to build your pipeline</p>
                    </div>
                </div>
            }
        </div>

        <!-- Properties Panel -->
        <div class="pane" style="width:288px;flex:none;overflow-y:auto;">
            <div class="ph">Inspector</div>
            <div class="pb">
            @if (_selectedTask != null)
            {
                <div style="display:flex;flex-direction:column;gap:16px;">
                    <div class="frow u-mb-0">
                        <label>Name</label>
                        <input class="finput" @bind="_selectedTask.Name" />
                    </div>
                    <div class="frow u-mb-0">
                        <label>Type</label>
                        <input class="finput mono" value="@_selectedTask.TaskType" disabled />
                    </div>
                    <div class="frow u-mb-0">
                        <label>Step Type</label>
                        @if (pipelineBuilder.PipelineStepTypes.Count > 0)
                        {
                            <select class="finput" @bind="_selectedTask.StepType">
                                <option value="">Select step type...</option>
                                @foreach (var st in pipelineBuilder.PipelineStepTypes)
                                {
                                    <option value="@st.TypeName">@st.DisplayName</option>
                                }
                            </select>
                        }
                        else
                        {
                            <select class="finput" @bind="_selectedTask.StepType">
                                <option value="">Select step type...</option>
                                <option value="Extract">Extract</option>
                                <option value="Transform">Transform</option>
                                <option value="Load">Load</option>
                                <option value="Validate">Validate</option>
                                <option value="Notify">Notify</option>
                                <option value="Branch">Branch</option>
                            </select>
                        }
                    </div>
                    @if (_selectedTask.Category == "Source" || _selectedTask.Category == "Destination")
                    {
                        <DataSetPicker SelectedDataSetName="@_selectedTask.DataSetName"
                                       SelectedDataSetNameChanged="@(name => OnDataSetSelectionChanged(_selectedTask, name))"
                                       AvailableDataSets="@(pipelineBuilder.DataSets ?? (IReadOnlyList<DataSetSummaryPayload>)[])"
                                       OnCreateDataSet="@(req => OnCreateDataSetFromPicker(_selectedTask, req))" />
                    }

                    @{
                        // Why: Compute all dynamic fields outside any @if so the local variables
                        // survive into subsequent markup blocks within the same Razor scope.
                        // supportedCaps drives the connection-driven input form.
                        // taskType drives the task-type-level fields (e.g., Trash buffer size).
                        var connDto = string.IsNullOrEmpty(_selectedTask?.ConnectionName)
                            ? null
                            : _availableConnections.FirstOrDefault(c => string.Equals(c.Name, _selectedTask.ConnectionName, StringComparison.OrdinalIgnoreCase));
                        var supportedCaps = GetSupportedCommands(connDto?.ConnectionType);

                        // Why: Backward-compat heuristic — tasks saved before FDW-391 have a
                        // "Query" key but no "CapabilityName". Default to RawQuery in that case
                        // so existing pipelines render the same textarea they always did.
                        var capabilityName = ReadConfigString(_selectedTask!.Configuration, "CapabilityName");
                        if (string.IsNullOrEmpty(capabilityName)
                            && supportedCaps.Count > 0
                            && !string.IsNullOrEmpty(ReadConfigString(_selectedTask.Configuration, "Query")))
                        {
                            capabilityName = "RawQuery";
                        }

                        var selectedCap = supportedCaps.Count > 0 && !string.IsNullOrEmpty(capabilityName)
                            ? supportedCaps.FirstOrDefault(c => string.Equals(c.Name, capabilityName, StringComparison.Ordinal))
                            : null;
                        var capFields = selectedCap?.ConfigurationFields;

                        var taskType = PipelineTaskTypes.ByName(_selectedTask!.TaskType);

                        // Why: write-capability mode computed here (in the shared outer @{} block)
                        // so it is in scope for both the badge markup and the log call that follow.
                        // Destination write mode: "Table" = any insert/update/bulk command present;
                        // "API" = HttpRequest present; "None" = no write-capable commands.
                        var writeCapNames = new[] { "Insert", "BulkInsert", "Update", "Upsert", "BulkUpsert" };
                        var destHasTableWrite = supportedCaps.Any(c =>
                            writeCapNames.Any(wn => string.Equals(c.Name, wn, StringComparison.Ordinal)));
                        var destHasApiWrite = supportedCaps.Any(c =>
                            string.Equals(c.Name, "HttpRequest", StringComparison.Ordinal));
                        var destWriteMode = destHasTableWrite ? "Table" : destHasApiWrite ? "API" : "None";
                    }
                    @if (_selectedTask.Category == "Source" || _selectedTask.Category == "Destination")
                    {
                        @* Connection picker — drives which capability picker appears below *@
                        <div class="frow u-mb-0">
                            <label>Connection</label>
                            @* Why: value+@onchange instead of @bind so we can also trigger
                               canvas metadata write-back when the user changes the connection. *@
                            <select class="finput"
                                    value="@_selectedTask.ConnectionName"
                                    @onchange="@(async e => { _selectedTask.ConnectionName = e.Value?.ToString() ?? string.Empty; await SyncTaskMetadataToCanvas(_selectedTask); })">
                                <option value="">Select connection...</option>
                                @foreach (var conn in _availableConnections)
                                {
                                    <option value="@conn.Name">@conn.Name</option>
                                }
                            </select>
                        </div>

                        @* Capability picker — shown only when the connection has supported commands *@
                        @if (supportedCaps.Count > 0)
                        {
                            <div class="frow u-mb-0">
                                <label>Command</label>
                                <select class="finput"
                                        value="@capabilityName"
                                        @onchange="@(e => SetSelectedCapability(_selectedTask!, e.Value?.ToString() ?? string.Empty))">
                                    <option value="">Select command...</option>
                                    @foreach (var cap in supportedCaps)
                                    {
                                        <option value="@cap.Name">@((cap as CommandCapabilityTypeBase)?.DisplayName ?? cap.Name)</option>
                                    }
                                </select>
                            </div>
                        }

                        @* ── Destination write-capability badge ──────────────────────────── *@
                        @* Why: show the write capability of the selected Destination's connection
                           so designers can see at a glance whether the destination supports
                           table writes, API writes, or has no write capability at all.
                           If no write capability exists, log a structured warning so it is
                           captured in diagnostics without blocking further UI interaction.
                           Guarded on supportedCaps.Count > 0 — when capability data is unavailable
                           (see GetSupportedCommands) destWriteMode would always evaluate to "None",
                           which is a fabricated negative, not an observed fact; omit the badge rather
                           than assert a capability verdict we don't actually have data for. *@
                        @if (string.Equals(_selectedTask.Category, "Destination", StringComparison.Ordinal)
                             && connDto is not null
                             && supportedCaps.Count > 0)
                        {
                            <div class="frow u-mb-0">
                                <label>Write Capability</label>
                                @if (string.Equals(destWriteMode, "None", StringComparison.Ordinal))
                                {
                                    <span class="badge b-fail" title="This connection has no write capability — save will be blocked">
                                        <span class="bd"></span>None — insufficient write capability
                                    </span>
                                }
                                else
                                {
                                    <span class="badge b-ok" title="Write mode: @destWriteMode">
                                        <span class="bd"></span>@destWriteMode
                                    </span>
                                }
                            </div>
                        }

                        @* Command configuration — composite widget or flat field list *@
                        @if (selectedCap is not null)
                        {
                            @if (selectedCap.BuilderComponentType is not null)
                            {
                                @* Why: DynamicComponent renders the capability-specific composite widget
                                   (e.g., QueryCommandBuilder) without a hard compile-time reference from
                                   this page to the Connections.UI.Components package. The component
                                   receives the task's Configuration dictionary directly so it can
                                   read/write capability fields without an intermediary. *@
                                <DynamicComponent Type="selectedCap.BuilderComponentType"
                                                  Parameters="@(new Dictionary<string, object?>(StringComparer.Ordinal) { ["TaskConfiguration"] = (object?)_selectedTask.Configuration })" />
                            }
                            else if (capFields is not null)
                            {
                                @foreach (var field in capFields)
                                {
                                    <div class="frow u-mb-0">
                                        <label>@field.Label</label>
                                        @if (string.Equals(field.InputKind, ConfigurationFieldKinds.Textarea, StringComparison.Ordinal))
                                        {
                                            <textarea class="finput mono u-fs-12" style="height:80px;"
                                                      placeholder="@field.Placeholder"
                                                      value="@_selectedTask.GetTransformValue(field.Key)"
                                                      @oninput="@(e => _selectedTask.SetTransformValue(field.Key, e.Value?.ToString() ?? string.Empty))"></textarea>
                                        }
                                        else if (string.Equals(field.InputKind, ConfigurationFieldKinds.Select, StringComparison.Ordinal))
                                        {
                                            <select class="finput"
                                                    value="@_selectedTask.GetTransformValue(field.Key)"
                                                    @onchange="@(e => _selectedTask.SetTransformValue(field.Key, e.Value?.ToString() ?? string.Empty))">
                                                <option value="">Select...</option>
                                                @if (field.SelectOptions is not null)
                                                {
                                                    @foreach (var opt in field.SelectOptions)
                                                    {
                                                        var parts = opt.Split(':', 2);
                                                        var optValue = parts[0];
                                                        var optLabel = parts.Length > 1 ? parts[1] : parts[0];
                                                        <option value="@optValue">@optLabel</option>
                                                    }
                                                }
                                            </select>
                                        }
                                        else if (string.Equals(field.InputKind, ConfigurationFieldKinds.Boolean, StringComparison.Ordinal))
                                        {
                                            <input type="checkbox"
                                                   checked="@string.Equals(_selectedTask.GetTransformValue(field.Key), "true", StringComparison.OrdinalIgnoreCase)"
                                                   @onchange="@(e => _selectedTask.SetTransformValue(field.Key, (e.Value is bool bv && bv) ? "true" : "false"))" />
                                        }
                                        else
                                        {
                                            <input class="finput"
                                                   type="@(string.Equals(field.InputKind, ConfigurationFieldKinds.Numeric, StringComparison.Ordinal) ? "number" : "text")"
                                                   placeholder="@field.Placeholder"
                                                   value="@_selectedTask.GetTransformValue(field.Key)"
                                                   @oninput="@(e => _selectedTask.SetTransformValue(field.Key, e.Value?.ToString() ?? string.Empty))" />
                                        }
                                    </div>
                                }
                            }
                        }
                    }

                    @* Transform-step parameter authoring is pending the canvas-native transform editor.
                       The legacy ITransformationType dropdown here was always empty (no endpoint projected
                       the transform-operation catalog) and referenced the removed transformation-service
                       subsystem; it is dropped with that subsystem. *@

                    @* Task-type-level fields (e.g., TrashTaskType.BufferSize / LogSinkName) *@
                    @if (taskType is not null && taskType.ConfigurationFields.Count > 0)
                    {
                        @foreach (var field in taskType.ConfigurationFields)
                        {
                            <div class="frow u-mb-0">
                                <label>@field.Label</label>
                                @if (string.Equals(field.InputKind, TransformFieldKinds.Textarea, StringComparison.Ordinal))
                                {
                                    <textarea class="finput mono u-fs-12" style="height:80px;"
                                              placeholder="@field.Placeholder"
                                              value="@_selectedTask.GetTransformValue(field.Key)"
                                              @oninput="@(e => _selectedTask.SetTransformValue(field.Key, e.Value?.ToString() ?? string.Empty))"></textarea>
                                }
                                else
                                {
                                    <input class="finput"
                                           placeholder="@field.Placeholder"
                                           value="@_selectedTask.GetTransformValue(field.Key)"
                                           @oninput="@(e => _selectedTask.SetTransformValue(field.Key, e.Value?.ToString() ?? string.Empty))" />
                                }
                            </div>
                        }
                    }

                    <div style="padding-top:16px;border-top:1px solid var(--hair);">
                        <button class="btn btn-ghost btn-sm" style="color:var(--signal);width:100%;justify-content:center;" @onclick="DeleteSelectedTask">
                            Delete Task
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="u-fs-13 u-italic" style="color:var(--n-500);text-align:center;margin-top:40px;">
                    Select a node to edit its properties.
                </div>
            }

            @if (_pipelineDescription != null)
            {
                <div class="frow" style="margin-top:24px;margin-bottom:0;">
                    <label>Pipeline Description</label>
                    <textarea class="finput u-fs-12" style="height:80px;" @bind="_pipelineDescription"></textarea>
                </div>
            }
            </div>
        </div>
    </div>
</div>

</ChildContent>
</PipelineBuilderProvider>

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public Guid? PipelineId { get; set; }

    // Why: sourceDataSet query param carries the pre-selected DataSet name from Catalog or
    // DataSetDetail "Start Builder" / "Use in Pipeline" journeys. SupplyParameterFromQuery
    // binds the URL ?sourceDataSet=... value to this property automatically.
    [SupplyParameterFromQuery(Name = "sourceDataSet")]
    public string? SourceDataSet { get; set; }

    // Why: Both routes load an existing pipeline — /builder/{PipelineId} and /{Id}/edit.
    // The edit route binds Id (not PipelineId), so without folding Id in here the provider
    // received Guid.Empty and never called LoadExisting, leaving the canvas blank (FINDINGS bug #2).
    private Guid EffectivePipelineId => PipelineId ?? Id ?? Guid.Empty;

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }
    // Why: the pipeline hub requires an authenticated principal (FDW-545). This supplies the circuit
    // user's access token to the SignalR connection so the hub negotiate is not rejected with 401.
    [Inject] private Fdw.Web.Http.Authentication.IAccessTokenProvider TokenProvider { get; set; } = default!;
    [Inject] private ILogger<PipelineBuilderPage>? LoggerParam { get; set; }

    private ILogger<PipelineBuilderPage> _logger = NullLogger<PipelineBuilderPage>.Instance;
    private bool _initialSourceApplied;

    private ConnectionApiClient? _connectionApi;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [CascadingParameter] private SessionStateContext? Session { get; set; }

    private PipelineBuilderProvider _builderProvider = null!;
    private bool _providerLoaded;
    private bool _sessionRestored;

    private double _zoom = 1.0;
    private double _panX = 100;
    private double _panY = 100;
    private string? _draggedTaskType;
    private Guid? _selectedTaskId;
    private TaskNode? _selectedTask => _tasks.FirstOrDefault(t => t.Id == _selectedTaskId);
    private Guid? _connectingFromId;
    private Guid? _pipelineId;
    private string _pipelineName = "";
    private string? _pipelineDescription = "";
    private string? _validationError;
    private bool _isSaving;
    private bool _isPublishing;

    private List<TaskNode> _tasks = new();
    private List<ConnectionModel> _connections = new();
    private List<ConnectionPayload> _availableConnections = new();
    private Stack<List<TaskNode>> _undoStack = new();
    private Stack<List<TaskNode>> _redoStack = new();

    // Why: dedupes the ConnectionCommandCapabilitiesUnavailable gap log — GetSupportedCommands runs
    // on every render of the Inspector panel while a task is selected; log the gap once per
    // connection type name rather than spamming the logger every StateHasChanged cycle.
    private readonly HashSet<string> _loggedCapabilityGapConnectionTypes = new(StringComparer.Ordinal);

    // ─── Test-mode state ───────────────────────────────────────────────────────

    // Why: All test-mode fields are grouped together so they are easy to reason
    // about in isolation from the main designer state.
    private Guid? _testExecutionId;
    private bool _testRunActive;
    private bool _testIsPaused;
    private string _testExecutionStatus = "";
    private HubConnection? _hubConnection;

    // Why: ConcurrentDictionary for thread-safe per-task counter updates arriving
    // on the SignalR thread vs. StateHasChanged on the Blazor sync context.
    private readonly System.Collections.Concurrent.ConcurrentDictionary<Guid, PipelineTaskStatusUpdate>
        _taskUpdates = new();

    // Why: Dictionary rather than ConcurrentDictionary — edge keys are strings that
    // combine two Guids; writes are always on the SignalR receive path (sequential
    // per connection), so a plain dict locked on StateHasChanged is sufficient.
    private readonly Dictionary<string, PipelineEdgeFlowUpdate>
        _edgeUpdates = new(StringComparer.Ordinal);

    // Log lines rolling tail — last 100 lines from the execution group.
    private readonly List<string> _testLogLines = new();
    private const int MaxLogLines = 100;

    // Inspector sub-panel state — populated when the user clicks a node/edge.
    private TaskInspectorState? _inspectorTaskState;
    private EdgeInspectorState? _inspectorEdgeState;
    private string? _inspectorItemLabel;

    // Why: Base URL for ETL API calls derived from NavigationManager so that the
    // component works regardless of deployment origin (localhost vs production host).
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private string SessionKey => $"pipelines:builder:{PipelineId ?? Id ?? Guid.Empty}";

    protected override void OnParametersSet()
    {
        if (_sessionRestored || Session is null || Session.IsLoading) return;
        if (!Session.State.TryGetValue(SessionKey, out var raw) || raw is not System.Text.Json.JsonElement json) return;
        _sessionRestored = true;

        if (json.TryGetProperty("zoom", out var z)) _zoom = z.GetDouble();
        if (json.TryGetProperty("panX", out var px)) _panX = px.GetDouble();
        if (json.TryGetProperty("panY", out var py)) _panY = py.GetDouble();
        if (json.TryGetProperty("selectedTaskId", out var sid) && sid.ValueKind != System.Text.Json.JsonValueKind.Null)
        {
            if (Guid.TryParse(sid.GetString(), out var taskId)) _selectedTaskId = taskId;
        }
    }

    private async Task SaveBuilderSessionState()
    {
        if (Session is null) return;
        var state = new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["zoom"] = _zoom,
            ["panX"] = _panX,
            ["panY"] = _panY,
            ["selectedTaskId"] = _selectedTaskId?.ToString()
        };
        await Session.OnSaveState(SessionKey, state);
    }

    protected override async Task OnInitializedAsync()
    {
        _logger = LoggerParam ?? NullLogger<PipelineBuilderPage>.Instance;
        _connectionApi = new ConnectionApiClient(HttpClientFactory.CreateClient("ConnectionClient"), LoggerFactory?.CreateLogger<ConnectionApiClient>()!);
        try
        {
            var result = await _connectionApi!.GetConnections();
            if (result.IsSuccess && result.Value != null)
                _availableConnections = result.Value.ToList();
        }
        catch
        {
            _availableConnections = new List<ConnectionPayload>();
        }

    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // Why: if the provider's async load already resolved before this first render, hydrate now;
        // otherwise HandleProviderLoaded (provider's OnInitialLoadComplete) hydrates once it resolves.
        if (firstRender && !_providerLoaded
            && (_builderProvider.CanvasModel is not null || _builderProvider.LastResult is { IsFailure: true }))
        {
            HydrateFromProvider();
        }
        return Task.CompletedTask;
    }

    // Why: provider callback — fires when the initial async load resolves (Pipeline OR ErrorMessage is
    // set), the point the page's firstRender raced past. Without it a failed Get(id) left a blank canvas.
    private void HandleProviderLoaded() => HydrateFromProvider();

    private void HydrateFromProvider()
    {
        if (_providerLoaded) return;
        _providerLoaded = true;

        // PipelineBuilderProvider has loaded task types and existing pipeline by now.
        // Why: hydrate the page's local pipelineId from the provider so test-run dispatch
        // and Publish button get the correct pipeline identifier after load.
        _pipelineId = _builderProvider.PipelineConfigurationId;

        if (_builderProvider.CanvasModel is { } canvasModel)
        {
            // Why: populate _pipelineName from the canvas model title so the name field
            // shows the loaded pipeline name correctly on first render.
            _pipelineName = canvasModel.Title;

            // Why: populate _tasks from canvas model nodes for the Inspector panel and
            // test-mode task lookup. Canvas model nodes are the authoritative source of
            // truth; this local list is a read-only view used by the inspector and SignalR
            // overlay — mutations via the inspector are local and do not affect the canvas model.
            _tasks = canvasModel.Nodes
                .OfType<PipelineCanvasNode>()
                .Select(n =>
                {
                    n.Metadata.TryGetValue(PipelineCanvasMetadataKeys.OperationType, out var opType);
                    n.Metadata.TryGetValue(PipelineCanvasMetadataKeys.DataSetName, out var dataSetName);
                    n.Metadata.TryGetValue(PipelineCanvasMetadataKeys.ConnectionName, out var connName);
                    n.Metadata.TryGetValue(PipelineCanvasMetadataKeys.DataSetRole, out var role);

                    // Why: canvas node IDs are strings (e.g. "source", "sink", "transform-{guid}");
                    // synthesize stable Guids for the test-mode task-update lookup keyed by Guid.
                    _ = Guid.TryParse(n.Id.Replace("transform-", string.Empty, StringComparison.Ordinal), out var nodeGuid);
                    if (nodeGuid == Guid.Empty)
                        nodeGuid = Guid.CreateVersion7();

                    var category = string.IsNullOrEmpty(role)
                        ? "Transform"
                        : string.Equals(role, PipelineCanvasMetadataKeys.RoleSource, StringComparison.Ordinal)
                            ? "Source"
                            : "Destination";

                    return new TaskNode
                    {
                        Id = nodeGuid,
                        CanvasNodeId = n.Id,
                        Name = n.Label,
                        TaskType = opType ?? n.NodeType.Name,
                        Category = category,
                        DataSetName = dataSetName ?? string.Empty,
                        ConnectionName = connName ?? string.Empty,
                        Configuration = new Dictionary<string, object?>(StringComparer.Ordinal),
                    };
                })
                .ToList();

            StateHasChanged();
        }
        else if (_builderProvider.LastResult is { IsFailure: true })
        {
            _validationError = _builderProvider.LastResult?.CurrentMessage;
            StateHasChanged();
        }
    }

    // Why: ConnectionPayload (Fdw.Services.Connections.Clients) carries only Name/ConnectionType/etc. — no
    // endpoint projects IConnectionType.SupportedCommands (the command-capability metadata: per-capability
    // ConfigurationFields / BuilderComponentType) to the client. That metadata lives only on the
    // server-side ConnectionTypes TypeCollection (Fdw.Services.Connections core), which Fdw.UI.Pages no
    // longer references (canvas decoupling). Until a connection-types/{name}/command-capabilities
    // endpoint ships, the capability picker has no data source; log the gap once per connection type
    // and return empty so the Command picker/config fields/write-capability badge simply don't render
    // rather than guessing at a hardcoded capability list.
    private IReadOnlyList<ICommandCapabilityType> GetSupportedCommands(string? connectionTypeName)
    {
        if (string.IsNullOrEmpty(connectionTypeName))
            return [];

        if (_loggedCapabilityGapConnectionTypes.Add(connectionTypeName))
            PipelineBuilderProviderLog.ConnectionCommandCapabilitiesUnavailable(_logger, connectionTypeName);

        return [];
    }

    private static string InferCategory(string taskType) => taskType switch
    {
        // Why: SqlQuery/HttpSource/FileSource are legacy task-type names that pre-date the
        // connection-driven field model. Map them to Source for backward compatibility with
        // pipelines saved before Wave 0a.
        "Source" or "SqlQuery" or "HttpSource" or "FileSource" => "Source",
        "Destination" or "SqlDestination" or "FileDestination" => "Destination",
        "Conditional" or "Union" or "Loop" or "ErrorHandler" => "Control",
        "Trash" => "Diagnostics",
        _ => "Transform"
    };

    private static string GetConfigValue(TaskNode task, string key)
    {
        if (task.Configuration.TryGetValue(key, out var val))
            return val?.ToString() ?? string.Empty;
        return string.Empty;
    }

    private static void SetConfigValue(TaskNode task, string key, string? value)
    {
        task.Configuration[key] = value;
    }

    // Why: Configuration round-trips through System.Text.Json so string values land in the dict
    // as JsonElement after a load. .ToString() on a JsonElement returns the raw JSON encoding
    // (string values show up wrapped in quotes) — use GetString() when the element is a JSON
    // string so the UI gets the unwrapped value.
    private static string ReadConfigString(IDictionary<string, object?> cfg, string key)
    {
        if (!cfg.TryGetValue(key, out var value) || value is null)
            return string.Empty;
        if (value is string s) return s;
        if (value is System.Text.Json.JsonElement je)
        {
            return je.ValueKind == System.Text.Json.JsonValueKind.String
                ? je.GetString() ?? string.Empty
                : je.ToString();
        }
        return value.ToString() ?? string.Empty;
    }

    // Why: Capability selection clears previously stored fields from the old capability
    // before writing the new CapabilityName, preventing stale keys from accumulating in
    // the Configuration dict across capability switches.
    private void SetSelectedCapability(TaskNode task, string capabilityName)
    {
        // Remove fields from the previously selected capability.
        var oldName = ReadConfigString(task.Configuration, "CapabilityName");
        if (!string.IsNullOrEmpty(oldName))
        {
            var connDto = _availableConnections.FirstOrDefault(
                c => string.Equals(c.Name, task.ConnectionName, StringComparison.OrdinalIgnoreCase));
            // Why: see GetSupportedCommands — SupportedCommands is not exposed over the connections API.
            var oldCap = GetSupportedCommands(connDto?.ConnectionType)
                .FirstOrDefault(c => string.Equals(c.Name, oldName, StringComparison.Ordinal));
            if (oldCap is not null)
            {
                foreach (var field in oldCap.ConfigurationFields)
                    task.Configuration.Remove(field.Key);
            }
        }

        if (string.IsNullOrEmpty(capabilityName))
            task.Configuration.Remove("CapabilityName");
        else
            task.Configuration["CapabilityName"] = capabilityName;
    }

    private void PushUndo()
    {
        _undoStack.Push(_tasks.Select(t => new TaskNode
        {
            Id = t.Id, Name = t.Name, TaskType = t.TaskType, StepType = t.StepType,
            Category = t.Category, X = t.X, Y = t.Y, ConnectionName = t.ConnectionName,
            TransformType = t.TransformType,
            TransformFields = new Dictionary<string, string>(t.TransformFields, StringComparer.Ordinal)
        }).ToList());
        _redoStack.Clear();
    }

    private void Undo()
    {
        if (_undoStack.Count == 0) return;
        _redoStack.Push(_tasks);
        _tasks = _undoStack.Pop();
    }

    private void Redo()
    {
        if (_redoStack.Count == 0) return;
        _undoStack.Push(_tasks);
        _tasks = _redoStack.Pop();
    }

    private async Task ZoomIn() { _zoom = Math.Min(2, _zoom + 0.1); await SaveBuilderSessionState(); }
    private async Task ZoomOut() { _zoom = Math.Max(0.5, _zoom - 0.1); await SaveBuilderSessionState(); }

    private void StartConnection(Guid sourceId)
    {
        _connectingFromId = sourceId;
    }

    private void SetConnectionTarget(Guid targetId)
    {
        if (_connectingFromId == null || _connectingFromId == targetId) return;
        _connections.Add(new ConnectionModel
        {
            Id = Guid.NewGuid(),
            SourceTaskId = _connectingFromId.Value,
