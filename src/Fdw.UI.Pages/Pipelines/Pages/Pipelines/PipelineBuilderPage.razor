    private void DeleteSelectedTask()
    {
        if (_selectedTaskId == null) return;
        PushUndo();
        _tasks.RemoveAll(t => t.Id == _selectedTaskId.Value);
        _connections.RemoveAll(c => c.SourceTaskId == _selectedTaskId.Value || c.TargetTaskId == _selectedTaskId.Value);
        _selectedTaskId = null;
    }

    private void OnDragOver(DragEventArgs e) { }

    // Why: separate canvas-drop handler for the CanvasHost container so that drag-and-drop
    // from the palette creates a canvas node via EditContext.AddNode when the builder is in
    // edit mode. The original OnDrop handler mutated the legacy _tasks list for the non-canvas
    // path; this handler drives the canvas model — both paths coexist during the
    // canvas-adoption migration.
    private async Task OnCanvasDrop(DragEventArgs e)
    {
        if (_draggedTaskType is null) return;
        if (_builderProvider.CanvasModel?.EditContext is not { } editContext)
        {
            _draggedTaskType = null;
            return;
        }

        // Why: PipelinePaletteNodeMap closes the mechanism gap where palette names ("Source"/"Map"/
        // "Filter"/etc. — UI-facing labels) were passed straight to CanvasNodeTypes.ByName, which has
        // no member by those names (only "DataSet"/"Transform"/etc.) — every drop failed loud before
        // this map existed. The map also returns the seed metadata (DataSetRole / OperationType +
        // ExecutionOrder) the node needs, computed from the current canvas's Transform node count.
        var draggedTaskType = _draggedTaskType;
        var transformCount = _builderProvider.CanvasModel.Nodes
            .Count(n => string.Equals(n.NodeType.Name, "Transform", StringComparison.Ordinal));
        var mapResult = PipelinePaletteNodeMap.Map(draggedTaskType, transformCount + 1, _logger);
        if (!mapResult.IsSuccess)
        {
            // Why: fail loud — an unregistered drag type is a configuration error, not a
            // user error. Show the validation error rather than silently dropping the node.
            _validationError = mapResult.CurrentMessage;
            _draggedTaskType = null;
            StateHasChanged();
            return;
        }

        var (nodeType, seedMetadata) = mapResult.Value;

        // Why: position the new node at the cursor, adjusted for the canvas element's
        // left offset (palette ≈ 224px + gap ≈ 12px = ~236px) and the page header offset
        // (~100px). Canvas-space coords divide by zoom and subtract the pan origin.
        var canvasOffsetLeft = _testRunActive ? 556.0 : 236.0;  // wider when execution panel is open
        var x = (e.ClientX - canvasOffsetLeft - _panX) / _zoom;
        var y = (e.ClientY - 100 - _panY) / _zoom;

        var taskInfo = _taskCategories.SelectMany(c => c.Tasks)
            .FirstOrDefault(t => string.Equals(t.Name, draggedTaskType, StringComparison.Ordinal));
        var label = taskInfo?.DisplayName ?? draggedTaskType;

        var addResult = await editContext.AddNode(nodeType, label, x, y);
        if (!addResult.IsSuccess)
        {
            _validationError = addResult.CurrentMessage;
            _draggedTaskType = null;
            StateHasChanged();
            return;
        }

        var newNodeId = addResult.Value!;
        _draggedTaskType = null;

        // Why: seed the node's DataSetRole/OperationType/ExecutionOrder metadata from the palette map
        // — AddNode always starts a node with empty metadata (it doesn't understand domain semantics).
        var seedResult = await editContext.UpdateNodeMetadata(newNodeId, seedMetadata);
        if (!seedResult.IsSuccess)
        {
            _validationError = seedResult.CurrentMessage;
            StateHasChanged();
            return;
        }

        // Why: synthesize a TaskNode entry so the inspector can select and edit the
        // newly dropped node in the same render cycle.
        var newGuid = Guid.CreateVersion7();
        var category = taskInfo?.Category ?? InferCategory(draggedTaskType);

        // Why: apply the journey-entry DataSet on the first Source node dropped when the
        // page was reached via ?sourceDataSet=... — same guard as the legacy OnDrop path.
        var initialDataSetName = string.Empty;
        if (!_initialSourceApplied
            && !string.IsNullOrEmpty(SourceDataSet)
            && string.Equals(category, "Source", StringComparison.Ordinal))
        {
            initialDataSetName = SourceDataSet;
            _initialSourceApplied = true;
            PipelineBuilderProviderLog.InitialSourceDataSetApplied(_logger, SourceDataSet);
        }

        var newTask = new TaskNode
        {
            Id = newGuid,
            CanvasNodeId = newNodeId,
            Name = label,
            TaskType = nodeType.Name,
            Category = category,
            DataSetName = initialDataSetName,
            Configuration = new Dictionary<string, object?>(StringComparer.Ordinal),
        };
        _tasks.Add(newTask);
        _selectedTaskId = newGuid;

        await SaveBuilderSessionState();
        StateHasChanged();
    }

    // Why: write-back method syncs inspector-editable metadata fields (DataSetName,
    // ConnectionName, OperationType, DataSetRole) from the local TaskNode to the canvas model.
    // Called after any inspector field change that maps to a canvas metadata key.
    // Does nothing when no EditContext is available (view-only or canvas not yet loaded).
    private async Task SyncTaskMetadataToCanvas(TaskNode task)
    {
        if (_builderProvider.CanvasModel?.EditContext is not { } editContext) return;
        if (string.IsNullOrEmpty(task.CanvasNodeId)) return;

        var update = new Dictionary<string, string>(StringComparer.Ordinal)
        {
            [PipelineCanvasMetadataKeys.DataSetName] = task.DataSetName,
            [PipelineCanvasMetadataKeys.ConnectionName] = task.ConnectionName,
            [PipelineCanvasMetadataKeys.OperationType] = task.TaskType,
        };

        // Why: DataSetRole was never written here — PipelineCreateRequestProjection's source/sink
        // node lookup keys exclusively off this metadata key, so without it Save can never find the
        // source/sink DataSet nodes for a task synced through the inspector. Only Source/Destination
        // category tasks carry a role (the DataSet picker/connection picker in Builder.razor is itself
        // gated on Category == "Source" || "Destination", so this method is only ever called for
        // those two categories today) — no other category maps to a DataSetRole value.
        if (string.Equals(task.Category, "Source", StringComparison.Ordinal))
            update[PipelineCanvasMetadataKeys.DataSetRole] = PipelineCanvasMetadataKeys.RoleSource;
        else if (string.Equals(task.Category, "Destination", StringComparison.Ordinal))
            update[PipelineCanvasMetadataKeys.DataSetRole] = PipelineCanvasMetadataKeys.RoleSink;

        var result = await editContext.UpdateNodeMetadata(task.CanvasNodeId, update);
        if (!result.IsSuccess)
        {
            // Why: log the failure at warning level but do not block the UI — the user's
            // in-memory inspector edit is still visible; the failure is a canvas-sync gap.
            _validationError = result.CurrentMessage;
            StateHasChanged();
        }
    }

    private async Task OnDataSetSelectionChanged(TaskNode task, string? name)
    {
        // Why: Persist DataSet binding on the task. When DataSet is bound, the runtime reads
        // SourceDataSet/TargetDataSet from the pipeline config and resolves the Connection
        // server-side — no need to auto-fill ConnectionName in the UI. When "None" is picked,
        // leave ConnectionName alone so the user can pick one manually for ad-hoc mode.
        task.DataSetName = name ?? string.Empty;
        await SyncTaskMetadataToCanvas(task);
        StateHasChanged();
    }

    private async Task OnCreateDataSetFromPicker(TaskNode task, CreateDataSetPayload request)
    {
        if (_builderProvider.Context?.OnCreateDataSet is null) return;
        await _builderProvider.Context.OnCreateDataSet.Invoke(request);
        // Auto-select the just-created DataSet on the task so the picker shows it selected.
        task.DataSetName = request.Name;
        StateHasChanged();
    }

    private async Task OnDrop(DragEventArgs e)
    {
        if (_draggedTaskType == null) return;

        var taskInfo = _taskCategories.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Name == _draggedTaskType);
        if (taskInfo == null) return;

        PushUndo();
        var newTask = new TaskNode
        {
            Id = Guid.NewGuid(),
            Name = taskInfo.DisplayName,
            TaskType = taskInfo.Name,
            Category = taskInfo.Category,
            X = (int)((e.ClientX - _panX - 300) / _zoom),
            Y = (int)((e.ClientY - _panY - 100) / _zoom)
        };

        // Why: auto-apply the journey-entry DataSet on the first Source task dropped when the
        // page was reached via ?sourceDataSet=... from Catalog or DataSetDetail. Applied only
        // once (_initialSourceApplied guard) so subsequent Source drops start blank.
        if (!_initialSourceApplied
            && !string.IsNullOrEmpty(SourceDataSet)
            && string.Equals(taskInfo.Category, "Source", StringComparison.Ordinal))
        {
            newTask.DataSetName = SourceDataSet;
            _initialSourceApplied = true;
            PipelineBuilderProviderLog.InitialSourceDataSetApplied(_logger, SourceDataSet);
        }

        _tasks.Add(newTask);

        // Why: auto-select the just-dropped node so the properties panel opens immediately
        // rather than requiring a second click.
        _selectedTaskId = newTask.Id;

        _draggedTaskType = null;
        await SaveBuilderSessionState();
        StateHasChanged();
    }

