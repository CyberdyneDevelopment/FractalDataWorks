@page "/promotions/{Id:guid}/review"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Review Promotion - Cyberdyne</PageTitle>

<PromotionReviewProvider PromotionId="@Id" OnActionCompleted="HandleActionCompleted">
    <ChildContent Context="ctx">
        <PageHeader Eyebrow="System" Title="Review Promotion" Subtitle="Move configuration between environments with review.">
            <Actions>
                <a href="/promotions" class="btn btn-ghost">
                    <Icon Name="ChevronLeft" />
                    Back
                </a>
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
        {
            <div class="danger u-mb-14">
                <div class="t"><p>@ctx.ErrorMessage</p></div>
            </div>
        }

        @if (ctx.IsLoading && ctx.Request is null)
        {
            <EmptyState><p class="mut u-fg-n500">Loading&hellip;</p></EmptyState>
        }
        else if (ctx.Request is null)
        {
            <EmptyState><p class="u-fg-n300">Promotion request not found</p></EmptyState>
        }
        else
        {
            <div class="card">
                <div class="card-h"><h3>@ctx.Request.Name</h3><Badge Variant="GetStatusVariant(ctx.Request.Status)">@ctx.Request.Status</Badge></div>
                <div class="card-b">
                    <dl class="kv">
                        <dt>Name</dt><dd>@ctx.Request.Name</dd>
                        <dt>Status</dt><dd>@ctx.Request.Status</dd>
                        <dt>Source</dt><dd class="mono">@ctx.Request.SourceEnvironment</dd>
                        <dt>Target</dt><dd class="mono">@ctx.Request.TargetEnvironment</dd>
                    </dl>

                    <div style="display:flex;align-items:center;justify-content:center;gap:16px;margin-top:22px;">
                        <div class="svc" style="text-align:center;min-width:160px;">
                            <span class="hl mono u-fs-9-5 u-ls-10 u-upper" style="color:var(--n-500);">Source</span>
                            <p class="mono u-fw-600" style="margin:6px 0 0;color:var(--glacier-soft);">@ctx.Request.SourceEnvironment</p>
                        </div>
                        <Icon Name="ArrowRight" Style="width:28px;height:28px;color:var(--n-600);" />
                        <div class="svc" style="text-align:center;min-width:160px;">
                            <span class="hl mono u-fs-9-5 u-ls-10 u-upper" style="color:var(--n-500);">Target</span>
                            <p class="mono u-fw-600" style="margin:6px 0 0;color:var(--amber-400);">@ctx.Request.TargetEnvironment</p>
                        </div>
                    </div>

                    @if (string.Equals(ctx.Request.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="actions" style="justify-content:flex-end;margin-top:22px;">
                            <button class="btn btn-danger"
                                    @onclick="async () => await ctx.OnReject()"
                                    disabled="@ctx.IsLoading">
                                Reject
                            </button>
                            <button class="btn btn-primary"
                                    @onclick="async () => await ctx.OnApprove()"
                                    disabled="@ctx.IsLoading">
                                Approve
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </ChildContent>
</PromotionReviewProvider>

@code {
    [Parameter] public Guid Id { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private void HandleActionCompleted()
    {
        Nav.NavigateTo("/promotions");
    }

    private static StatusVariantBase GetStatusVariant(string status) => status switch
    {
        "Approved" => StatusVariants.Success,
        "Rejected" => StatusVariants.Error,
        "Pending" => StatusVariants.Warning,
        _ => StatusVariants.Neutral
    };
}
