@page "/promotions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Promotions - Cyberdyne</PageTitle>

<PromotionProvider>
    <ChildContent Context="ctx">
        <PageHeader Eyebrow="System" Title="Promotions" Subtitle="Move configuration between environments with review.">
            <Actions>
                <button class="btn btn-secondary" @onclick="async () => await ctx.OnRefresh()" disabled="@ctx.IsLoading">
                    <Icon Name="Refresh" />
                    Refresh
                </button>
                <button class="btn btn-primary" @onclick="() => _showCreate = true" disabled="@ctx.IsLoading">
                    <Icon Name="Add" />
                    New promotion
                </button>
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
        {
            <div class="danger u-mb-14">
                <div class="t"><p>@ctx.ErrorMessage</p></div>
            </div>
        }

        @if (_showCreate)
        {
            <div class="card u-mb-14">
                <div class="card-h"><h3>Create Promotion Request</h3></div>
                <div class="card-b">
                    <div class="fgrid" style="grid-template-columns:repeat(3,1fr);">
                        <div class="frow">
                            <label>Name</label>
                            <input class="finput" @bind="_createName" placeholder="Promotion name" />
                        </div>
                        <div class="frow">
                            <label>Source Environment</label>
                            <input class="finput" @bind="_createSource" placeholder="e.g. Development" />
                        </div>
                        <div class="frow">
                            <label>Target Environment</label>
                            <input class="finput" @bind="_createTarget" placeholder="e.g. Production" />
                        </div>
                    </div>
                    <div class="actions u-jc-end">
                        <button class="btn btn-ghost btn-sm" @onclick="() => _showCreate = false">Cancel</button>
                        <button class="btn btn-primary btn-sm" @onclick="async () => await SubmitCreate(ctx)" disabled="@ctx.IsLoading">Create</button>
                    </div>
                </div>
            </div>
        }

        @if (ctx.IsLoading && !ctx.Requests.Any())
        {
            <EmptyState><p class="mut u-fg-n500">Loading promotions&hellip;</p></EmptyState>
        }
        else if (!ctx.Requests.Any())
        {
            <div class="card">
                <EmptyState InCard="false">
                    <p class="u-fg-n300">No promotion requests</p>
                    <p class="sub u-mt-6">Create a promotion request to move configurations between environments</p>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-h"><h3>Promotions</h3></div>
                <div class="card-b fdw-table-body">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Source</th>
                                <th>Target</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in ctx.Requests)
                            {
                                <tr>
                                    <td><div class="cellpad nm">@req.Name</div></td>
                                    <td class="mut">@req.SourceEnvironment</td>
                                    <td class="mut">@req.TargetEnvironment</td>
                                    <td class="mut">
                                        <Badge Variant="GetStatusVariant(req.Status)">@req.Status</Badge>
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <a href="/promotions/@req.Id/review" class="btn btn-ghost btn-sm">Review</a>
                                            @if (string.Equals(req.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button class="btn btn-ghost btn-sm" @onclick="async () => await ctx.OnApprove(req.Id)" disabled="@ctx.IsLoading">Approve</button>
                                                <button class="btn btn-ghost btn-sm" @onclick="async () => await ctx.OnReject(req.Id)" disabled="@ctx.IsLoading">Reject</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </ChildContent>
</PromotionProvider>

@code {

    private bool _showCreate;
    private string _createName = string.Empty;
    private string _createSource = string.Empty;
    private string _createTarget = string.Empty;

    private async Task SubmitCreate(PromotionContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_createName)) return;

        await ctx.OnCreate(new CreatePromotionPayload
        {
            Name = _createName,
            SourceEnvironment = _createSource,
            TargetEnvironment = _createTarget
        });

        _createName = string.Empty;
        _createSource = string.Empty;
        _createTarget = string.Empty;
        _showCreate = false;
    }

    private static StatusVariantBase GetStatusVariant(string status) => status switch
    {
        "Approved" => StatusVariants.Success,
        "Rejected" => StatusVariants.Error,
        "Pending" => StatusVariants.Warning,
        _ => StatusVariants.Neutral
    };
}
