@page "/lineage"
@page "/lineage/{EntityType?}/{EntityName?}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable

<PageTitle>Lineage - Cyberdyne</PageTitle>

<LineageProvider>
    <ChildContent Context="lineageCtx">
        @{
            // Why: capture the current LineageContext reference so OnAfterRenderAsync can call
            // ShowLineage without needing lineageCtx in scope (it is only available inside the
            // render-tree lambda; @code lifecycle methods cannot access it directly).
            _capturedLineageCtx = lineageCtx;
        }
        <DataflowProvider>
            <ChildContent Context="dataflowCtx">
                <div class="graph" style="height:100%;width:100%;display:flex;flex-direction:column;">
                    <!-- Header -->
                    <div class="glabel">System Lineage</div>

                    @if (!string.IsNullOrEmpty(lineageCtx.ErrorMessage) || !string.IsNullOrEmpty(dataflowCtx.ErrorMessage))
                    {
                        <div class="danger" style="margin:14px;">
                            <div class="t"><p>@(lineageCtx.ErrorMessage ?? dataflowCtx.ErrorMessage)</p></div>
                        </div>
                    }

                    <!-- Entity Selector Toolbar -->
                    <div class="filters" style="padding:13px 16px;border-bottom:1px solid var(--hair);margin-bottom:0;">
                        <select class="finput" style="width:160px;" @bind="_entityType" @bind:after="OnEntityTypeChanged">
                            <option value="">All</option>
                            <option value="Pipeline">Pipeline</option>
                            <option value="DataSet">DataSet</option>
                            <option value="DataStore">DataStore</option>
                            <option value="Connection">Connection</option>
                            <option value="Calculation">Calculation</option>
                        </select>
                        <select class="finput" style="width:200px;" @bind="_entityName" disabled="@string.IsNullOrEmpty(_entityType)">
                            <option value="">Select entity...</option>
                            @foreach (var name in _entityNames)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                        <button class="btn btn-primary btn-sm" @onclick="() => ShowLineage(lineageCtx)" disabled="@(string.IsNullOrEmpty(_entityName))">Show Lineage</button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => ShowFullGraph(dataflowCtx)">Show All</button>
                    </div>

                    @if (lineageCtx.IsLoading || dataflowCtx.IsLoading)
                    {
                        <div style="position:absolute;inset:0;top:48px;display:flex;align-items:center;justify-content:center;background:rgba(8,9,11,0.5);z-index:20;">
                            <span class="mono u-fg-n400">Loading lineage&hellip;</span>
                        </div>
                    }

                    <!-- Canvas -->
                    <div style="flex:1;position:relative;">
                        <svg class="w-full h-full" style="width:100%;height:100%;background:#08090b;"
                             @onmousedown="OnCanvasMouseDown"
                             @onmousemove="OnCanvasMouseMove"
                             @onmouseup="OnCanvasMouseUp"
                             @onmouseleave="OnCanvasMouseUp"
                             @onwheel="OnCanvasWheel"
                             @onwheel:preventDefault="true">
                            <defs>
                                <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                                    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.5" />
                                </pattern>
                                <marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
                                    <path d="M0,0 L0,6 L9,3 z" fill="#64748b" />
                                </marker>
                            </defs>

                            <g transform="translate(@_transform.X, @_transform.Y) scale(@_transform.Scale)">
                                <rect x="-5000" y="-5000" width="10000" height="10000" fill="url(#grid)" />

                                <!-- Edges -->
                                @foreach (var edge in _edges)
                                {
                                    var source = _nodes.FirstOrDefault(n => string.Equals(n.Id, edge.SourceId, StringComparison.Ordinal));
                                    var target = _nodes.FirstOrDefault(n => string.Equals(n.Id, edge.TargetId, StringComparison.Ordinal));
                                    if (source != null && target != null)
                                    {
                                        var color = edge.Type switch
                                        {
                                            "Produces" => "#06b6d4",
                                            "Consumes" => "#ef4444",
                                            "transform" => "#a855f7",
                                            _ => "#64748b"
                                        };
                                        var sx = source.X + 70;
                                        var sy = source.Y;
                                        var tx = target.X - 70;
                                        var ty = target.Y;
                                        var midX = (sx + tx) / 2;
                                        <path d="M @sx @sy C @midX @sy, @midX @ty, @tx @ty"
                                              stroke="@color" stroke-width="1.5" fill="none" marker-end="url(#arrow)" />
                                    }
                                }

                                <!-- Nodes -->
                                @foreach (var node in _nodes)
                                {
                                    <g transform="translate(@node.X, @node.Y)" class="cursor-move"
                                       @onclick="() => SelectNode(node)"
                                       @ondblclick="() => OnNodeDoubleClick(node, dataflowCtx)"
                                       @onmousedown="@(e => OnNodeMouseDown(node, e))"
                                       @onmousedown:stopPropagation="true">
                                        @switch (node.Type)
                                        {
                                            case "Connection":
                                                <rect x="-60" y="-20" width="120" height="40" rx="0" fill="#0f172a" stroke="#9ca3af" stroke-width="1.5" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#9ca3af\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                            case "DataStore":
                                                <rect x="-60" y="-20" width="120" height="40" rx="6" fill="#0f172a" stroke="#3b82f6" stroke-width="1.5" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#3b82f6\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                            case "Pipeline":
                                                <polygon points="0,-25 65,0 0,25 -65,0" fill="#0f172a" stroke="#ef4444" stroke-width="1.5" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#ef4444\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                            case "Calculation":
                                                <circle r="25" fill="#0f172a" stroke="#f97316" stroke-width="1.5" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#f97316\" font-size=\"9\" font-weight=\"bold\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                            case "DataSet":
                                                <polygon points="-55,-20 -45,-20 55,20 45,20" fill="none" stroke="none" />
                                                <path d="M -50,-20 L 50,-20 L 60,20 L -60,20 Z" fill="#0f172a" stroke="#06b6d4" stroke-width="1.5" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#06b6d4\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                            case "Container":
                                                <rect x="-40" y="-15" width="80" height="30" fill="#0f172a" stroke="#7dd3fc" stroke-width="1" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#7dd3fc\" font-size=\"9\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                            case "Transformation":
                                                <polygon points="0,-22 -40,-11 -40,11 0,22 40,11 40,-11" fill="#0f172a" stroke="#a855f7" stroke-width="1.5" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#a855f7\" font-size=\"9\" font-weight=\"bold\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                            default:
                                                <rect x="-50" y="-18" width="100" height="36" fill="#0f172a" stroke="#e2e8f0" stroke-width="1.5" />
                                                @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" fill=\"#e2e8f0\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\">{TruncateLabel(node.Name)}</text>")
                                                break;
                                        }
                                        @if (string.Equals(node.Id, _selectedNode?.Id, StringComparison.Ordinal))
                                        {
                                            <circle r="35" fill="none" stroke="#ef4444" stroke-width="2" stroke-dasharray="4 2" class="animate-pulse" />
                                        }
                                        @* Why: show a collapsed-children badge for expandable nodes that haven't been
                                           expanded yet. Double-clicking loads their direct neighbors lazily. *@
                                        @{
                                            var isExpandable = node.Type is "Project" or "Stage" or "Step" or "Pipeline";
                                            var isExpanded = _expandedNodes.Contains(node.Id);
                                        }
                                        @if (isExpandable && !isExpanded)
                                        {
                                            <g transform="translate(50, -18)">
                                                <rect x="-14" y="-8" width="28" height="16" rx="4" fill="#374151" stroke="#6b7280" stroke-width="0.5" />
                                                @((MarkupString)"<text x=\"0\" y=\"4\" text-anchor=\"middle\" fill=\"#9ca3af\" font-size=\"8\" font-family=\"monospace\">+more</text>")
                                            </g>
                                        }
                                    </g>
                                }
                            </g>
                        </svg>

                        @if (_nodes.Count == 0 && !lineageCtx.IsLoading && !dataflowCtx.IsLoading)
                        {
                            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
                                <div style="text-align:center;color:var(--n-500);">
                                    <p class="sub">Select an entity type and name to view lineage, or click "Show All"</p>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Selected Node Detail Panel -->
                    @if (_selectedNode != null)
                    {
                        <div class="card" style="position:absolute;top:64px;right:16px;width:320px;z-index:10;max-height:calc(100vh - 8rem);overflow-y:auto;">
                            <div class="card-h">
                                <h3>@_selectedNode.Name</h3>
                                <button class="btn btn-ghost btn-sm" @onclick="() => { _selectedNode = null; _fieldDrillIn = null; }">
                                    <Icon Name="Close" />
                                </button>
                            </div>
                            <div class="card-b">
                                <dl class="kv">
                                    <dt>Type</dt><dd>@_selectedNode.Type</dd>
                                    <dt>Status</dt><dd>@(_selectedNode.Status ?? "Active")</dd>
                                </dl>

                                @if (string.Equals(_selectedNode.Type, "DataSet", StringComparison.Ordinal))
                                {
                                    <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--hair);">
                                        @if (_fieldDrillIn is null)
                                        {
                                            <button class="btn btn-secondary btn-sm" style="width:100%;" @onclick="() => LoadFieldLineage(_selectedNode.Name, dataflowCtx)">
                                                @(_isLoadingFields ? "Loading fields..." : "Drill into fields")
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="filters" style="justify-content:space-between;margin-bottom:8px;">
                                                <span class="lbl">Fields (@_fieldDrillIn.Count)</span>
                                                <button class="btn btn-ghost btn-sm" @onclick="() => _fieldDrillIn = null">collapse</button>
                                            </div>
                                            <div style="display:flex;flex-direction:column;gap:8px;max-height:24rem;overflow-y:auto;">
                                                @foreach (var f in _fieldDrillIn)
                                                {
                                                    <div class="finput" style="padding:8px 10px;">
                                                        <div class="mono" style="font-size:12px;color:var(--glacier-soft);font-weight:600;">@f.FieldName</div>
                                                        @if (f.Sources.Count > 0)
                                                        {
                                                            <div class="mono" style="margin-top:4px;font-size:10px;color:var(--n-400);">← sources: @string.Join(", ", f.Sources)</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="mono" style="margin-top:4px;font-size:10px;color:var(--n-600);font-style:italic;">no source mappings recorded</div>
                                                        }
                                                        @if (f.Consumers.Count > 0)
                                                        {
                                                            <div class="mono" style="margin-top:4px;font-size:10px;color:var(--n-400);">→ used by: @string.Join(", ", f.Consumers)</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <button class="btn btn-secondary btn-sm" style="width:100%;margin-top:16px;" @onclick="() => NavigateToNode(_selectedNode)">Open Detail Page</button>
                            </div>
                        </div>
                    }

                    <!-- Controls -->
                    <div style="position:absolute;bottom:16px;right:16px;display:flex;flex-direction:column;gap:9px;">
                        <button class="btn btn-secondary btn-sm" @onclick="ZoomIn">
                            <Icon Name="ZoomIn" />
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="ZoomOut">
                            <Icon Name="ZoomOut" />
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="ResetView">
                            <Icon Name="Fullscreen" />
                        </button>
                    </div>

                    <!-- Legend -->
                    <div class="card" style="position:absolute;bottom:16px;left:16px;padding:0;">
                        <div class="card-b" style="padding:13px 16px;">
                            <div class="lbl" style="margin-bottom:9px;">Legend</div>
                            <div class="legend" style="flex-wrap:wrap;gap:14px;">
                                <span><i style="border-radius:0;background:var(--n-300);"></i>Connection</span>
                                <span><i style="background:var(--glacier);"></i>DataStore</span>
                                <span><i style="background:var(--signal);"></i>Pipeline</span>
                                <span><i style="background:var(--glacier-soft);"></i>DataSet</span>
                                <span><i style="border-radius:99px;background:var(--amber);"></i>Calculation</span>
                                <span><i style="background:var(--violet);"></i>Transformation</span>
                            </div>
                        </div>
                    </div>
                </div>
            </ChildContent>
        </DataflowProvider>
    </ChildContent>
</LineageProvider>

@code {
    [Parameter] public string? EntityType { get; set; }
    [Parameter] public string? EntityName { get; set; }

    [CascadingParameter] private MainLayoutBase? Layout { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private ConnectionApiClient? _connectionApi;
    private PipelineHttpClient? _pipelineApi;
    private DataSetApiClient? _dataSetApi;
    private DataStoreApiClient? _dataStoreApi;
    private CalculationApiClient? _calculationApi;
    private Fdw.Operations.Clients.LineageApiClient? _lineageApi;

    // Why: tracks which nodes have been expanded via lazy-load so their child edges are
    // merged into the graph. Separate from _selectedNode to allow multiple expansions.
    private readonly HashSet<string> _expandedNodes = new(StringComparer.Ordinal);

    // Why: session-scoped deduplication cache keyed by "{nodeType}_{nodeId}".
    // Prevents repeat API calls for nodes already expanded during this session.
    private readonly HashSet<string> _expandCache = new(StringComparer.Ordinal);

    private Transform _transform = new(80, 80, 0.85);
    private List<LineageNode> _nodes = new();
    private List<LineageEdge> _edges = new();
    private string _entityType = "";
    private string _entityName = "";
    private List<string> _entityNames = new();
    private LineageNode? _selectedNode;

    // Why: deep-link auto-load — when route params supply both EntityType and EntityName we skip
    // the manual "Show Lineage" click. _capturedLineageCtx is populated by the render-tree capture
    // block (the only place lineageCtx is in scope); _pendingAutoLoad is consumed once then cleared.
    private LineageContext? _capturedLineageCtx;
    private bool _pendingAutoLoad;

    protected override void OnInitialized()
    {
        Layout?.SetNoPadding(true);
        _connectionApi = new ConnectionApiClient(HttpClientFactory.CreateClient("ConnectionClient"), LoggerFactory?.CreateLogger<ConnectionApiClient>()!);
        _pipelineApi = new PipelineHttpClient(HttpClientFactory.CreateClient("PipelineClient"), LoggerFactory?.CreateLogger<PipelineHttpClient>()!);
        _dataSetApi = new DataSetApiClient(HttpClientFactory.CreateClient("DataSetClient"), LoggerFactory?.CreateLogger<DataSetApiClient>()!);
        _dataStoreApi = new DataStoreApiClient(HttpClientFactory.CreateClient("DataStoreClient"), LoggerFactory?.CreateLogger<DataStoreApiClient>()!);
        _calculationApi = new CalculationApiClient(HttpClientFactory.CreateClient("CalculationClient"), LoggerFactory?.CreateLogger<CalculationApiClient>()!);
        _lineageApi = new Fdw.Operations.Clients.LineageApiClient(HttpClientFactory.CreateClient("LineageClient"), LoggerFactory?.CreateLogger<Fdw.Operations.Clients.LineageApiClient>()!);
    }

    public void Dispose()
    {
        Layout?.SetNoPadding(false);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(EntityType))
        {
            _entityType = EntityType;
            await OnEntityTypeChanged();
            if (!string.IsNullOrEmpty(EntityName))
            {
                _entityName = EntityName;
                // Why: signal OnAfterRenderAsync to auto-load; we cannot call ShowLineage here
                // because lineageCtx is only available inside the render-tree lambda.
                _pendingAutoLoad = true;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pendingAutoLoad && _capturedLineageCtx is not null)
        {
            _pendingAutoLoad = false;
            await ShowLineage(_capturedLineageCtx);
        }
    }

    private async Task OnEntityTypeChanged()
    {
        _entityNames = new List<string>();
        _entityName = "";
        if (string.IsNullOrEmpty(_entityType)) return;

        try
        {
            switch (_entityType)
            {
                case "Connection":
                    var connResult = await _connectionApi!.GetConnections();
                    _entityNames = connResult.IsSuccess && connResult.Value != null
                        ? connResult.Value.Select(c => c.Name).ToList()
                        : new List<string>();
                    break;
                case "Pipeline":
                    var pipeResult = await _pipelineApi!.List();
                    _entityNames = pipeResult.IsSuccess && pipeResult.Value != null
                        ? pipeResult.Value.Select(p => p.Name).ToList()
                        : new List<string>();
                    break;
                case "DataSet":
                    var dsResult = await _dataSetApi!.GetDataSets();
                    _entityNames = dsResult.IsSuccess && dsResult.Value != null
                        ? dsResult.Value.Select(d => d.Name).ToList()
                        : new List<string>();
                    break;
                case "DataStore":
                    var storeResult = await _dataStoreApi!.GetDataStores();
                    _entityNames = storeResult.IsSuccess && storeResult.Value != null
                        ? storeResult.Value.Select(d => d.Name).ToList()
                        : new List<string>();
                    break;
                case "Calculation":
                    var calcResult = await _calculationApi!.GetCalculations();
                    _entityNames = calcResult.IsSuccess && calcResult.Value != null
                        ? calcResult.Value.Select(c => c.Name ?? string.Empty).Where(n => !string.IsNullOrEmpty(n)).ToList()
                        : new List<string>();
                    break;
            }
        }
        catch
        {
            _entityNames = new List<string>();
        }
    }

    private async Task ShowLineage(LineageContext ctx)
    {
        if (string.IsNullOrEmpty(_entityType) || string.IsNullOrEmpty(_entityName)) return;
        _selectedNode = null;
        // Why: endpoint builds node ids as "{EntityType}_{EntityName}" with the proper-cased
        // type (e.g. "DataSet_NflTeams") and FindNode matches Ordinal — lowercasing the type
        // 404s every lookup, so pass _entityType as-is (dropdown values are already capitalized).
        await ctx.OnLoadLineage(_entityType, _entityName);

        if (ctx.CurrentGraph != null)
        {
            BuildGraphFromLineage(ctx.CurrentGraph);
        }
    }

    private async Task ShowFullGraph(DataflowContext ctx)
    {
        _selectedNode = null;
        await ctx.OnLoadGraph();

        if (ctx.Graph != null)
        {
            BuildGraphFromDataflow(ctx.Graph);
            StateHasChanged();
        }
    }

    private void BuildGraphFromLineage(LineageGraphPayload graph)
    {
        _nodes = graph.Nodes.Select((n, i) => new LineageNode(
            n.Id,
            n.Type,
            n.Label,
            0, 0,
            "Active"
        )).ToList();

        _edges = graph.Edges.Select((e, i) => new LineageEdge(
            $"e{i}",
            e.SourceId,
            e.TargetId,
            e.Relation
        )).ToList();

        LayoutNodes();
    }

    private void BuildGraphFromDataflow(DataflowGraphPayload graph)
    {
        _nodes = graph.Nodes.Select((n, i) => new LineageNode(
            n.Id,
            n.NodeType,
            n.Label,
            0, 0,
            "Active"
        )).ToList();

        _edges = graph.Edges.Select((e, i) => new LineageEdge(
            e.Id,
            e.Source,
            e.Target,
            e.Label ?? "ReadsFrom"
        )).ToList();

        LayoutNodes();
    }

    private void LayoutNodes()
    {
        if (_nodes.Count == 0) return;

        var adjacency = new Dictionary<string, List<string>>();
        var inDegree = new Dictionary<string, int>();
        foreach (var n in _nodes)
        {
            adjacency[n.Id] = new List<string>();
            inDegree[n.Id] = 0;
        }
        foreach (var e in _edges)
        {
            if (adjacency.ContainsKey(e.SourceId))
                adjacency[e.SourceId].Add(e.TargetId);
            if (inDegree.ContainsKey(e.TargetId))
                inDegree[e.TargetId]++;
        }

        var roots = _nodes.Where(n => inDegree.GetValueOrDefault(n.Id) == 0).Select(n => n.Id).ToList();
        if (roots.Count == 0) roots = new List<string> { _nodes[0].Id };

        var visited = new HashSet<string>();
        var levels = new Dictionary<string, int>();
        var queue = new Queue<string>(roots);
        foreach (var r in roots) { levels[r] = 0; visited.Add(r); }

        while (queue.Count > 0)
        {
            var id = queue.Dequeue();
            foreach (var neighbor in adjacency.GetValueOrDefault(id) ?? new List<string>())
            {
                if (visited.Add(neighbor))
                {
                    levels[neighbor] = levels[id] + 1;
                    queue.Enqueue(neighbor);
                }
            }
        }

        foreach (var n in _nodes)
        {
            if (!levels.ContainsKey(n.Id))
                levels[n.Id] = 0;
        }

        var grouped = _nodes.GroupBy(n => levels[n.Id]).OrderBy(g => g.Key).ToList();
        foreach (var group in grouped)
        {
            var items = group.ToList();
            var x = 100 + group.Key * 250;
            for (int i = 0; i < items.Count; i++)
            {
                items[i] = items[i] with { X = x, Y = 80 + i * 80 };
                var idx = _nodes.FindIndex(n => string.Equals(n.Id, items[i].Id, StringComparison.Ordinal));
                if (idx >= 0) _nodes[idx] = items[i];
            }
        }
    }

    private void SelectNode(LineageNode node)
    {
        _selectedNode = string.Equals(_selectedNode?.Id, node.Id, StringComparison.Ordinal) ? null : node;
    }

    // ── Field-level drill-in (DataSet nodes only) ───────────────────────────────

    private List<FieldDrillIn>? _fieldDrillIn;
    private bool _isLoadingFields;

    // Why: Flatten FieldLineagePayload to a simple shape the side-panel markup consumes directly.
    // Sources come from FieldSourceMappingPayload (upstream), Consumers from FieldConsumerPayload
    // (downstream — "where is this field used").
    private sealed record FieldDrillIn(
        string FieldName,
        IReadOnlyList<string> Sources,
        IReadOnlyList<string> Consumers);

    // Why: Double-click on a DataSet opens the side panel (selects + loads fields).
    // Double-click on an orchestration node type (Project, Stage, Step) lazily expands
    // its direct neighbors via ExpandLineageNodeEndpoint and merges them into the graph.
    // For other types, fall back to the existing navigate-to-detail-page behavior.
    private async Task OnNodeDoubleClick(LineageNode node, DataflowContext dataflowCtx)
    {
        SelectNode(node);
        if (string.Equals(node.Type, "DataSet", StringComparison.Ordinal))
        {
            await LoadFieldLineage(node.Name, dataflowCtx);
            return;
        }

        // Why: Project/Stage/Step nodes support lazy expansion — their children are loaded
        // on demand to avoid rendering the full project tree in the initial lineage graph.
        var expandableTypes = new HashSet<string>(StringComparer.Ordinal) { "Project", "Stage", "Step", "Pipeline" };
        if (expandableTypes.Contains(node.Type))
        {
            await ExpandNode(node);
            return;
        }

        NavigateToNode(node);
    }

    // Why: Extract nodeId from "Type_Name" format used by the lineage graph.
    // The expand endpoint accepts nodeType + nodeId separately (not the combined key).
    private async Task ExpandNode(LineageNode node)
    {
        if (_lineageApi is null) return;

        // Why: derive the name portion by stripping the "{Type}_" prefix from the composite Id.
        var prefix = node.Type + "_";
        var nodeName = node.Id.StartsWith(prefix, StringComparison.Ordinal)
            ? node.Id[prefix.Length..]
            : node.Id;

        var cacheKey = $"{node.Type}_{nodeName}";

        // Why: session deduplication — if this node was already expanded, the children are
        // already in _nodes/_edges. Avoid the round-trip.
        if (_expandCache.Contains(cacheKey))
        {
            _expandedNodes.Add(node.Id);
            StateHasChanged();
            return;
        }

        try
        {
            var result = await _lineageApi.ExpandLineageNode(node.Type, nodeName);
            if (!result.IsSuccess || result.Value is null)
            {
                return;
            }

            _expandCache.Add(cacheKey);
            _expandedNodes.Add(node.Id);

            // Why: merge new nodes into the existing graph, avoiding duplicates by Id.
            var existingNodeIds = _nodes.Select(n => n.Id).ToHashSet(StringComparer.Ordinal);
            var newNodes = result.Value.Nodes
                .Where(n => !existingNodeIds.Contains(n.Id))
                .Select((n, i) => new LineageNode(n.Id, n.Type, n.Label, 0, 0, "Active"))
                .ToList();

            if (newNodes.Count > 0)
            {
                _nodes = _nodes.Concat(newNodes).ToList();
            }

            // Why: merge new edges, avoiding duplicate source+target pairs.
            var existingEdgeKeys = _edges
                .Select(e => $"{e.SourceId}:{e.TargetId}")
                .ToHashSet(StringComparer.Ordinal);

            var newEdges = result.Value.Edges
                .Where(e => !existingEdgeKeys.Contains($"{e.SourceId}:{e.TargetId}"))
                .Select((e, i) => new LineageEdge($"exp_{_edges.Count + i}", e.SourceId, e.TargetId, e.Relation))
                .ToList();

            if (newEdges.Count > 0)
            {
                _edges = _edges.Concat(newEdges).ToList();
            }

            if (newNodes.Count > 0)
            {
                LayoutNodes();
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            // Why: transient expand failures are non-fatal; the node stays unexpanded.
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LoadFieldLineage(string datasetName, DataflowContext dataflowCtx)
    {
        _isLoadingFields = true;
        _fieldDrillIn = null;
        try
        {
            await dataflowCtx.OnLoadLineage(datasetName);
            var lineage = dataflowCtx.CurrentLineage;
            if (lineage?.FieldLineage is null || lineage.FieldLineage.Count == 0)
            {
                _fieldDrillIn = new List<FieldDrillIn>();
                return;
            }

            _fieldDrillIn = lineage.FieldLineage
                .Select(f => new FieldDrillIn(
                    FieldName: f.LogicalField,
                    Sources: f.Sources
                        .Select(s => $"{s.SourceName}.{s.PhysicalField}")
                        .ToList(),
                    Consumers: f.Consumers
                        .Select(c => string.IsNullOrEmpty(c.ConsumerField)
                            ? $"{c.ConsumerKind}: {c.ConsumerName}"
                            : $"{c.ConsumerKind}: {c.ConsumerName}.{c.ConsumerField}")
                        .ToList()))
                .OrderBy(f => f.FieldName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        finally
        {
            _isLoadingFields = false;
        }
    }

    private void NavigateToNode(LineageNode node)
    {
        var url = node.Type switch
        {
            "Connection" => $"/connections/{node.Name}/edit",
            "DataStore" => $"/datastores/{node.Name}",
            "DataSet" => $"/datasets/{node.Name}",
            "Pipeline" => $"/pipelines",
            _ => null
        };
        if (url != null) Nav.NavigateTo(url);
    }

    private string TruncateLabel(string label) =>
        label.Length > 14 ? label[..12] + ".." : label;

    private void ZoomIn() => _transform = _transform with { Scale = Math.Min(2, _transform.Scale + 0.1) };
    private void ZoomOut() => _transform = _transform with { Scale = Math.Max(0.3, _transform.Scale - 0.1) };
    private void ResetView() => _transform = new(80, 80, 0.85);

    // ── Interaction: drag nodes, pan canvas, wheel zoom ────────────────────────

    private LineageNode? _draggingNode;
    private double _dragOffsetX, _dragOffsetY;
    private bool _isPanning;
    private double _panStartX, _panStartY;
    private double _panOriginX, _panOriginY;

    private void OnNodeMouseDown(LineageNode node, MouseEventArgs e)
    {
        // Why: Capture offset from node origin so drag feels pinned to the cursor.
        _draggingNode = node;
        _dragOffsetX = e.ClientX / _transform.Scale - node.X;
        _dragOffsetY = e.ClientY / _transform.Scale - node.Y;
    }

    private void OnCanvasMouseDown(MouseEventArgs e)
    {
        // Why: If the event reached the canvas (node mousedown has stopPropagation),
        // start a viewport pan rather than a node drag.
        if (_draggingNode is not null)
            return;
        _isPanning = true;
        _panStartX = e.ClientX;
        _panStartY = e.ClientY;
        _panOriginX = _transform.X;
        _panOriginY = _transform.Y;
    }

    private void OnCanvasMouseMove(MouseEventArgs e)
    {
        if (_draggingNode is not null)
        {
            var newX = (int)(e.ClientX / _transform.Scale - _dragOffsetX);
            var newY = (int)(e.ClientY / _transform.Scale - _dragOffsetY);
            var idx = _nodes.IndexOf(_draggingNode);
            if (idx >= 0)
            {
                _nodes[idx] = _draggingNode with { X = newX, Y = newY };
                _draggingNode = _nodes[idx];
            }
            return;
        }

        if (_isPanning)
        {
            _transform = _transform with
            {
                X = _panOriginX + (e.ClientX - _panStartX),
                Y = _panOriginY + (e.ClientY - _panStartY)
            };
        }
    }

    private void OnCanvasMouseUp(MouseEventArgs e)
    {
        _draggingNode = null;
        _isPanning = false;
    }

    private void OnCanvasWheel(WheelEventArgs e)
    {
        // Why: Wheel delta of ±120 per notch in most browsers; convert to a smooth 0.1 step.
        var delta = -Math.Sign(e.DeltaY) * 0.1;
        var newScale = Math.Clamp(_transform.Scale + delta, 0.3, 2.0);
        _transform = _transform with { Scale = newScale };
    }

    private record Transform(double X, double Y, double Scale);
    private record LineageNode(string Id, string Type, string Name, int X, int Y, string Status);
    private record LineageEdge(string Id, string SourceId, string TargetId, string Type);
}
