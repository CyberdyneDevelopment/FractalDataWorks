@page "/glossary"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Glossary - Cyberdyne</PageTitle>

<GlossaryProvider>
    <ChildContent Context="ctx">
        <div class="pagehead">
            <div>
                <div class="ey">Governance</div>
                <h1>Glossary</h1>
                <div class="sub">Shared vocabulary of business terms and their definitions.</div>
            </div>
            <div class="actions">
                <button class="btn btn-secondary" @onclick="async () => await ctx.OnRefresh()" disabled="@ctx.IsLoading">
                    <Icon Name="Refresh" />
                    Refresh
                </button>
                <button class="btn btn-primary" @onclick="() => _showCreate = true" disabled="@ctx.IsLoading">
                    <Icon Name="AddAlt" />
                    New Term
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
        {
            <div class="danger" style="margin-bottom:14px;">
                <div class="t">
                    <h4>Error</h4>
                    <p>@ctx.ErrorMessage</p>
                </div>
            </div>
        }

        <div class="filters">
            <span class="lbl">Search</span>
            <input class="finput mono" style="flex:1;min-width:260px;" @bind="_searchQuery" @bind:event="oninput"
                   placeholder="Search glossary terms..." />
            <button class="btn btn-secondary btn-sm" @onclick="async () => await ctx.OnSearch(_searchQuery ?? string.Empty)">
                <Icon Name="SearchAlt" />
                Search
            </button>
        </div>

        @if (_showCreate)
        {
            <div class="card" style="margin-bottom:14px;">
                <div class="card-h"><h3>Add Glossary Term</h3></div>
                <div class="card-b">
                    <div class="fgrid">
                        <div class="frow">
                            <label>Term</label>
                            <input class="finput" @bind="_createTerm" placeholder="Term name" />
                        </div>
                        <div class="frow">
                            <label>Definition</label>
                            <input class="finput" @bind="_createDefinition" placeholder="Term definition" />
                        </div>
                    </div>
                    <div class="actions" style="justify-content:flex-end;">
                        <button class="btn btn-ghost btn-sm" @onclick="() => _showCreate = false">Cancel</button>
                        <button class="btn btn-primary btn-sm" @onclick="async () => await SubmitCreate(ctx)" disabled="@ctx.IsLoading">Create</button>
                    </div>
                </div>
            </div>
        }

        @if (ctx.IsLoading && !ctx.Terms.Any())
        {
            <div class="card">
                <div class="card-b" style="padding:40px 20px;text-align:center;color:var(--n-500);">
                    <p style="margin:0;">Loading terms...</p>
                </div>
            </div>
        }
        else if (!ctx.Terms.Any())
        {
            <div class="card">
                <div class="card-b" style="padding:40px 20px;text-align:center;">
                    <Icon Name="BookOpen" Style="width:40px;height:40px;margin:0 auto 16px;color:var(--n-500);opacity:0.4;" />
                    <p style="color:var(--n-400);margin:0;">No glossary terms defined</p>
                    <p style="color:var(--n-600);font-size:12px;margin:4px 0 0;">Add terms to build a shared vocabulary for your data</p>
                </div>
            </div>
        }
        else
        {
            <div style="display:grid;gap:12px;">
                @foreach (var term in ctx.Terms)
                {
                    <div class="card">
                        <div class="card-b" style="padding:16px 20px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                            <div>
                                <h3 style="margin:0;font-size:15px;font-weight:500;color:var(--n-100);">@term.Term</h3>
                                <p style="margin:6px 0 0;color:var(--n-400);font-size:13px;">@term.Definition</p>
                            </div>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="async () => await ctx.OnDelete(term.Id)"
                                    disabled="@ctx.IsLoading">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</GlossaryProvider>

@code {
    private bool _showCreate;
    private string _createTerm = string.Empty;
    private string _createDefinition = string.Empty;
    private string? _searchQuery;

    private async Task SubmitCreate(GlossaryContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_createTerm)) return;

        await ctx.OnCreate(new CreateGlossaryTermRequest
        {
            Term = _createTerm,
            Definition = _createDefinition
        });

        _createTerm = string.Empty;
        _createDefinition = string.Empty;
        _showCreate = false;
    }
}
