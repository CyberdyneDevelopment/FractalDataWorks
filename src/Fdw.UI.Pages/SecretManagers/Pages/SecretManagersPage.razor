@page "/secret-managers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Secret Managers - Cyberdyne</PageTitle>

<SecretManagerProvider>
    <ChildContent Context="ctx">
        <div style="display:flex;flex-direction:column;gap:14px;">
            <div class="pagehead">
                <div>
                    <div class="ey">Admin</div>
                    <h1>Secret Managers</h1>
                    <div class="sub">Values resolved at runtime from FDW_SECRET_* — never stored in profiles.</div>
                </div>
                <div class="actions">
                    <button class="btn btn-primary" @onclick="() => _showCreate = true">
                        <Icon Name="Add" />
                        Add manager
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
            {
                <div class="danger"><div class="t"><p>@ctx.ErrorMessage</p></div></div>
            }

            @if (_showCreate)
            {
                <div class="card">
                    <div class="card-h"><h3>New Secret Manager</h3></div>
                    <div class="card-b">
                        <div class="fgrid">
                            <div class="frow">
                                <label>Name</label>
                                <input class="finput mono" @bind="_createForm.Name" placeholder="e.g. PROD_VAULT" />
                            </div>
                            <div class="frow">
                                <label>Type</label>
                                <select class="finput" @bind="_createForm.SecretManagerType">
                                    <option value="">-- Select Type --</option>
                                    @foreach (var t in ctx.AvailableTypes)
                                    {
                                        <option value="@t.Name">@t.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="frow full">
                                <label>Description</label>
                                <textarea class="finput" style="height:80px;" @bind="_createForm.Description" placeholder="Optional description"></textarea>
                            </div>
                        </div>
                        <div class="actions u-jc-end">
                            <button class="btn btn-secondary" @onclick="CancelCreate">Cancel</button>
                            <button class="btn btn-primary" @onclick="() => HandleCreate(ctx)" disabled="@ctx.IsLoading">
                                @(ctx.IsLoading ? "Creating..." : "Create")
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (ctx.IsLoading && !ctx.SecretManagers.Any())
            {
                <div class="card"><div class="card-b" style="display:flex;justify-content:center;padding:48px;"><span class="badge b-run"><span class="bd"></span>Loading</span></div></div>
            }
            else if (!ctx.SecretManagers.Any())
            {
                <div class="card"><div class="card-b" style="text-align:center;padding:48px;">
                    <p class="sub">No secret managers configured</p>
                </div></div>
            }
            else
            {
                <div class="card">
                    <div class="card-h"><h3>Managers</h3></div>
                    <div class="card-b" style="padding:0 10px 12px;overflow-x:auto;">
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Provider</th>
                                    <th>Description</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sm in ctx.SecretManagers)
                                {
                                    <tr @onclick="() => ctx.OnSelect(sm.Name)" class="u-pointer">
                                        <td><div class="cellpad nm">@sm.Name</div></td>
                                        <td class="mut"><span class="tpill">@(sm.SecretManagerType ?? "Unknown")</span></td>
                                        <td class="mut">@(sm.Description ?? "No description")</td>
                                        <td class="mut">
                                            <div class="actions u-jc-end">
                                                <button class="btn btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="() => StartEdit(sm)">Edit</button>
                                                <button class="btn btn-ghost btn-sm u-fg-signal" @onclick:stopPropagation="true" @onclick="() => HandleDelete(ctx, sm.Name)">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* Detail panel when a secret manager is selected *@
            @if (ctx.SelectedManager is not null)
            {
                <div class="card">
                    <div class="card-h">
                        <h3>@ctx.SelectedManager.Name</h3>
                        <button class="btn btn-ghost btn-sm" @onclick="() => ctx.OnSelect(string.Empty)">Close</button>
                    </div>
                    <div class="card-b">
                        <dl class="kv">
                            <dt>Name</dt><dd class="mono">@ctx.SelectedManager.Name</dd>
                            <dt>Type</dt><dd class="mono">@(ctx.SelectedManager.SecretManagerType ?? "—")</dd>
                            <dt>Description</dt><dd>@(ctx.SelectedManager.Description ?? "—")</dd>
                            <dt>Service Option</dt><dd class="mono">@(ctx.SelectedManager.ServiceOptionType ?? "—")</dd>
                        </dl>
                    </div>
                </div>
            }

            @* Edit dialog *@
            @if (_editingName is not null)
            {
                <div class="card">
                    <div class="card-h"><h3>Edit: @_editingName</h3></div>
                    <div class="card-b">
                        <div class="frow">
                            <label>Description</label>
                            <textarea class="finput" style="height:80px;" @bind="_editDescription"></textarea>
                        </div>
                        <div class="actions u-jc-end">
                            <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                            <button class="btn btn-primary" @onclick="() => HandleUpdate(ctx)" disabled="@ctx.IsLoading">
                                @(ctx.IsLoading ? "Saving..." : "Save")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</SecretManagerProvider>

@code {
    private bool _showCreate;
    private CreateSecretManagerPayload _createForm = new();
    private string? _editingName;
    private string? _editDescription;

    private async Task HandleCreate(SecretManagerContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_createForm.Name) || string.IsNullOrWhiteSpace(_createForm.SecretManagerType))
            return;

        // Why: the server endpoint validator requires a non-null Configuration body to persist the
        // typed-body child record. The create form does not collect type-specific fields, so an
        // empty object is sent. The server deserializes it into the typed config with default values.
        _createForm.Configuration = new { };
        await ctx.OnCreate(_createForm);
        _createForm = new CreateSecretManagerPayload();
        _showCreate = false;
    }

    private void CancelCreate()
    {
        _showCreate = false;
        _createForm = new CreateSecretManagerPayload();
    }

    private void StartEdit(SecretManagerSummaryPayload sm)
    {
        _editingName = sm.Name;
        _editDescription = sm.Description;
    }

    private void CancelEdit()
    {
        _editingName = null;
        _editDescription = null;
    }

    private async Task HandleUpdate(SecretManagerContext ctx)
    {
        if (_editingName is null) return;

        await ctx.OnUpdate(_editingName, new UpdateSecretManagerPayload { Description = _editDescription });
        _editingName = null;
        _editDescription = null;
    }

    private async Task HandleDelete(SecretManagerContext ctx, string name)
    {
        await ctx.OnDelete(name);
    }
}
