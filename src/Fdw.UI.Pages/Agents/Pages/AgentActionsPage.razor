@page "/agent-actions"
@namespace Fdw.Agents.UI.Pages.Pages
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Agent Actions</PageTitle>

<AgentActionProvider AutoLoadList="true">
    <ChildContent Context="ctx">
        <div>
            <div class="pagehead">
                <div>
                    <div class="ey">AI Agent Queue</div>
                    <h1>Pending Actions</h1>
                </div>
                <div class="actions">
                    <button class="btn btn-secondary btn-sm" @onclick="async () => await ctx.OnLoadActions()" disabled="@ctx.IsLoading">
                        @(ctx.IsLoading ? "Loading..." : "Refresh")
                    </button>
                </div>
            </div>

            @if (ctx.IsLoading && ctx.Actions.Count == 0)
            {
                <div class="card"><div class="card-b" style="padding:24px;color:var(--n-500);">Loading…</div></div>
            }
            else if (ctx.Actions.Count == 0)
            {
                <div class="card"><div class="card-b mono" style="padding:48px;text-align:center;color:var(--n-500);">NO_PENDING_ACTIONS</div></div>
            }
            else
            {
                <div class="card">
                    <div class="card-b">
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Agent</th>
                                    <th>Method</th>
                                    <th>Route</th>
                                    <th>Status</th>
                                    <th>Requested</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var action in ctx.Actions)
                                {
                                    <tr>
                                        <td class="cellpad mut">@action.AgentActionId</td>
                                        <td class="cellpad">
                                            <div class="nm">@action.AgentLabel</div>
                                            <div class="mut">@action.UserId</div>
                                        </td>
                                        <td class="cellpad">
                                            <span class="@MethodBadgeClass(action.Method)"><span class="bd"></span>@action.Method</span>
                                        </td>
                                        <td class="cellpad mut">@action.Route</td>
                                        <td class="cellpad">
                                            <span class="@StatusBadgeClass(action.Status)"><span class="bd"></span>@action.Status</span>
                                        </td>
                                        <td class="cellpad mut">@action.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="cellpad">
                                            @if (string.Equals(action.Status, "Pending", StringComparison.Ordinal))
                                            {
                                                <button class="btn btn-primary btn-sm"
                                                        @onclick="@(() => Nav.NavigateTo("/review/" + action.AgentActionId))">
                                                    Review
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</AgentActionProvider>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private static string MethodBadgeClass(string method) => method.ToUpperInvariant() switch
    {
        "POST"   => "badge b-ok",
        "PUT"    => "badge b-run",
        "PATCH"  => "badge b-warn",
        "DELETE" => "badge b-fail",
        _        => "badge b-idle"
    };

    private static string StatusBadgeClass(string status) => status switch
    {
        "Pending"  => "badge b-warn",
        "Approved" => "badge b-ok",
        "Denied"   => "badge b-fail",
        _          => "badge b-idle"
    };
}
