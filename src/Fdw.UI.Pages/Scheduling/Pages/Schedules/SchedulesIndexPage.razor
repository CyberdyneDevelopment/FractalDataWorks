@page "/schedules"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Schedules - Cyberdyne</PageTitle>

<ScheduleProvider>
    <ChildContent Context="ctx">
        <PageHeader Eyebrow="Pipelines & Scheduling" Title="Schedules" Subtitle="Cron / Interval / Once / Manual. A background service dispatches due jobs through resiliency pipelines.">
            <Actions>
                <a href="/schedules/new" class="btn btn-primary">
                    <Icon Name="Add" />
                    New Schedule
                </a>
            </Actions>
        </PageHeader>

        @if (ctx.IsLoading && ctx.Schedules.Count == 0)
        {
            <div class="card">
                <EmptyState InCard="false">
                    <p class="mut u-fg-n500">Loading schedules&hellip;</p>
                </EmptyState>
            </div>
        }
        else if (ctx.Schedules.Count == 0)
        {
            <div class="card">
                <EmptyState InCard="false">
                    <p class="u-fg-n500">No schedules configured</p>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-h"><h3>Active Schedules</h3></div>
                <div class="card-b fdw-table-body">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Pipeline</th>
                                <th>Cadence</th>
                                <th>Next Run</th>
                                <th>Enabled</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in ctx.FilteredSchedules)
                            {
                                <tr>
                                    <td><div class="cellpad nm">@schedule.Name</div></td>
                                    <td class="mut">@schedule.PipelineName</td>
                                    <td class="num">
                                        @if (!string.IsNullOrEmpty(schedule.CronExpression))
                                        {
                                            @schedule.CronExpression
                                        }
                                        else if (schedule.IntervalSeconds.HasValue)
                                        {
                                            <span>Every @(schedule.IntervalSeconds.Value < 60 ? $"{schedule.IntervalSeconds.Value}s" : schedule.IntervalSeconds.Value < 3600 ? $"{schedule.IntervalSeconds.Value / 60}m" : $"{schedule.IntervalSeconds.Value / 3600}h")</span>
                                        }
                                        else
                                        {
                                            <span class="u-fg-n500">Manual</span>
                                        }
                                    </td>
                                    <td class="mut">@FormatDateTime(schedule.NextRunTime)</td>
                                    <td class="mut">
                                        <span class="sw @(schedule.IsEnabled ? "on" : "")"
                                              role="button"
                                              title="@(schedule.IsEnabled ? "Pause" : "Resume")"
                                              @onclick="() => ctx.OnToggleSchedule(schedule.Name, !schedule.IsEnabled)"></span>
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <button class="btn btn-ghost btn-sm" title="Edit"
                                                    @onclick="() => StartEdit(schedule)">
                                                <Icon Name="Edit" />
                                            </button>
                                            <button class="btn btn-ghost btn-sm" title="Delete"
                                                    @onclick="() => ctx.OnDeleteSchedule(schedule.Name)">
                                                <Icon Name="Delete" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_editingSchedule is not null)
        {
            <div class="card u-mt-14">
                <div class="card-h"><h3>Edit Schedule: @_editingSchedule.Name</h3></div>
                <div class="card-b">
                    <div class="fgrid">
                        <div class="frow">
                            <label>Pipeline</label>
                            <select class="finput" @bind="_editPipeline">
                                @foreach (var p in _availablePipelines)
                                {
                                    <option value="@p.Name">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="frow">
                            <label>Cron Expression</label>
                            <input class="finput mono" @bind="_editCron" placeholder="0 */5 * * *" />
                        </div>
                    </div>
                    <div class="actions">
                        <button class="btn btn-primary btn-sm" @onclick="() => SaveEdit(ctx)">Save</button>
                        <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</ScheduleProvider>

@code {
    [Inject] private IPipelineClient PipelineClient { get; set; } = default!;

    private IReadOnlyList<PipelineSummaryResponse> _availablePipelines = [];
    private ScheduleInfoDto? _editingSchedule;
    private string _editPipeline = "";
    private string _editCron = "";

    protected override async Task OnInitializedAsync()
    {
        var pipelineResult = await PipelineClient.List();
        _availablePipelines = pipelineResult.IsSuccess && pipelineResult.Value is not null
            ? pipelineResult.Value.ToList()
            : [];
    }

    private void StartEdit(ScheduleInfoDto schedule)
    {
        _editingSchedule = schedule;
        _editPipeline = schedule.PipelineName;
        _editCron = schedule.CronExpression ?? "";
    }

    private void CancelEdit()
    {
        _editingSchedule = null;
    }

    private async Task SaveEdit(ScheduleContext ctx)
    {
        if (_editingSchedule is null) return;
        await ctx.OnUpdateSchedule(_editingSchedule.Name, new UpdateScheduleClientRequest
        {
            PipelineName = _editPipeline,
            CronExpression = _editCron,
            IsEnabled = _editingSchedule.IsEnabled,
        });
        _editingSchedule = null;
        await ctx.OnLoadData();
    }

    private static string FormatDateTime(DateTimeOffset? dateTime)
    {
        if (!dateTime.HasValue) return "Never";
        return dateTime.Value.ToString("MMM dd HH:mm");
    }

    private static string GetStatusBadge(bool isActive) => isActive
        ? "badge-success"
        : "badge-idle";
}
