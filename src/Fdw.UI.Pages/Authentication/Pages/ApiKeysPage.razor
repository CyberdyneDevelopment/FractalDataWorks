@page "/api-keys"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>API Keys - Cyberdyne</PageTitle>

<ApiKeyProvider>
    <ChildContent Context="ctx">
        <div style="display:flex;flex-direction:column;gap:14px;">
            <PageHeader Eyebrow="Admin" Title="API Keys" Subtitle="Programmatic access · scoped · audited.">
                <Actions>
                    <button class="btn btn-ghost btn-sm" @onclick="() => ctx.OnRefresh.Invoke()" disabled="@ctx.IsLoading">
                        Refresh
                    </button>
                </Actions>
            </PageHeader>

            @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
            {
                <div class="danger"><div class="t"><p>@ctx.ErrorMessage</p></div></div>
            }

            @if (!string.IsNullOrEmpty(ctx.NewTokenValue))
            {
                <div class="card" style="box-shadow:inset 0 0 0 1px var(--amber-dim);">
                    <div class="card-h">
                        <h3 style="color:var(--amber);">Copy this token now</h3>
                        <span class="badge b-warn"><span class="bd"></span>One-time</span>
                    </div>
                    <div class="card-b">
                        <p class="hint" style="margin-top:0;">This value will not be shown again.</p>
                        <div style="display:flex;align-items:center;gap:9px;">
                            <code class="finput mono" style="flex:1;word-break:break-all;user-select:all;">@ctx.NewTokenValue</code>
                            <button class="btn btn-secondary btn-sm" @onclick="() => CopyToClipboard(ctx.NewTokenValue)" title="Copy to clipboard">
                                <Icon Name="Copy" StrokeWidth="1.8" />
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (ctx.IsLoading && !ctx.PersonalTokens.Any() && !ctx.AgentKeys.Any())
            {
                <LoadingCard />
            }
            else
            {
                @* Personal Access Tokens *@
                <div class="card">
                    <div class="card-h">
                        <h3>Personal Access Tokens</h3>
                        <button class="btn btn-primary btn-sm" @onclick="() => _showCreateToken = true">
                            <Icon Name="Add" />
                            New Token
                        </button>
                    </div>
                    <div class="card-b">
                        @if (_showCreateToken)
                        {
                            <div class="card" style="background:var(--s2);margin-bottom:14px;">
                                <div class="card-b" style="padding:16px 18px;">
                                    <div class="fgrid">
                                        <div class="frow">
                                            <label>Label</label>
                                            <input class="finput" placeholder="e.g., CI/CD Pipeline" @bind="_tokenLabel" />
                                        </div>
                                        <div class="frow">
                                            <label>Expires (optional)</label>
                                            <input type="date" class="finput" @bind="_tokenExpiry" />
                                        </div>
                                    </div>
                                    <div class="actions">
                                        <button class="btn btn-primary btn-sm" @onclick="() => SubmitCreateToken(ctx)" disabled="@ctx.IsLoading">Create</button>
                                        <button class="btn btn-ghost btn-sm" @onclick="CancelCreateToken">Cancel</button>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (ctx.PersonalTokens.Any())
                        {
                            <table class="tbl">
                                <thead>
                                    <tr><th>Label</th><th>Prefix</th><th>Created</th><th>Expires</th><th>Last used</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var token in ctx.PersonalTokens)
                                    {
                                        <tr>
                                            <td><div class="cellpad nm">@token.Label</div></td>
                                            <td class="num">@token.Prefix***</td>
                                            <td class="mut">@token.CreatedAt.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                                            <td class="mut">@(token.ExpiresAt.HasValue ? token.ExpiresAt.Value.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture) : "—")</td>
                                            <td class="mut">@(token.LastUsedAt.HasValue ? token.LastUsedAt.Value.ToString("MMM dd, yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) : "—")</td>
                                            <td class="mut u-ta-right">
                                                <button class="btn btn-ghost btn-sm u-fg-signal" @onclick="() => ctx.OnRevokeToken(token.TokenId)" disabled="@ctx.IsLoading">Revoke</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else if (!_showCreateToken)
                        {
                            <p class="sub" style="text-align:center;padding:16px 0;">No personal access tokens.</p>
                        }
                    </div>
                </div>

                @* Agent Keys *@
                <div class="card">
                    <div class="card-h">
                        <h3>Agent Keys</h3>
                        <button class="btn btn-primary btn-sm" @onclick="() => _showCreateAgentKey = true">
                            <Icon Name="Add" />
                            New Agent Key
                        </button>
                    </div>
                    <div class="card-b">
                        @if (_showCreateAgentKey)
                        {
                            <div class="card" style="background:var(--s2);margin-bottom:14px;">
                                <div class="card-b" style="padding:16px 18px;">
                                    <div class="fgrid">
                                        <div class="frow">
                                            <label>Label</label>
                                            <input class="finput" placeholder="e.g., Claude Agent" @bind="_agentKeyLabel" />
                                        </div>
                                        <div class="frow">
                                            <label>Expires (optional)</label>
                                            <input type="date" class="finput" @bind="_agentKeyExpiry" />
                                        </div>
                                    </div>
                                    <div class="actions">
                                        <button class="btn btn-primary btn-sm" @onclick="() => SubmitCreateAgentKey(ctx)" disabled="@ctx.IsLoading">Create</button>
                                        <button class="btn btn-ghost btn-sm" @onclick="CancelCreateAgentKey">Cancel</button>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (ctx.AgentKeys.Any())
                        {
                            <table class="tbl">
                                <thead>
                                    <tr><th>Label</th><th>Prefix</th><th>Created</th><th>Expires</th><th>Last used</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var key in ctx.AgentKeys)
                                    {
                                        <tr>
                                            <td><div class="cellpad nm">@key.Label</div></td>
                                            <td class="num">@key.Prefix***</td>
                                            <td class="mut">@key.CreatedAt.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                                            <td class="mut">@(key.ExpiresAt.HasValue ? key.ExpiresAt.Value.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture) : "—")</td>
                                            <td class="mut">@(key.LastUsedAt.HasValue ? key.LastUsedAt.Value.ToString("MMM dd, yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) : "—")</td>
                                            <td class="mut u-ta-right">
                                                <button class="btn btn-ghost btn-sm u-fg-signal" @onclick="() => ctx.OnDeleteAgentKey(key.KeyId)" disabled="@ctx.IsLoading">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else if (!_showCreateAgentKey)
                        {
                            <p class="sub" style="text-align:center;padding:16px 0;">No agent keys.</p>
                        }
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</ApiKeyProvider>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool _showCreateToken;
    private string _tokenLabel = "";
    private DateTime? _tokenExpiry;

    private bool _showCreateAgentKey;
    private string _agentKeyLabel = "";
    private DateTime? _agentKeyExpiry;

    private async Task SubmitCreateToken(ApiKeyContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_tokenLabel))
        {
            return;
        }

        var request = new CreateTokenRequest
        {
            Label = _tokenLabel.Trim(),
            ExpiresAt = _tokenExpiry
        };
        await ctx.OnCreateToken(request);
        CancelCreateToken();
    }

    private void CancelCreateToken()
    {
        _showCreateToken = false;
        _tokenLabel = "";
        _tokenExpiry = null;
    }

    private async Task SubmitCreateAgentKey(ApiKeyContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_agentKeyLabel))
        {
            return;
        }

        var request = new CreateAgentKeyRequest
        {
            Label = _agentKeyLabel.Trim(),
            ExpiresAt = _agentKeyExpiry
        };
        await ctx.OnCreateAgentKey(request);
        CancelCreateAgentKey();
    }

    private void CancelCreateAgentKey()
    {
        _showCreateAgentKey = false;
        _agentKeyLabel = "";
        _agentKeyExpiry = null;
    }

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}
