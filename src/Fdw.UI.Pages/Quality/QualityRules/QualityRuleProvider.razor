@namespace Fdw.Services.Quality.Components.QualityRules
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Services.Quality.Clients
@using Fdw.Services.Quality.Clients.Models
@using Fdw.Services.Quality.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    // ── Parameters ──────────────────────────────────────────────────────────────

    [Parameter] public RenderFragment<QualityRuleContext>? ChildContent { get; set; }

    // ── Injected Services ───────────────────────────────────────────────────────

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private QualityApiClient? _qualityApi;
    [Inject] private ILogger<QualityRuleProvider>? LoggerParam { get; set; }

    private ILogger<QualityRuleProvider> _logger = NullLogger<QualityRuleProvider>.Instance;

    // ── State ───────────────────────────────────────────────────────────────────

    private IReadOnlyList<QualityRuleSummaryPayload> _rules = [];
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private QualityRuleContext _context = new();
    private bool _initialized;

    // ── Lifecycle ───────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _qualityApi = new QualityApiClient(HttpClientFactory.CreateClient("QualityClient"), LoggerFactory?.CreateLogger<QualityApiClient>()!);
        _logger = LoggerParam ?? NullLogger<QualityRuleProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadRules();
        }
    }

    // ── Private Operations ─────────────────────────────────────────────────────

    private async Task<IGenericResult> LoadRules(CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        QualityRuleProviderLog.LoadStarted(_logger);

        try
        {
            var result = await _qualityApi!.GetRules(ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(QualityRuleProviderLog.LoadFailed(_logger));
                _rules = [];
                return _lastResult;
            }

            _rules = result.Value?.ToList() ?? [];
            QualityRuleProviderLog.LoadCompleted(_logger, _rules.Count);
            return result;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { QualityRuleProviderLog.LoadException(_logger, ex) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            _rules = [];
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleCreate(CreateQualityRulePayload request, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        QualityRuleProviderLog.Creating(_logger, request.Name);

        try
        {
            var result = await _qualityApi!.CreateRule(request, ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(QualityRuleProviderLog.CreateFailed(_logger, request.Name));
                return;
            }

            QualityRuleProviderLog.Created(_logger, request.Name);
            await LoadRules(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { QualityRuleProviderLog.CreateException(_logger, ex, request.Name) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleUpdate(Guid id, UpdateQualityRulePayload request, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        QualityRuleProviderLog.Updating(_logger, id);

        try
        {
            var result = await _qualityApi!.UpdateRule(id, request, ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(QualityRuleProviderLog.UpdateFailed(_logger, id));
                return;
            }

            QualityRuleProviderLog.Updated(_logger, id);
            await LoadRules(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { QualityRuleProviderLog.UpdateException(_logger, ex, id) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleDelete(Guid id, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        QualityRuleProviderLog.Deleting(_logger, id);

        try
        {
            var result = await _qualityApi!.DeleteRule(id, ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(QualityRuleProviderLog.DeleteFailed(_logger, id));
                return;
            }

            QualityRuleProviderLog.Deleted(_logger, id);
            await LoadRules(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { QualityRuleProviderLog.DeleteException(_logger, ex, id) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleExecute(Guid id, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        QualityRuleProviderLog.Executing(_logger, id);

        try
        {
            var result = await _qualityApi!.ExecuteCheck(id, ct);
            if (!result.IsSuccess)
            {
                _lastResult = GenericResult.Failure(QualityRuleProviderLog.ExecuteFailed(_logger, id));
                return;
            }

            QualityRuleProviderLog.Executed(_logger, id);
            await LoadRules(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(QualityRuleProviderLog.ExecuteException(_logger, ex, id));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new QualityRuleContext
        {
            Rules = _rules,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnCreate = request => HandleCreate(request),
            OnUpdate = (id, request) => HandleUpdate(id, request),
            OnDelete = id => HandleDelete(id),
            OnExecute = id => HandleExecute(id),
            OnRefresh = () => LoadRules()
        };
    }
}
