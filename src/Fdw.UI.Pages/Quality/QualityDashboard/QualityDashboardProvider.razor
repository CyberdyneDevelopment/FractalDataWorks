@namespace Fdw.Services.Quality.Components.QualityDashboard
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Services.Quality.Clients
@using Fdw.Services.Quality.Clients.Models
@using Fdw.Services.Quality.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    // ── Parameters ──────────────────────────────────────────────────────────────

    [Parameter] public RenderFragment<QualityDashboardContext>? ChildContent { get; set; }

    // ── Injected Services ───────────────────────────────────────────────────────

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private QualityApiClient? _qualityApi;
    [Inject] private ILogger<QualityDashboardProvider>? LoggerParam { get; set; }

    private ILogger<QualityDashboardProvider> _logger = NullLogger<QualityDashboardProvider>.Instance;

    // ── State ───────────────────────────────────────────────────────────────────

    private QualityDashboardPayload? _dashboard;
    private IReadOnlyList<QualityRuleSummaryPayload> _recentExecutions = [];
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private QualityDashboardContext _context = new();
    private bool _initialized;

    // ── Lifecycle ───────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _qualityApi = new QualityApiClient(HttpClientFactory.CreateClient("QualityClient"), LoggerFactory?.CreateLogger<QualityApiClient>()!);
        _logger = LoggerParam ?? NullLogger<QualityDashboardProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadDashboard();
        }
    }

    // ── Private Operations ─────────────────────────────────────────────────────

    private async Task<IGenericResult> LoadDashboard(CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        QualityDashboardProviderLog.LoadStarted(_logger);

        try
        {
            var dashResult = await _qualityApi!.GetDashboard(ct);
            if (!dashResult.IsSuccess)
            {
                QualityDashboardProviderLog.LoadFailed(_logger);
                _lastResult = dashResult;
                _dashboard = null;
                _recentExecutions = [];
                return dashResult;
            }

            _dashboard = dashResult.Value;

            var rulesResult = await _qualityApi!.GetRules(ct);
            _recentExecutions = rulesResult.IsSuccess ? rulesResult.Value?.ToList() ?? [] : [];

            QualityDashboardProviderLog.LoadCompleted(_logger);
            return rulesResult;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(QualityDashboardProviderLog.LoadException(_logger, ex));
            _dashboard = null;
            _recentExecutions = [];
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new QualityDashboardContext
        {
            Dashboard = _dashboard,
            RecentExecutions = _recentExecutions,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnRefresh = () => LoadDashboard()
        };
    }
}
