@page "/quality/rules"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Quality Rules - Cyberdyne</PageTitle>

<QualityRuleProvider>
    <ChildContent Context="ctx">
        <div class="pagehead">
            <div>
                <div class="ey"><a href="/quality">Quality</a> / Rules</div>
                <h1>Quality Rules</h1>
                <div class="sub">Define and run validation rules against your DataSets.</div>
            </div>
            <div class="actions">
                <button class="btn btn-secondary" @onclick="async () => await ctx.OnRefresh()" disabled="@ctx.IsLoading">
                    <Icon Name="Refresh" />
                    Refresh
                </button>
                <button class="btn btn-primary" @onclick="() => { _showCreate = true; _showEdit = false; }" disabled="@ctx.IsLoading">
                    <Icon Name="Add" />
                    New Rule
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
        {
            <div class="card"><div class="card-b"><div class="alert alert-err">@ctx.ErrorMessage</div></div></div>
        }

        @if (_showCreate)
        {
            <div class="card">
                <div class="card-h"><h3>Create Quality Rule</h3></div>
                <div class="card-b">
                    <div class="fgrid">
                        <div class="frow">
                            <label>Name</label>
                            <input class="fin" @bind="_createName" placeholder="Rule name" />
                        </div>
                        <div class="frow">
                            <label>Description</label>
                            <input class="fin" @bind="_createDescription" placeholder="What this rule checks" />
                        </div>
                        <div class="frow">
                            <label>DataSet Name</label>
                            <input class="fin" @bind="_createDataSetName" placeholder="DataSet this rule applies to" />
                        </div>
                        <div class="frow">
                            <label>Rule Type</label>
                            <select class="fin" @bind="_createRuleType">
                                <option value="">Select rule type...</option>
                                <option value="NotNull">NotNull</option>
                                <option value="Unique">Unique</option>
                                <option value="InRange">InRange</option>
                                <option value="MatchesPattern">MatchesPattern</option>
                                <option value="CustomExpression">CustomExpression</option>
                            </select>
                        </div>
                    </div>
                    <div class="actions u-jc-end">
                        <button class="btn btn-ghost btn-sm" @onclick="() => _showCreate = false">Cancel</button>
                        <button class="btn btn-primary btn-sm" @onclick="async () => await SubmitCreate(ctx)" disabled="@ctx.IsLoading">Create</button>
                    </div>
                </div>
            </div>
        }

        @if (_showEdit && _editingId.HasValue)
        {
            <div class="card">
                <div class="card-h"><h3>Edit Quality Rule</h3></div>
                <div class="card-b">
                    <div class="fgrid">
                        <div class="frow">
                            <label>Name</label>
                            <input class="fin" @bind="_editName" placeholder="Rule name" />
                        </div>
                        <div class="frow">
                            <label>Description</label>
                            <input class="fin" @bind="_editDescription" placeholder="What this rule checks" />
                        </div>
                        <div class="frow full">
                            <label>Enabled</label>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <button type="button" class="sw swbtn @(_editIsEnabled ? "on" : null)" @onclick="() => _editIsEnabled = !_editIsEnabled"></button>
                                <span style="font-size:13px;color:var(--n-300);">@(_editIsEnabled ? "Rule is enabled" : "Rule is disabled")</span>
                            </div>
                        </div>
                    </div>
                    <div class="actions u-jc-end">
                        <button class="btn btn-ghost btn-sm" @onclick="() => { _showEdit = false; _editingId = null; }">Cancel</button>
                        <button class="btn btn-primary btn-sm" @onclick="async () => await SubmitEdit(ctx)" disabled="@ctx.IsLoading">Save</button>
                    </div>
                </div>
            </div>
        }

        @if (ctx.IsLoading && !ctx.Rules.Any())
        {
            <div class="loadwrap"><div class="spin"></div></div>
        }
        else if (!ctx.Rules.Any())
        {
            <div class="card">
                <div class="card-b" style="text-align:center;padding:40px 20px;">
                    <p style="color:var(--n-300);margin:0 0 6px;">No quality rules defined</p>
                    <p class="hint u-m-0">Create rules to validate data quality across your pipelines</p>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-h"><h3>Quality Rules</h3></div>
                <div class="card-b" style="padding:0 10px 12px;">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Enabled</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in ctx.Rules)
                            {
                                <tr>
                                    <td><div class="cellpad nm">@rule.Name</div></td>
                                    <td class="mut">@rule.Description</td>
                                    <td>
                                        <span class="badge @(rule.IsEnabled ? "b-ok" : "b-idle")"><span class="bd"></span>@(rule.IsEnabled ? "Enabled" : "Disabled")</span>
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="() => BeginEdit(rule)" disabled="@ctx.IsLoading">Edit</button>
                                            <button class="btn btn-ghost btn-sm" @onclick="async () => await ctx.OnExecute(rule.Id)" disabled="@ctx.IsLoading">Execute</button>
                                            <button class="btn btn-ghost btn-sm danger" @onclick="async () => await ctx.OnDelete(rule.Id)" disabled="@ctx.IsLoading">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </ChildContent>
</QualityRuleProvider>

@code {
    private bool _showCreate;
    private string _createName = string.Empty;
    private string _createDescription = string.Empty;
    private string _createDataSetName = string.Empty;
    private string _createRuleType = string.Empty;

    private bool _showEdit;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private string _editDescription = string.Empty;
    private bool _editIsEnabled;

    private async Task SubmitCreate(QualityRuleContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_createName)) return;

        await ctx.OnCreate(new CreateQualityRulePayload
        {
            Name = _createName,
            Description = _createDescription,
            DataSetName = _createDataSetName,
            RuleType = _createRuleType,
            Expression = string.Empty,
        });

        _createName = string.Empty;
        _createDescription = string.Empty;
        _createDataSetName = string.Empty;
        _createRuleType = string.Empty;
        _showCreate = false;
    }

    private void BeginEdit(QualityRuleSummaryPayload rule)
    {
        _editingId = rule.Id;
        _editName = rule.Name;
        _editDescription = rule.Description ?? string.Empty;
        _editIsEnabled = rule.IsEnabled;
        _showEdit = true;
        _showCreate = false;
    }

    private async Task SubmitEdit(QualityRuleContext ctx)
    {
        if (_editingId is null || string.IsNullOrWhiteSpace(_editName)) return;

        await ctx.OnUpdate(_editingId.Value, new UpdateQualityRulePayload
        {
            Name = _editName,
            Description = _editDescription,
            IsEnabled = _editIsEnabled,
        });

        _showEdit = false;
        _editingId = null;
    }
}
