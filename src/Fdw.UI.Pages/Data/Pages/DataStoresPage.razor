@page "/datastores"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>DataStores - Cyberdyne</PageTitle>

<DataStoreProvider>
    <ChildContent Context="ctx">
        <PageHeader Eyebrow="Data Sources" Title="DataStores" Subtitle="Logical DataSet → physical DataStore → DataPath → DataContainer.">
            <Actions>
                <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/datastores/new")'>
                    <Icon Name="Add" />
                    New DataStore
                </button>
            </Actions>
        </PageHeader>

        @if (ctx.IsLoading && !ctx.DataStores.Any())
        {
            <div class="loadwrap"><div class="spin"></div></div>
        }
        else if (!ctx.DataStores.Any())
        {
            <div class="card"><div class="card-b"><div class="empty">No DataStores configured. Register a DataStore to map physical storage paths.</div></div></div>
        }
        else
        {
            <div class="card">
                <div class="card-h"><h3>All DataStores</h3></div>
                <div class="card-b fdw-table-body">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Connection</th>
                                <th>Paths</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var store in ctx.FilteredDataStores)
                            {
                                <tr class="u-pointer" @onclick='() => Nav.NavigateTo($"/datastores/{store.Name}")'>
                                    <td><div class="cellpad nm">@store.Name</div></td>
                                    <td class="mut">@store.ConnectionName</td>
                                    <td class="num">@store.PathCount</td>
                                    <td>
                                        <div class="actions">
                                            <button class="btn btn-ghost btn-sm" @onclick='() => Nav.NavigateTo($"/datastores/{store.Name}/edit")' @onclick:stopPropagation="true">
                                                <Icon Name="Edit" />
                                            </button>
                                            <button class="btn btn-ghost btn-sm danger" @onclick="() => ConfirmDelete(store.Name)" @onclick:stopPropagation="true">
                                                <Icon Name="Delete" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_deleteTarget != null)
        {
            <div class="overlay">
                <div class="modal">
                    <div class="card-h"><h3>Confirm Delete</h3></div>
                    <div class="card-b">
                        <p style="font-size:13px;color:var(--n-400);margin:0 0 18px;">Are you sure you want to delete data store <span class="mono danger">@_deleteTarget</span>? This action cannot be undone.</p>
                        <div class="actions u-jc-end">
                            <button class="btn btn-secondary btn-sm" @onclick="() => _deleteTarget = null">Cancel</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ExecuteDelete(ctx)">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</DataStoreProvider>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private string? _deleteTarget;

    private void ConfirmDelete(string name)
    {
        _deleteTarget = name;
    }

    private async Task ExecuteDelete(DataStoreContext ctx)
    {
        if (_deleteTarget == null) return;
        var name = _deleteTarget;
        await ctx.OnDeleteDataStore(name);
        _deleteTarget = null;
    }
}
