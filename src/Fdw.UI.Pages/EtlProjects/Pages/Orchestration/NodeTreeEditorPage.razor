@page "/orchestration/edit"
@page "/orchestration/edit/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components
@using Fdw.Services.Etl.Projects.Abstractions.Configuration

<PageTitle>@(_id.HasValue ? "Edit Node" : "New Node") - Cyberdyne</PageTitle>

<OrchestrationNodeProvider>
    <ChildContent Context="ctx">
        <div style="max-width:920px;">
            <div class="pagehead">
                <div>
                    <div class="ey">Orchestration / @(_id.HasValue ? "Edit" : "New")</div>
                    <h1>@(_id.HasValue ? "Edit Node" : "New Node")</h1>
                </div>
                <div class="actions">
                    <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("/orchestration")'>
                        Cancel
                    </button>
                </div>
            </div>

            @if (ctx.ErrorMessage is not null)
            {
                <div class="card b-fail" style="margin-bottom:14px;padding:14px 16px;">
                    <span class="mono" style="font-size:12px;color:var(--signal);">@ctx.ErrorMessage</span>
                </div>
            }

            @if (ctx.IsLoading)
            {
                <div class="card fdw-empty-square">
                    <span class="mono u-fg-n500">Loading…</span>
                </div>
            }
            else
            {
                <!-- Basic Fields -->
                <section class="card u-mb-14">
                    <div class="card-h"><h3>Basic Information</h3></div>
                    <div class="card-b">
                        <div class="frow">
                            <label>Name *</label>
                            <input type="text" class="finput" placeholder="node-name" @bind="_name" />
                        </div>

                        <div class="frow">
                            <label>Description</label>
                            <textarea class="finput" style="height:80px;resize:none;" placeholder="Optional description" @bind="_description"></textarea>
                        </div>

                        <label style="display:flex;align-items:center;gap:11px;cursor:pointer;margin-bottom:16px;">
                            <input type="checkbox" id="enabled" @bind="_isEnabled" />
                            <span style="font-size:13px;color:var(--n-200);">Enabled for execution</span>
                        </label>

                        <div class="frow u-mb-0">
                            <label>Ordinal (execution order among siblings)</label>
                            <input type="number" class="finput" min="0" @bind="_ordinal" />
                        </div>
                    </div>
                </section>

                <!-- Policy Panel -->
                <section class="card u-mb-14">
                    <div class="card-h"><h3>Execution Policy</h3></div>
                    <div class="card-b">
                        <p class="hint" style="margin-top:0;margin-bottom:16px;">NULL inherits from parent or server defaults. Child levels may override to be stricter only.</p>

                        <div class="fgrid u-mb-16">
                            <div class="frow u-mb-0">
                                <label>Stage Failure Policy</label>
                                <select class="finput" @bind="_stageFailurePolicy">
                                    <option value="">inherit</option>
                                    <option value="HaltProject">HaltProject (stricter)</option>
                                    <option value="ContinueProject">ContinueProject</option>
                                </select>
                            </div>

                            <div class="frow u-mb-0">
                                <label>Step Failure Policy</label>
                                <select class="finput" @bind="_stepFailurePolicy">
                                    <option value="">inherit</option>
                                    <option value="HaltStage">HaltStage (stricter)</option>
                                    <option value="ContinueStage">ContinueStage</option>
                                </select>
                            </div>

                            <div class="frow u-mb-0">
                                <label>Max Parallel Pipelines</label>
                                <input type="number" class="finput" placeholder="inherit" min="1"
                                       value="@_maxParallelPipelines?.ToString()"
                                       @oninput="e => _maxParallelPipelines = int.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                            </div>
                        </div>

                        <div style="display:flex;flex-direction:column;gap:10px;">
                            <label style="display:flex;align-items:center;gap:11px;cursor:pointer;">
                                <input type="checkbox" id="approvalRequired"
                                       checked="@(_requireApprovalToRun == true)"
                                       @oninput="e => _requireApprovalToRun = (bool?)e.Value" />
                                <span style="font-size:13px;color:var(--n-200);">Require approval to run</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:11px;cursor:pointer;">
                                <input type="checkbox" id="allowCrossTenant"
                                       checked="@(_allowCrossTenant == true)"
                                       @oninput="e => _allowCrossTenant = (bool?)e.Value" />
                                <span style="font-size:13px;color:var(--n-200);">Allow cross-tenant pipelines</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:11px;cursor:pointer;">
                                <input type="checkbox" id="allowResume"
                                       checked="@(_allowResume == true)"
                                       @oninput="e => _allowResume = (bool?)e.Value" />
                                <span style="font-size:13px;color:var(--n-200);">Allow resume from checkpoint</span>
                            </label>
                        </div>
                    </div>
                </section>

                <!-- Save Button -->
                <div class="actions u-jc-end">
                    <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("/orchestration")'>Cancel</button>
                    <button class="btn btn-primary" @onclick="() => Save(ctx)" disabled="@ctx.IsLoading">
                        @(_id.HasValue ? "Save Changes" : "Create Node")
                    </button>
                </div>
            }
        </div>
    </ChildContent>
</OrchestrationNodeProvider>

@code {
    [Parameter] public Guid? Id { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private Guid? _id;
    private string _name = string.Empty;
    private string? _description;
    private bool _isEnabled = true;
    private int _ordinal;
    private string? _stageFailurePolicy;
    private string? _stepFailurePolicy;
    private int? _maxParallelPipelines;
    private bool? _requireApprovalToRun;
    private bool? _allowCrossTenant;
    private bool? _allowResume;

    protected override async Task OnParametersSetAsync()
    {
        _id = Id;
    }

    private async Task Save(OrchestrationNodeContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        var config = new OrchestrationNodeConfiguration
        {
            Id = _id ?? Guid.NewGuid(),
            Name = _name,
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
            IsEnabled = _isEnabled,
            Ordinal = _ordinal,
            StageFailurePolicy = string.IsNullOrEmpty(_stageFailurePolicy) ? null : _stageFailurePolicy,
            StepFailurePolicy = string.IsNullOrEmpty(_stepFailurePolicy) ? null : _stepFailurePolicy,
            MaxParallelPipelines = _maxParallelPipelines,
            RequireApprovalToRun = _requireApprovalToRun,
            AllowCrossTenant = _allowCrossTenant,
            AllowResume = _allowResume
        };

        OrchestrationNodeConfiguration? result;
        if (_id.HasValue)
        {
            result = await ctx.OnUpdateNode(_id.Value, config);
        }
        else
        {
            result = await ctx.OnCreateNode(config);
        }

        if (result is not null)
        {
            Nav.NavigateTo("/orchestration");
        }
    }
}
