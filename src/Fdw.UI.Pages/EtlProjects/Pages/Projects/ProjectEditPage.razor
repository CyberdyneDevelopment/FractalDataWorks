@page "/projects/edit"
@page "/projects/edit/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http
@using Microsoft.AspNetCore.Components

<PageTitle>@(_id.HasValue ? "Edit Project" : "New Project") - Cyberdyne</PageTitle>

<ProjectProvider>
    <ChildContent Context="ctx">
        <div style="max-width:920px;">
            <div class="pagehead">
                <div>
                    <div class="ey">Projects / @(_id.HasValue ? "Edit" : "New")</div>
                    <h1>@(_id.HasValue ? "Edit Project" : "New Project")</h1>
                </div>
                <div class="actions">
                    <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("/projects")'>
                        Cancel
                    </button>
                </div>
            </div>

            @if (ctx.ErrorMessage is not null)
            {
                <div class="card b-fail" style="margin-bottom:14px;padding:14px 16px;">
                    <span class="mono u-fs-12" style="color:var(--signal);">@ctx.ErrorMessage</span>
                </div>
            }

            @if (ctx.IsLoading)
            {
                <div class="card fdw-empty-square">
                    <span class="mono u-fg-n500">Loading…</span>
                </div>
            }
            else
            {
                <!-- Basic Fields -->
                <section class="card u-mb-14">
                    <div class="card-h"><h3>Basic Information</h3></div>
                    <div class="card-b">
                        <div class="frow">
                            <label>Name *</label>
                            <input type="text" class="finput" placeholder="project-name" @bind="_name" />
                        </div>

                        <div class="frow">
                            <label>Description</label>
                            <textarea class="finput" style="height:80px;resize:none;" placeholder="Optional description" @bind="_description"></textarea>
                        </div>

                        <label style="display:flex;align-items:center;gap:11px;cursor:pointer;">
                            <input type="checkbox" id="enabled" @bind="_isEnabled" />
                            <span class="u-fs-13" style="color:var(--n-200);">Enabled for execution</span>
                        </label>
                    </div>
                </section>

                <!-- Policy Panel -->
                <section class="card u-mb-14">
                    <div class="card-h"><h3>Execution Policy</h3></div>
                    <div class="card-b">
                        <p class="hint" style="margin-top:0;margin-bottom:16px;">NULL inherits from server defaults. Child levels may override to be stricter only.</p>

                        <div class="fgrid u-mb-16">
                            <div class="frow u-mb-0">
                                <label>Stage Failure Policy</label>
                                <select class="finput" @bind="_stageFailurePolicy">
                                    <option value="">inherit</option>
                                    <option value="HaltProject">HaltProject (stricter)</option>
                                    <option value="ContinueProject">ContinueProject</option>
                                </select>
                            </div>

                            <div class="frow u-mb-0">
                                <label>Step Failure Policy</label>
                                <select class="finput" @bind="_stepFailurePolicy">
                                    <option value="">inherit</option>
                                    <option value="HaltStage">HaltStage (stricter)</option>
                                    <option value="ContinueStage">ContinueStage</option>
                                </select>
                            </div>

                            <div class="frow u-mb-0">
                                <label>Max Parallel Pipelines</label>
                                <input type="number" class="finput" placeholder="inherit" min="1"
                                       value="@_maxParallelPipelines?.ToString()"
                                       @oninput="e => _maxParallelPipelines = int.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                            </div>

                            <div class="frow u-mb-0">
                                <label>Resiliency Policy Name</label>
                                <input type="text" class="finput" placeholder="inherit" @bind="_resiliencePolicyName" />
                            </div>
                        </div>

                        <div style="display:flex;flex-direction:column;gap:10px;">
                            <label style="display:flex;align-items:center;gap:11px;cursor:pointer;">
                                <input type="checkbox" id="approvalRequired"
                                       checked="@(_requireApprovalToRun == true)"
                                       @oninput="e => _requireApprovalToRun = (bool?)e.Value" />
                                <span class="u-fs-13" style="color:var(--n-200);">Require approval to run</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:11px;cursor:pointer;">
                                <input type="checkbox" id="allowCrossTenant"
                                       checked="@(_allowCrossTenant == true)"
                                       @oninput="e => _allowCrossTenant = (bool?)e.Value" />
                                <span class="u-fs-13" style="color:var(--n-200);">Allow cross-tenant pipelines</span>
                            </label>
                        </div>
                    </div>
                </section>

                <!-- Stages Designer -->
                @if (_id.HasValue)
                {
                    <StageProvider>
                        <ChildContent Context="stageCtx">
                            <section class="card u-mb-14">
                                <div class="card-h">
                                    <h3>Stages</h3>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => AddStage(stageCtx)">
                                        + Add Stage
                                    </button>
                                </div>
                                <div class="card-b">
                                    @if (stageCtx.Stages.Any())
                                    {
                                        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;">
                                            @foreach (var stage in stageCtx.Stages.OrderBy(s => s.Ordinal))
                                            {
                                                <li class="u-r-8" style="display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--s2);">
                                                    <span class="mono num" style="width:24px;text-align:center;">@stage.Ordinal</span>
                                                    <span class="mono" style="flex:1;color:var(--glacier-soft);">@stage.Name</span>
                                                    <button class="btn btn-ghost btn-sm u-fg-signal"
                                                            @onclick="() => stageCtx.OnDeleteStage(stage.Id)">
                                                        Remove
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else if (!stageCtx.IsLoading)
                                    {
                                        <p class="hint" style="text-align:center;padding:16px 0;">No stages yet. Add a stage to define execution order.</p>
                                    }
                                </div>
                            </section>
                        </ChildContent>
                    </StageProvider>
                }

                <!-- Save Button -->
                <div class="actions u-jc-end">
                    <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("/projects")'>Cancel</button>
                    <button class="btn btn-primary" @onclick="() => Save(ctx)" disabled="@ctx.IsLoading">
                        @(_id.HasValue ? "Save Changes" : "Create Project")
                    </button>
                </div>
            }
        </div>
    </ChildContent>
</ProjectProvider>

@code {
    [Parameter] public Guid? Id { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private Guid? _id;
    private string _name = string.Empty;
    private string? _description;
    private bool _isEnabled = true;
    private string? _stageFailurePolicy;
    private string? _stepFailurePolicy;
    private int? _maxParallelPipelines;
    private bool? _requireApprovalToRun;
    private bool? _allowCrossTenant;
    private string? _resiliencePolicyName;

    protected override async Task OnParametersSetAsync()
    {
        _id = Id;
    }

    private async Task Save(ProjectContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        var config = new ProjectConfiguration
        {
            Id = _id ?? Guid.NewGuid(),
            Name = _name,
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
            IsEnabled = _isEnabled,
            StageFailurePolicy = string.IsNullOrEmpty(_stageFailurePolicy) ? null : _stageFailurePolicy,
            StepFailurePolicy = string.IsNullOrEmpty(_stepFailurePolicy) ? null : _stepFailurePolicy,
            MaxParallelPipelines = _maxParallelPipelines,
            RequireApprovalToRun = _requireApprovalToRun,
            AllowCrossTenant = _allowCrossTenant
            // Why: ResiliencyPolicyId requires a Guid lookup from the selected policy name.
            // The _resiliencePolicyName field is retained in the form for the future
            // dropdown binding but is not yet wired to ResiliencyPolicyId.
        };

        ProjectConfiguration? result;
        if (_id.HasValue)
        {
            result = await ctx.OnUpdateProject(_id.Value, config);
        }
        else
        {
            result = await ctx.OnCreateProject(config);
        }

        if (result is not null)
        {
            Nav.NavigateTo("/projects");
        }
    }

    private async Task AddStage(StageContext stageCtx)
    {
        if (_id is null) return;

        var ordinal = stageCtx.Stages.Any() ? stageCtx.Stages.Max(s => s.Ordinal) + 1 : 0;
        var newStage = new StageConfiguration
        {
            Id = Guid.NewGuid(),
            Name = $"Stage {ordinal + 1}",
            Ordinal = ordinal,
            ProjectConfigurationId = _id.Value
        };

        await stageCtx.OnCreateStage(newStage);
    }
}
