@namespace Fdw.Services.Etl.Projects.UI.Components.Providers
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Threading
@using System.Threading.Tasks
@using System.Collections.Generic
@using System.Linq
@using System.Net.Http
@using Fdw.Results
@using Fdw.Services.Etl.Projects.Clients
@using Fdw.Services.Etl.Projects.Abstractions.Configuration
@using Fdw.Services.Etl.Projects.UI.Components.Logging

@*
    Headless component that provides generic OrchestrationNode CRUD logic and state.
    Operates on the unified pipe.OrchestrationNode table via the NodeApiClient.
*@

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    /// <summary>
    /// Headless provider for generic orchestration node operations. Owns node loading and CRUD logic.
    /// No UI markup.
    /// </summary>
    [Parameter] public RenderFragment<OrchestrationNodeContext>? ChildContent { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    [Inject] private ILogger<OrchestrationNodeProvider>? LoggerParam { get; set; }
    private ILogger<OrchestrationNodeProvider> _logger = NullLogger<OrchestrationNodeProvider>.Instance;

    private NodeApiClient? _nodeApi;

    // ── State ──────────────────────────────────────────────────────────────────

    private IReadOnlyList<OrchestrationNodeConfiguration> _rootNodes = [];
    private OrchestrationNodeConfiguration? _currentNode;
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private string _searchString = string.Empty;
    private OrchestrationNodeContext _context = new();
    private bool _initialized;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _nodeApi = new NodeApiClient(HttpClientFactory.CreateClient("NodeClient"), LoggerFactory?.CreateLogger<NodeApiClient>()!);
        // Why: NullLogger fallback ensures the provider operates without DI-wired logging.
        _logger = LoggerParam ?? NullLogger<OrchestrationNodeProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadData();
        }
    }

    // ── Methods (exposed as callbacks via OrchestrationNodeContext) ─────────────

    private async Task LoadData(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _nodeApi!.ListRootNodes(cancellationToken);
            if (result.IsSuccess)
            {
                _rootNodes = result.Value?.ToList() ?? [];
            }
            else
            {
                OrchestrationNodeProviderLog.LoadNodesFailed(_logger);
                _lastResult = result;
                _rootNodes = [];
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.LoadNodesException(_logger, ex));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<OrchestrationNodeConfiguration?> GetNode(Guid nodeId, int? depth, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = depth.HasValue
                ? await _nodeApi!.GetNodeDeep(nodeId, depth.Value, cancellationToken)
                : await _nodeApi!.GetNode(nodeId, cancellationToken);

            if (result.IsSuccess)
            {
                return result.Value;
            }

            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeDetailLoadFailed(_logger, nodeId.ToString()));
            return null;
        }
        catch (OperationCanceledException)
        {
            return null;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeDetailLoadException(_logger, ex));
            return null;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<OrchestrationNodeConfiguration?> CreateNode(OrchestrationNodeConfiguration request, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _nodeApi!.CreateNode(request, cancellationToken);
            if (result.IsSuccess)
            {
                await LoadData(cancellationToken);
                return result.Value;
            }

            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeCreateFailed(_logger));
            return null;
        }
        catch (OperationCanceledException)
        {
            return null;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeCreateException(_logger, ex));
            return null;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<OrchestrationNodeConfiguration?> UpdateNode(Guid nodeId, OrchestrationNodeConfiguration request, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _nodeApi!.UpdateNode(nodeId, request, cancellationToken);
            if (result.IsSuccess)
            {
                await LoadData(cancellationToken);
                return result.Value;
            }

            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeUpdateFailed(_logger, nodeId.ToString()));
            return null;
        }
        catch (OperationCanceledException)
        {
            return null;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeUpdateException(_logger, ex));
            return null;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<bool> DeleteNode(Guid nodeId, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _nodeApi!.DeleteNode(nodeId, cancellationToken);
            if (result.IsSuccess)
            {
                await LoadData(cancellationToken);
                return true;
            }

            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeDeleteFailed(_logger, nodeId.ToString()));
            return false;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(OrchestrationNodeProviderLog.NodeDeleteException(_logger, ex));
            return false;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private IEnumerable<OrchestrationNodeConfiguration> GetFilteredRootNodes()
    {
        return string.IsNullOrWhiteSpace(_searchString)
            ? _rootNodes
            : _rootNodes.Where(n => n.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                                    (n.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    private void SelectNode(OrchestrationNodeConfiguration? node)
    {
        _currentNode = node;
        RebuildContext();
        StateHasChanged();
    }

    private void SetSearchString(string value)
    {
        _searchString = value;
        RebuildContext();
        StateHasChanged();
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new OrchestrationNodeContext
        {
            RootNodes = _rootNodes,
            CurrentNode = _currentNode,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            SearchString = _searchString,
            FilteredRootNodes = GetFilteredRootNodes(),
            OnLoadData = () => LoadData(),
            OnGetNode = (id, depth) => GetNode(id, depth),
            OnCreateNode = request => CreateNode(request),
            OnUpdateNode = (id, request) => UpdateNode(id, request),
            OnDeleteNode = id => DeleteNode(id),
            OnSelectNode = SelectNode,
            OnSearchStringChanged = SetSearchString
        };
    }
}
