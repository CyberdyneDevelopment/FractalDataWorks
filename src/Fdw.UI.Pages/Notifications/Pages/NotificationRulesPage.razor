@page "/admin/notifications/rules"
@attribute [Authorize(Policy = "notifications:read")]
@using System.Security.Claims

<PageTitle>Notification Rules - Cyberdyne</PageTitle>

<NotificationsProvider UserId="_currentUserId">
    <ChildContent Context="ctx">
        <div class="pagehead">
            <div>
                <div class="ey">Administration &rsaquo; Notifications</div>
                <h1>Notification Rules</h1>
                <div class="sub">Rules determine which notification service fires for a given event and severity.</div>
            </div>
            <div class="actions">
                <a href="/admin/notifications" class="btn btn-ghost">
                    <Icon Name="Back" />
                    Back to Notifications
                </a>
                <button class="btn btn-ghost" @onclick="() => ctx.OnLoadRules()">
                    <Icon Name="Refresh" />
                    Refresh
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
        {
            <div class="card" style="margin-bottom:14px;">
                <div class="card-b mono" style="color:var(--signal);">@ctx.ErrorMessage</div>
            </div>
        }

        @if (ctx.IsLoading && ctx.Rules.Count == 0)
        {
            <div class="card">
                <div class="card-b" style="padding:48px 20px;text-align:center;">
                    <p class="mut" style="color:var(--n-500);">Loading rules&hellip;</p>
                </div>
            </div>
        }
        else if (ctx.Rules.Count == 0)
        {
            <div class="card">
                <div class="card-b" style="padding:48px 20px;text-align:center;">
                    <p style="color:var(--n-500);">No notification rules configured.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-h"><h3>Rules</h3></div>
                <div class="card-b" style="padding:0 10px 12px;">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Name</th>
                                <th>Service Type</th>
                                <th>Service Name</th>
                                <th>Severity</th>
                                <th>Description</th>
                                <th>Enabled</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in ctx.Rules)
                            {
                                <tr>
                                    <td style="width:28px;">
                                        <button class="btn btn-ghost btn-sm"
                                                title="@(_expandedRuleId == rule.Id ? "Collapse" : "Expand details")"
                                                @onclick="() => ToggleExpand(rule.Id)">
                                            <Icon Name="ChevronRight" Style="@($"width:14px;height:14px;transition:transform .15s;transform:rotate({(_expandedRuleId == rule.Id ? "90deg" : "0deg")});")" />
                                        </button>
                                    </td>
                                    <td><div class="cellpad nm">@rule.Name</div></td>
                                    <td class="mut">@rule.NotificationServiceType</td>
                                    <td class="mut">@rule.NotificationServiceName</td>
                                    <td>
                                        <span class="badge @GetSeverityClass(rule.Severity)">@rule.Severity</span>
                                    </td>
                                    <td class="mut">@(rule.Description ?? "—")</td>
                                    <td class="mut">
                                        <span class="sw @(rule.IsEnabled ? "on" : "")" title="@(rule.IsEnabled ? "Enabled" : "Disabled")"></span>
                                    </td>
                                </tr>
                                @if (_expandedRuleId == rule.Id)
                                {
                                    <tr>
                                        <td colspan="7" style="padding:0 12px 12px;background:var(--surface-2,var(--n-950));">
                                            <div style="display:flex;gap:24px;flex-wrap:wrap;padding-top:10px;">
                                                <div style="flex:1;min-width:200px;">
                                                    <p class="mut" style="font-size:11px;margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;">Lists used as recipients</p>
                                                    @if (ctx.Lists.Count == 0)
                                                    {
                                                        <p class="mut" style="font-size:12px;">No lists loaded — <button class="btn btn-ghost btn-sm" @onclick="() => ctx.OnLoadLists()">load lists</button></p>
                                                    }
                                                    else
                                                    {
                                                        <ul style="list-style:none;padding:0;margin:0;">
                                                            @foreach (var list in ctx.Lists)
                                                            {
                                                                <li style="font-size:12px;padding:2px 0;" class="mut">@list.Name (@list.MemberCount members)</li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                                <div style="flex:1;min-width:200px;">
                                                    <p class="mut" style="font-size:11px;margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;">Rule details</p>
                                                    <div style="font-size:12px;" class="mono">
                                                        <div>ID: @rule.Id.ToString("D")</div>
                                                        <div>Service: @rule.NotificationServiceType / @rule.NotificationServiceName</div>
                                                        <div>Severity: @rule.Severity</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </ChildContent>
</NotificationsProvider>

@code {
    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private Guid _currentUserId;
    private Guid _expandedRuleId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        // Why: the OIDC subject is carried on the "sub" claim (matching the server-side resolution
        // order); only some principals remap it to NameIdentifier. Checking sub first avoids a
        // Guid.Empty round-trip that would silently load/save nothing.
        var userIdValue = authState.User.FindFirst("sub")?.Value
            ?? authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdValue, out var id) && id != Guid.Empty)
            _currentUserId = id;
    }

    private void ToggleExpand(Guid ruleId)
    {
        _expandedRuleId = _expandedRuleId == ruleId ? Guid.Empty : ruleId;
    }

    private static string GetSeverityClass(string severity) =>
        severity.ToUpperInvariant() switch
        {
            "CRITICAL" => "badge-danger",
            "HIGH" or "ERROR" => "badge-warning",
            "MEDIUM" or "WARNING" => "badge-caution",
            _ => "badge-idle"
        };
}
