@page "/calculations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Calculations - Cyberdyne</PageTitle>

<CalculationProvider>
    <ChildContent Context="ctx">
        <div class="pagehead">
            <div>
                <div class="ey">Pipelines &amp; Scheduling</div>
                <h1>Calculations</h1>
                <div class="sub">Derived fields via the formula engine — Calculation, Aggregation, Pivot, Lookup.</div>
            </div>
            <div class="actions">
                <a class="btn btn-primary btn-sm" href="/calculations/create">Create Calculation</a>
            </div>
        </div>

        @if (ctx.IsLoading && !ctx.FilteredCalculations.Any())
        {
            <div class="card"><div class="card-b" style="padding:48px 20px;text-align:center;"><p class="mut" style="color:var(--n-500);">Loading calculations&hellip;</p></div></div>
        }
        else if (!ctx.FilteredCalculations.Any())
        {
            <div class="card">
                <div class="card-b" style="padding:48px 20px;text-align:center;">
                    <p style="color:var(--n-300);">No calculations defined</p>
                    <p class="sub" style="margin-top:6px;">Create a calculation to add derived fields to DataSets.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-h"><h3>Calculations</h3></div>
                <div class="card-b" style="padding:0 10px 12px;">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Target DataSet</th>
                                <th>Output Field</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var calc in ctx.FilteredCalculations)
                            {
                                <tr>
                                    <td><div class="cellpad nm">@calc.Name</div></td>
                                    <td class="mut">@calc.TargetDataSet</td>
                                    <td class="num">@calc.ResultFieldName</td>
                                    <td class="mut">
                                        <span class="@(calc.IsEnabled ? "badge b-ok" : "badge b-idle")"><span class="bd"></span>@(calc.IsEnabled ? "Active" : "Disabled")</span>
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <a class="btn btn-ghost btn-sm" href="@($"/calculations/{calc.Id}/edit")">
                                                <Icon Name="Edit" />
                                            </a>
                                            <button class="btn btn-ghost btn-sm" @onclick="() => ConfirmDelete(calc)">
                                                <Icon Name="Delete" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_deleteTarget != null)
        {
            <div style="position:fixed;inset:0;background:rgba(8,9,11,0.6);display:flex;align-items:center;justify-content:center;z-index:50;">
                <div class="card" style="width:384px;">
                    <div class="card-h"><h3>Confirm Delete</h3></div>
                    <div class="card-b">
                        <p class="sub" style="margin-bottom:22px;">Are you sure you want to delete calculation <b style="color:var(--n-100);">@_deleteTarget.Name</b>?</p>
                        <div class="actions" style="justify-content:flex-end;">
                            <button class="btn btn-secondary btn-sm" @onclick="() => _deleteTarget = null">Cancel</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ExecuteDelete(ctx)">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</CalculationProvider>

@code {
    private CalculationSummaryPayload? _deleteTarget;

    private void ConfirmDelete(CalculationSummaryPayload calc)
    {
        _deleteTarget = calc;
    }

    private async Task ExecuteDelete(CalculationContext ctx)
    {
        if (_deleteTarget == null) return;
        await ctx.OnDeleteCalculation(_deleteTarget.Id);
        _deleteTarget = null;
    }
}
