@page "/access-requests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Access Requests - Cyberdyne</PageTitle>

<MessageProvider AutoLoadAccessRequests="true">
    <AccessRequestContent Context="ctx">
        <PageHeader Eyebrow="Admin" Title="Access Requests" Subtitle="Review and manage resource access requests.">
            <Actions>
            </Actions>
        </PageHeader>

        @* Filter chips *@
        <div class="filters">
            <span class="lbl">Status</span>
            @foreach (var status in new[] { "All", "Pending", "Approved", "Denied" })
            {
                <span class="@(string.Equals(_statusFilter, status, StringComparison.Ordinal) ? "chip on" : "chip")"
                      @onclick="@(() => SetFilter(status))">
                    @status
                </span>
            }
        </div>

        <div class="card">
            <div class="card-h"><h3>Requests</h3></div>
            <div class="card-b fdw-table-body">
                @if (ctx.IsLoading)
                {
                    <div class="mono mut" style="padding:20px;">Loading…</div>
                }
                else if (!string.IsNullOrEmpty(ctx.ErrorMessage))
                {
                    <div class="mono" style="padding:20px;color:var(--signal);">@ctx.ErrorMessage</div>
                }
                else if (ApplyFilter(ctx.AccessRequests).Count == 0)
                {
                    <div class="mono mut" style="padding:20px;">No access requests</div>
                }
                else
                {
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Resource</th>
                                <th>Permission</th>
                                <th>Justification</th>
                                <th>Submitted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in ApplyFilter(ctx.AccessRequests))
                            {
                                <tr>
                                    <td><div class="cellpad"><Badge Variant="GetStatusVariant(request.Status)">@request.Status</Badge></div></td>
                                    <td class="mut">@request.RequestedResource</td>
                                    <td class="mut">@request.RequestedPermission</td>
                                    <td class="mut" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(request.Justification ?? "-")</td>
                                    <td class="num">@request.CreatedAt.ToString("g")</td>
                                    <td>
                                        @if (string.Equals(request.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="actions">
                                                <button class="btn btn-ghost btn-sm u-fg-success" title="Approve"
                                                        @onclick="@(async () => await ctx.OnApprove(request.Id, null))">
                                                    <Icon Name="Check" StrokeWidth="2" />
                                                </button>
                                                <button class="btn btn-ghost btn-sm u-fg-signal" title="Deny"
                                                        @onclick="@(() => OpenDenyDialog(request))">
                                                    <Icon Name="Close" />
                                                </button>
                                            </div>
                                        }
                                        else if (request.ReviewNotes is not null)
                                        {
                                            <span class="mut" title="@request.ReviewNotes">
                                                <Icon Name="Document" Style="width:15px;height:15px;display:inline;" />
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        @* Deny dialog *@
        @if (_showDenyDialog && _denyTarget is not null)
        {
            <div class="u-bg-scrim-80" style="position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:16px;">
                <div class="card" style="width:100%;max-width:480px;">
                    <div class="card-h">
                        <h3>Deny Access Request</h3>
                        <button class="btn btn-ghost btn-sm" @onclick="@(() => _showDenyDialog = false)">
                            <Icon Name="Close" />
                        </button>
                    </div>
                    <div class="card-b">
                        <p class="sub u-mb-16">
                            Denying access to: <span class="mono" style="color:var(--n-100);">@_denyTarget.RequestedResource</span>
                            (<span class="mono">@_denyTarget.RequestedPermission</span>)
                        </p>
                        <div class="frow">
                            <label>Notes (optional)</label>
                            <textarea class="finput" rows="3" @bind="_denyNotes" placeholder="Reason for denial..."></textarea>
                        </div>
                        <div class="actions u-jc-end">
                            <button class="btn btn-secondary btn-sm" @onclick="@(() => _showDenyDialog = false)">Cancel</button>
                            <button class="btn btn-danger btn-sm" @onclick="@(async () => await ConfirmDeny(ctx))">Deny</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </AccessRequestContent>
</MessageProvider>

@code {
    private string _statusFilter = "All";
    private bool _showDenyDialog;
    private AccessRequestPayload? _denyTarget;
    private string? _denyNotes;

    private IReadOnlyList<AccessRequestPayload> ApplyFilter(IReadOnlyList<AccessRequestPayload> requests)
    {
        return string.Equals(_statusFilter, "All", StringComparison.OrdinalIgnoreCase)
            ? requests
            : requests.Where(r => string.Equals(r.Status, _statusFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SetFilter(string status)
    {
        _statusFilter = status;
    }

    private void OpenDenyDialog(AccessRequestPayload request)
    {
        _denyTarget = request;
        _denyNotes = null;
        _showDenyDialog = true;
    }

    private async Task ConfirmDeny(AccessRequestListContext ctx)
    {
        if (_denyTarget is not null)
        {
            await ctx.OnDeny(_denyTarget.Id, _denyNotes);
            _showDenyDialog = false;
            _denyTarget = null;
        }
    }

    // Why Approved is the running tone and not the success one: this page shows a request that has
    // been granted but not yet acted on, which the console draws the same as work in flight.
    private static StatusVariantBase GetStatusVariant(string status) => status switch
    {
        "Pending" => StatusVariants.Warning,
        "Approved" => StatusVariants.Info,
        "Denied" => StatusVariants.Error,
        _ => StatusVariants.Neutral
    };
}
