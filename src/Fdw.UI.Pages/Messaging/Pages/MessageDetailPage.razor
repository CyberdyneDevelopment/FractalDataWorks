@page "/messages/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>Message - Cyberdyne</PageTitle>

<MessageProvider AutoLoadMessageId="Id">
    <MessageDetailContent Context="ctx">
        <div class="pagehead">
            <div>
                <div class="ey">System · Messages</div>
                <h1>@(ctx.Message?.Subject ?? "Message")</h1>
                <div class="sub">Notification detail · actor, action, result.</div>
            </div>
            <div class="actions">
                <button class="btn btn-ghost" @onclick="@(() => Navigation.NavigateTo("/messages"))">
                    <Icon Name="Back" />
                    Back to Messages
                </button>
            </div>
        </div>

        @if (ctx.IsLoading)
        {
            <div class="card"><div class="card-b mono mut">Loading…</div></div>
        }
        else if (ctx.Message is null)
        {
            <div class="card"><div class="card-b"><span class="badge b-warn"><span class="bd"></span>Not found</span></div></div>
        }
        else
        {
            <div class="card">
                <div class="card-h">
                    <h3>@ctx.Message.Subject</h3>
                    <Badge Variant="GetSeverityVariant(ctx.Message.Severity)">@ctx.Message.Severity</Badge>
                </div>
                <div class="card-b">
                    <div class="filters u-mb-16">
                        <span class="tpill">@ctx.Message.MessageType</span>
                        <span class="mono mut u-fs-12">@ctx.Message.CreatedAt.ToString("g")</span>
                        @if (!string.IsNullOrEmpty(ctx.Message.ReferenceId))
                        {
                            <span class="mono mut u-fs-12">
                                Ref: @ctx.Message.ReferenceId
                                <button class="btn btn-ghost btn-sm" @onclick="@(() => CopyToClipboard(ctx.Message.ReferenceId))">
                                    <Icon Name="Copy" />
                                </button>
                            </span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(ctx.Message.Body))
                    {
                        <div class="term" style="min-height:0;margin-bottom:16px;">@ctx.Message.Body</div>
                    }

                    @if (!string.IsNullOrEmpty(ctx.Message.ResourceType))
                    {
                        <dl class="kv u-mb-16">
                            <dt>Resource</dt>
                            <dd>
                                @ctx.Message.ResourceType
                                @if (!string.IsNullOrEmpty(ctx.Message.ResourceId))
                                {
                                    <span class="mut"> (@ctx.Message.ResourceId)</span>
                                }
                            </dd>
                        </dl>
                    }

                    @if (!string.IsNullOrEmpty(ctx.Message.ActionUrl))
                    {
                        <div class="u-mb-16">
                            <a href="@ctx.Message.ActionUrl" class="btn btn-primary">
                                <Icon Name="ExternalLink" />
                                @(ctx.Message.ActionType ?? "Take Action")
                            </a>
                        </div>
                    }

                    <div class="actions">
                        @if (ctx.Message.DismissedAt is null && ctx.Message.ArchivedAt is null)
                        {
                            <button class="btn btn-secondary btn-sm" @onclick="@(async () => { await ctx.OnDismiss(); Navigation.NavigateTo("/messages"); })">
                                <Icon Name="Close" />
                                Dismiss
                            </button>
                        }
                        @if (ctx.Message.ArchivedAt is null)
                        {
                            <button class="btn btn-secondary btn-sm" @onclick="@(async () => { await ctx.OnArchive(); Navigation.NavigateTo("/messages"); })">
                                <Icon Name="Archive" />
                                Archive
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </MessageDetailContent>
</MessageProvider>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private async Task CopyToClipboard(string? text)
    {
        if (!string.IsNullOrEmpty(text))
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text).ConfigureAwait(false);
        }
    }

    private static StatusVariantBase GetSeverityVariant(string severity) => severity switch
    {
        "Critical" => StatusVariants.Error,
        "High" => StatusVariants.Warning,
        "Normal" => StatusVariants.Neutral,
        "Low" => StatusVariants.Info,
        _ => StatusVariants.Neutral
    };
}
