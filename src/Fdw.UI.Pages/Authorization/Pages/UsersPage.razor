@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Users - Fdw</PageTitle>

<RoleProvider>
    <ChildContent Context="roleCtx">
        <UserProvider>
            <ChildContent Context="ctx">
                <div style="display:flex;flex-direction:column;gap:14px;">
                    <PageHeader Eyebrow="Admin" Title="Users" Subtitle="Manage system users and their access levels.">
                        <Actions>
                            <button @onclick="ShowCreateForm" class="btn btn-primary">
                                <Icon Name="Add" />
                                New User
                            </button>
                        </Actions>
                    </PageHeader>

                    <div class="card">
                        <div class="card-h">
                            <h3>Members</h3>
                            <div class="search" style="width:280px;margin-left:0;">
                                <Icon Name="Search" />
                                <input type="text"
                                       value="@ctx.SearchString"
                                       @oninput="e => ctx.OnSearchChanged(e.Value?.ToString() ?? string.Empty)"
                                       class="finput u-bg-transparent"
                                       style="padding:0;flex:1;"
                                       placeholder="Search users..." />
                            </div>
                        </div>

                        @if (ctx.IsLoading && !ctx.FilteredUsers.Any())
                        {
                            <LoadingCard InCard="false" />
                        }
                        else
                        {
                            <div class="card-b fdw-table-body-scroll">
                                <table class="tbl">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Status</th>
                                            <th>Roles</th>
                                            <th>Last Login</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in ctx.FilteredUsers)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="cellpad nm">
                                                        <span class="ico">
                                                            <span class="ti">@(string.IsNullOrEmpty(user.Username) ? "?" : user.Username[0].ToString().ToUpper())</span>
                                                            <span>@user.Username<small class="mut" style="display:block;">@user.Email</small></span>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="mut">
                                                    @if (user.IsActive)
                                                    {
                                                        <span class="badge b-ok"><span class="bd"></span>Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge b-fail"><span class="bd"></span>Inactive</span>
                                                    }
                                                </td>
                                                <td class="mut">
                                                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                                                        @foreach (var role in user.Roles)
                                                        {
                                                            <span class="tpill">@role</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="mut">
                                                    @(user.LastLoginAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")
                                                </td>
                                                <td class="mut">
                                                    <div class="actions u-jc-end">
                                                        <button @onclick="() => EditUser(user)" class="btn btn-ghost btn-sm">
                                                            <Icon Name="EditAlt" />
                                                        </button>
                                                        <button @onclick="() => ShowResetForm(user)" class="btn btn-ghost btn-sm" title="Reset password">
                                                            <Icon Name="Password" />
                                                        </button>
                                                        <button @onclick="() => ctx.OnDeleteUser(user.Id)" class="btn btn-ghost btn-sm">
                                                            <Icon Name="DeleteAlt" />
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    @if (_resetUser is not null)
                    {
                        <div class="card">
                            <div class="card-h">
                                <h3>Reset password &mdash; @_resetUser.Username</h3>
                                <button class="btn btn-ghost btn-sm" @onclick="CancelReset">
                                    <Icon Name="Close" />
                                </button>
                            </div>
                            <div class="card-b">
                                @if (!string.IsNullOrEmpty(_resetError))
                                {
                                    <div class="danger u-mb-16"><div class="t"><p>@_resetError</p></div></div>
                                }
                                <div class="frow">
                                    <label>New password</label>
                                    <input type="password" class="finput" @bind="_resetPassword" placeholder="Min 8 characters" />
                                </div>
                                <div class="actions u-jc-end">
                                    <button class="btn btn-secondary" @onclick="CancelReset">Cancel</button>
                                    <button class="btn btn-primary" @onclick="() => SubmitReset(ctx)" disabled="@_resetting">
                                        @(_resetting ? "Resetting..." : "Reset password")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    @if (_showForm)
                    {
                        <div class="card">
                            <div class="card-h">
                                <h3>@(_editingUser != null ? "Edit User" : "Create User")</h3>
                                <button class="btn btn-ghost btn-sm" @onclick="CancelForm">
                                    <Icon Name="Close" />
                                </button>
                            </div>
                            <div class="card-b">
                                @if (!string.IsNullOrEmpty(_formError))
                                {
                                    <div class="danger u-mb-16"><div class="t"><p>@_formError</p></div></div>
                                }

                                <div class="fgrid">
                                    <div class="frow">
                                        <label>Username</label>
                                        <input class="finput" @bind="_formUsername" disabled="@(_editingUser != null)" placeholder="Username" />
                                    </div>
                                    <div class="frow">
                                        <label>Email</label>
                                        <input class="finput" @bind="_formEmail" placeholder="Email address" />
                                    </div>
                                    @if (_editingUser == null)
                                    {
                                        <div class="frow">
                                            <label>Password</label>
                                            <input type="password" class="finput" @bind="_formPassword" placeholder="Min 8 characters" />
                                        </div>
                                    }
                                    <div class="frow full">
                                        <label>Roles</label>
                                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                                            @foreach (var role in roleCtx.Roles)
                                            {
                                                <button type="button"
                                                        class="@(_selectedRoles.Contains(role.Name) ? "chip on" : "chip")"
                                                        @onclick="() => ToggleRole(role.Name)">
                                                    @role.Name
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="frow u-mb-16">
                                    <label>Status</label>
                                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                                        <input class="u-op-0" type="checkbox" @bind="_formIsActive" style="position:absolute;" />
                                        <span class="@(_formIsActive ? "sw on" : "sw")"></span>
                                        <span class="mut">Active</span>
                                    </label>
                                </div>

                                <div class="actions u-jc-end">
                                    <button class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
                                    <button class="btn btn-primary" @onclick="() => SubmitForm(ctx)" disabled="@_submitting">
                                        @(_submitting ? "Saving..." : (_editingUser != null ? "Update" : "Create"))
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </ChildContent>
        </UserProvider>
    </ChildContent>
</RoleProvider>

@code {

    // Form state
    private bool _showForm;
    private bool _submitting;
    private string? _formError;
    private UserSummaryPayload? _editingUser;
    private string _formUsername = "";
    private string _formPassword = "";
    private string? _formEmail;
    private bool _formIsActive = true;
    private HashSet<string> _selectedRoles = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _initialRoles = [];

    private UserSummaryPayload? _resetUser;
    private string _resetPassword = "";
    private string? _resetError;
    private bool _resetting;

    private void ShowResetForm(UserSummaryPayload user)
    {
        _resetUser = user;
        _resetPassword = "";
        _resetError = null;
    }

    private void CancelReset()
    {
        _resetUser = null;
        _resetError = null;
    }

    private async Task SubmitReset(UserContext ctx)
    {
        // Why: mirrors the create-form rule. The server-side validator is the authority; this only
        // saves a round-trip on the obvious case.
        if (string.IsNullOrWhiteSpace(_resetPassword) || _resetPassword.Length < 8)
        {
            _resetError = "Password must be at least 8 characters";
            return;
        }

        _resetError = null;
        _resetting = true;
        try
        {
            if (await ctx.OnResetPassword(_resetUser!.Id, _resetPassword))
                _resetUser = null;
            else
                _resetError = ctx.LastResult?.CurrentMessage ?? "Failed to reset password";
        }
        finally
        {
            _resetting = false;
        }
    }

    private void ShowCreateForm()
    {
        _editingUser = null;
        _formUsername = "";
        _formPassword = "";
        _formEmail = null;
        _formIsActive = true;
        _selectedRoles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _initialRoles = [];
        _formError = null;
        _showForm = true;
    }

    private void EditUser(UserSummaryPayload user)
    {
        _editingUser = user;
        _formUsername = user.Username;
        _formPassword = "";
        _formEmail = user.Email;
        _formIsActive = user.IsActive;
        _initialRoles = user.Roles.ToList();
        _selectedRoles = new HashSet<string>(user.Roles, StringComparer.OrdinalIgnoreCase);
        _formError = null;
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
        _editingUser = null;
        _formError = null;
    }

    private void ToggleRole(string roleName)
    {
        if (!_selectedRoles.Remove(roleName))
        {
            _selectedRoles.Add(roleName);
        }
    }

    private async Task SubmitForm(UserContext ctx)
    {
        _formError = null;
        _submitting = true;

        try
        {
            if (_editingUser != null)
            {
                var request = new UpdateUserPayload { Email = _formEmail, IsActive = _formIsActive };
                var success = await ctx.OnUpdateUser(_editingUser.Id, request, _selectedRoles, _initialRoles);
                if (success)
                {
                    _showForm = false;
                    _editingUser = null;
                    await ctx.OnLoadUsers();
                }
                else
                {
                    _formError = ctx.ErrorMessage ?? "Failed to update user";
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_formUsername) || _formUsername.Length < 3)
                {
                    _formError = "Username must be at least 3 characters";
                    return;
                }
                if (string.IsNullOrWhiteSpace(_formPassword) || _formPassword.Length < 8)
                {
                    _formError = "Password must be at least 8 characters";
                    return;
                }

                var request = new CreateUserRequest
                {
                    Username = _formUsername,
                    Password = _formPassword,
                    Email = _formEmail,
                    Roles = _selectedRoles.ToList()
                };
                var response = await ctx.OnCreateUser(request);
                if (response is not null)
                {
                    _showForm = false;
                    await ctx.OnLoadUsers();
                }
                else
                {
                    _formError = ctx.ErrorMessage ?? "Failed to create user";
                }
            }
        }
        finally
        {
            _submitting = false;
        }
    }

}
