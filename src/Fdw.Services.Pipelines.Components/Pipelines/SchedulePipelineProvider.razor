@namespace Fdw.Services.Pipelines.Components.Pipelines
@using Fdw.UI.Providers
@using Fdw.Results
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Services.Pipelines.Clients.Abstractions
@using Fdw.Services.Pipelines.Components.Logging

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    /// <summary>
    /// Headless provider for loading pipeline summaries used in schedule creation/editing.
    /// Provides the list of available pipelines that can be scheduled.
    /// </summary>
    [Parameter] public RenderFragment<SchedulePipelineContext>? ChildContent { get; set; }

    [Inject] private IPipelineClient PipelineApi { get; set; } = default!;
    [Inject] private ILogger<SchedulePipelineProvider>? LoggerParam { get; set; }

    private ILogger<SchedulePipelineProvider> _logger = NullLogger<SchedulePipelineProvider>.Instance;

    // ── State ───────────────────────────────────────────────────────────────────

    private IReadOnlyList<PipelineSummaryResponse> _pipelines = [];
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private SchedulePipelineContext _context = new();
    private bool _initialized;

    // ── Lifecycle ───────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _logger = LoggerParam ?? NullLogger<SchedulePipelineProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadPipelines();
        }
    }

    // ── Public Methods ──────────────────────────────────────────────────────────

    public async Task LoadPipelines(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        SchedulePipelineProviderLog.LoadingPipelines(_logger);

        try
        {
            var result = await PipelineApi.List(cancellationToken);
            if (!result.IsSuccess)
            {
                SchedulePipelineProviderLog.LoadPipelinesFailed(_logger);
                _lastResult = result;
                _pipelines = [];
                return;
            }

            _pipelines = result.Value?.ToList() ?? [];
            SchedulePipelineProviderLog.LoadedPipelines(_logger, _pipelines.Count);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(SchedulePipelineProviderLog.LoadPipelinesException(_logger, ex));
            _pipelines = [];
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Private Helpers ─────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new SchedulePipelineContext
        {
            Pipelines = _pipelines,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnLoadPipelines = () => LoadPipelines()
        };
    }
}
