@namespace Fdw.Operations.Components.Dataflow
@using Fdw.UI.Providers
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Threading
@using System.Threading.Tasks
@using System.Collections.Generic
@using System.Linq
@using Fdw.Operations.Clients
@using Fdw.Operations.Clients.Models
@using Fdw.Results
@using Fdw.UI.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    [Parameter] public RenderFragment<DataflowContext>? ChildContent { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private DataflowApiClient? _dataflowApi;
    [Inject] private ILogger<DataflowProvider>? LoggerParam { get; set; }

    private ILogger<DataflowProvider> _logger = NullLogger<DataflowProvider>.Instance;

    // ── State ──────────────────────────────────────────────────────────────────

    private DataflowGraphPayload? _graph;
    private DataSetLineagePayload? _currentLineage;
    private ImpactAnalysisPayload? _lastImpactAnalysis;
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private DataflowContext _context = new();
    private bool _initialized;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _dataflowApi = new DataflowApiClient(HttpClientFactory.CreateClient("DataflowClient"), LoggerFactory?.CreateLogger<DataflowApiClient>()!);
        _logger = LoggerParam ?? NullLogger<DataflowProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadGraph();
        }
    }

    // ── Methods (exposed as callbacks via DataflowContext) ──────────────────

    private async Task LoadGraph(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _dataflowApi!.GetGraph(cancellationToken);
            if (result.IsSuccess)
            {
                _graph = result.Value;
            }
            else
            {
                UiProviderLog.LoadFailed(_logger, "DataflowProvider", "dataflow graph");
                _lastResult = result;
                _graph = null;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.LoadException(_logger, ex, "DataflowProvider", "dataflow graph"));
            _graph = null;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task LoadLineage(string datasetName, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var lineageResult = await _dataflowApi!.GetLineage(datasetName, cancellationToken);
            if (lineageResult.IsSuccess)
            {
                _currentLineage = lineageResult.Value;
            }
            else
            {
                UiProviderLog.DetailLoadFailed(_logger, "DataflowProvider", "lineage", datasetName);
                _lastResult = lineageResult;
                _currentLineage = null;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.LoadException(_logger, ex, "DataflowProvider", "lineage"));
            _currentLineage = null;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task AnalyzeImpact(string targetType, string targetName, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var impactResult = await _dataflowApi!.AnalyzeImpact(targetType, targetName, cancellationToken);
            if (impactResult.IsSuccess)
            {
                _lastImpactAnalysis = impactResult.Value;
            }
            else
            {
                UiProviderLog.OperationFailed(_logger, "DataflowProvider", "impact analysis");
                _lastResult = impactResult;
                _lastImpactAnalysis = null;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.OperationException(_logger, ex, "DataflowProvider", "impact analysis"));
            _lastImpactAnalysis = null;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new DataflowContext
        {
            Graph = _graph,
            CurrentLineage = _currentLineage,
            LastImpactAnalysis = _lastImpactAnalysis,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnLoadGraph = () => LoadGraph(),
            OnLoadLineage = datasetName => LoadLineage(datasetName),
            OnAnalyzeImpact = (targetType, targetName) => AnalyzeImpact(targetType, targetName)
        };
    }
}
