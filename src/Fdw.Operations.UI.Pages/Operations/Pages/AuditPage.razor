@page "/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Execution History - Cyberdyne</PageTitle>

<AuditProvider Context="ctx">
    <PageHeader Eyebrow="Operations" Title="Execution History" Subtitle="Workflow, job, stage, step and task executions.">
        <Actions>
            <button class="btn btn-secondary" @onclick="async () => await ctx.OnRefresh()" disabled="@ctx.IsLoading">
                <Icon Name="RefreshAlt" />
                Refresh
            </button>
        </Actions>
    </PageHeader>

    <div class="card u-mb-14">
        <div class="card-h"><h3>Filters</h3></div>
        <div class="card-b">
            <div class="fgrid" style="grid-template-columns:repeat(3,1fr);align-items:end;">
                <div class="frow">
                    <label>State</label>
                    <select class="finput" @bind="ctx.FilterState">
                        <option value="">All States</option>
                        <option value="Running">Running</option>
                        @* Why: the friendly label is "Succeeded" but the domain ExecutionState is "Completed"
                           (ExecutionStateTypes has no "Succeeded"); the option VALUE must carry the real state
                           name so the server filter resolves it instead of silently dropping an unknown state. *@
                        <option value="Completed">Succeeded</option>
                        <option value="Failed">Failed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="frow">
                    <label>Item Type</label>
                    <select class="finput" @bind="ctx.FilterItemType">
                        <option value="">All Types</option>
                        <option value="Workflow">Workflow</option>
                        <option value="Job">Job</option>
                        <option value="Stage">Stage</option>
                        <option value="Step">Step</option>
                        <option value="Task">Task</option>
                    </select>
                </div>
                <div class="frow">
                    <button class="btn btn-secondary" @onclick="async () => await ctx.OnFilterChanged(ctx.FilterItemType, ctx.FilterState)">Apply Filters</button>
                </div>
            </div>
        </div>
    </div>

    @if (ctx.IsLoading)
    {
        <EmptyState><p class="mut u-fg-n500">Loading execution history&hellip;</p></EmptyState>
    }
    else if (ctx.Entries.Count == 0)
    {
        <div class="card">
            <EmptyState InCard="false">
                <p class="u-fg-n300">No execution history found</p>
                <p class="sub u-mt-6">Executions will appear here once pipelines run</p>
            </EmptyState>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-h"><h3>Executions</h3><span class="meta">@ctx.Entries.Count / @ctx.TotalCount</span></div>
            <div class="card-b fdw-table-body">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>Started</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>State</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in ctx.Entries)
                        {
                            <tr>
                                <td class="num"><div class="cellpad">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div></td>
                                <td class="nm">@entry.Name</td>
                                <td class="mut"><span class="tpill">@entry.ItemType</span></td>
                                <td class="mut">
                                    <Badge Variant="GetStateVariant(entry.State)">@entry.State</Badge>
                                </td>
                                <td class="num">
                                    @(entry.CompletedAt.HasValue
                                        ? (entry.CompletedAt.Value - entry.CreatedAt).ToString(@"hh\:mm\:ss")
                                        : (DateTimeOffset.Now - entry.CreatedAt).ToString(@"hh\:mm\:ss"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</AuditProvider>

@code {
    private static StatusVariantBase GetStateVariant(string state) => state switch
    {
        "Succeeded" or "Completed" => StatusVariants.Success,
        "Failed" => StatusVariants.Error,
        "Running" => StatusVariants.Info,
        "Cancelled" => StatusVariants.Warning,
        _ => StatusVariants.Neutral
    };
}
