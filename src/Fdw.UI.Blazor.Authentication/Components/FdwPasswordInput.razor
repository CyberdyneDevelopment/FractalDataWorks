@using Fdw.UI.Blazor.Authentication.Validation

<input type="@(_showPassword ? "text" : "password")"
       value="@Value"
       @oninput="HandleInput"
       class="@CssClass"
       placeholder="@Placeholder"
       autocomplete="@Autocomplete" />

@if (ShowToggle)
{
    <span @onclick="ToggleVisibility" style="cursor: pointer;">
        @if (ToggleContent is not null)
        {
            @ToggleContent(_showPassword)
        }
    </span>
}

@if (Rules is not null && _validationResult is not null && ShowValidation)
{
    @if (ValidationContent is not null)
    {
        @ValidationContent(_validationResult)
    }
}
