@namespace Fdw.UI.Components
@using Fdw.UI.Components.Icons
<div class="metric">
    <div class="mt">
        <span class="lbl">@Title</span>
        <span class="ic @GetIconColor()">
@* Why StrokeWidth is explicit here: the markup this replaced carried stroke-width="1.7" on the
   <svg> itself, which its paths inherited. The glyphs are registered with no stroke-width so
   other call sites can inherit from CSS, so without this the 1.7 would only survive because
   console.css happens to set the same value on .metric .mt .ic svg — correct on the reference
   skin, silently 1 on any other host. Equivalence should not depend on the skin. *@
            <Icon Name="@GetIconName()" StrokeWidth="1.7" />
        </span>
    </div>
    <div class="row">
        <span class="val">@Value</span>
        @* Why: only show a trend when a real one is supplied; never fabricate a delta. *@
        @if (!string.IsNullOrEmpty(Trend))
        {
            <span class="trend @(TrendUp ? "up" : "down")">@Trend</span>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Icon { get; set; } = "workflow";
    [Parameter] public string Color { get; set; } = "red";
    [Parameter] public string? Trend { get; set; }
    [Parameter] public bool TrendUp { get; set; } = true;

    private string GetIconColor() => Color switch
    {
        "green" => "ic-green",
        "cyan" => "ic-glacier",
        "yellow" => "ic-warn",
        "red" => "ic-amber",
        _ => "ic-violet"
    };

    private string GetIconName() => Color switch
    {
        "red" => "Bolt",
        "cyan" => "Database",
        "yellow" => "Clock",
        "green" => "BookOpenHalf",
        _ => "Bolt"
    };
}
