@namespace Fdw.UI.Components
<div class="metric">
    <div class="mt">
        <span class="lbl">@Title</span>
        <span class="ic @GetIconColor()">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                @GetIconPath()
            </svg>
        </span>
    </div>
    <div class="row">
        <span class="val">@Value</span>
        @* Why: only show a trend when a real one is supplied; never fabricate a delta. *@
        @if (!string.IsNullOrEmpty(Trend))
        {
            <span class="trend @(TrendUp ? "up" : "down")">@Trend</span>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Icon { get; set; } = "workflow";
    [Parameter] public string Color { get; set; } = "red";
    [Parameter] public string? Trend { get; set; }
    [Parameter] public bool TrendUp { get; set; } = true;

    private string GetIconColor() => Color switch
    {
        "green" => "ic-green",
        "cyan" => "ic-glacier",
        "yellow" => "ic-warn",
        "red" => "ic-amber",
        _ => "ic-violet"
    };

    private MarkupString GetIconPath() => Color switch
    {
        "red" => new("<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 10V3L4 14h7v7l9-11h-7z\" />"),
        "cyan" => new("<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4\" />"),
        "yellow" => new("<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\" />"),
        "green" => new("<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253\" />"),
        _ => new("<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 10V3L4 14h7v7l9-11h-7z\" />")
    };
}
