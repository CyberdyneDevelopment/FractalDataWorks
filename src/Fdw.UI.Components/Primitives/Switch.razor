<div class="frow u-mb-0">
    <label class="u-tt-none u-ls-normal u-fs-13" style="display:flex;align-items:center;gap:10px;cursor:@(ReadOnly ? "default" : "pointer");font-family:var(--font);color:var(--n-300);">
        <input class="u-op-0"
            type="checkbox"
            style="position:absolute;width:0;height:0;"
            checked="@Value"
            disabled="@ReadOnly"
            @onchange="HandleChange" />

        <span class="sw @(Value ? "on" : "")"></span>

        @if (!string.IsNullOrEmpty(Label))
        {
            <span>@Label</span>
        }
    </label>

    @if (!string.IsNullOrEmpty(HelpText))
    {
        <small class="hint">@HelpText</small>
    }
</div>
