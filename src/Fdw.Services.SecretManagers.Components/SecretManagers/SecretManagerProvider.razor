@namespace Fdw.Services.SecretManagers.Components.SecretManagers
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Services.SecretManagers.Clients
@using Fdw.Services.SecretManagers.Clients.Models
@using Fdw.Results
@using Fdw.Services.SecretManagers.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    /// <summary>
    /// Headless provider for secret manager CRUD operations: list, select, create, update, delete.
    /// </summary>
    [Parameter] public RenderFragment<SecretManagerContext>? ChildContent { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private SecretManagerApiClient? _secretManagerApi;
    [Inject] private ILogger<SecretManagerProvider>? LoggerParam { get; set; }

    private ILogger<SecretManagerProvider> _logger = NullLogger<SecretManagerProvider>.Instance;

    // ── State ──────────────────────────────────────────────────────────────────

    private IReadOnlyList<SecretManagerSummaryPayload> _secretManagers = [];
    private IReadOnlyList<SecretManagerTypeSummaryPayload> _availableTypes = [];
    private SecretManagerDetailPayload? _selectedManager;
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private SecretManagerContext _context = new();
    private bool _initialized;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _secretManagerApi = new SecretManagerApiClient(HttpClientFactory.CreateClient("SecretManagerClient"), LoggerFactory?.CreateLogger<SecretManagerApiClient>()!);
        _logger = LoggerParam ?? NullLogger<SecretManagerProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadAvailableTypes();
            await LoadSecretManagers();
        }
    }

    private async Task LoadAvailableTypes(CancellationToken cancellationToken = default)
    {
        try
        {
            var result = await _secretManagerApi!.GetSecretManagerTypes(cancellationToken);
            _availableTypes = result.IsSuccess ? (result.Value?.ToList() ?? []) : [];
        }
        catch (OperationCanceledException)
        {
            _availableTypes = [];
        }
        catch
        {
            _availableTypes = [];
        }
    }

    // ── Private Operations ─────────────────────────────────────────────────────

    private async Task<IGenericResult> LoadSecretManagers(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        SecretManagerProviderLog.LoadingSecretManagers(_logger);

        try
        {
            var result = await _secretManagerApi!.GetSecretManagers(cancellationToken);
            if (!result.IsSuccess)
            {
                SecretManagerProviderLog.LoadSecretManagersFailed(_logger);
                _lastResult = result;
                _secretManagers = [];
                return result;
            }

            _secretManagers = result.Value?.ToList() ?? [];
            SecretManagerProviderLog.LoadedSecretManagers(_logger, _secretManagers.Count);
            return result;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { SecretManagerProviderLog.LoadSecretManagersFailed(_logger) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            _secretManagers = [];
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<IGenericResult> HandleSelect(string name, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        SecretManagerProviderLog.LoadingSecretManager(_logger, name);

        try
        {
            var result = await _secretManagerApi!.GetSecretManager(name, cancellationToken);
            if (!result.IsSuccess || result.Value is null)
            {
                SecretManagerProviderLog.LoadSecretManagerFailed(_logger, name);
                _lastResult = result;
                _selectedManager = null;
                return result;
            }

            _selectedManager = result.Value;
            SecretManagerProviderLog.LoadedSecretManager(_logger, name);
            return result;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { SecretManagerProviderLog.LoadSecretManagerFailed(_logger, name) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            _selectedManager = null;
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<IGenericResult> HandleCreate(CreateSecretManagerPayload request, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        SecretManagerProviderLog.CreatingSecretManager(_logger, request.Name);

        try
        {
            var result = await _secretManagerApi!.CreateSecretManager(request, cancellationToken);
            if (!result.IsSuccess)
            {
                SecretManagerProviderLog.CreateSecretManagerFailed(_logger, request.Name);
                _lastResult = result;
                return result;
            }

            SecretManagerProviderLog.SecretManagerCreated(_logger, request.Name);
            await LoadSecretManagers(cancellationToken);
            return result;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { SecretManagerProviderLog.CreateSecretManagerFailed(_logger, request.Name) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<IGenericResult> HandleUpdate(string name, UpdateSecretManagerPayload request, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        SecretManagerProviderLog.UpdatingSecretManager(_logger, name);

        try
        {
            var result = await _secretManagerApi!.UpdateSecretManager(name, request, cancellationToken);
            if (!result.IsSuccess)
            {
                SecretManagerProviderLog.UpdateSecretManagerFailed(_logger, name);
                _lastResult = result;
                return result;
            }

            SecretManagerProviderLog.SecretManagerUpdated(_logger, name);
            await LoadSecretManagers(cancellationToken);
            return result;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { SecretManagerProviderLog.UpdateSecretManagerFailed(_logger, name) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<IGenericResult> HandleDelete(string name, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        SecretManagerProviderLog.DeletingSecretManager(_logger, name);

        try
        {
            var result = await _secretManagerApi!.DeleteSecretManager(name, cancellationToken);
            if (!result.IsSuccess)
            {
                SecretManagerProviderLog.DeleteSecretManagerFailed(_logger, name);
                _lastResult = result;
                return result;
            }

            SecretManagerProviderLog.SecretManagerDeleted(_logger, name);

            if (_selectedManager is not null &&
                string.Equals(_selectedManager.Name, name, StringComparison.Ordinal))
            {
                _selectedManager = null;
            }

            await LoadSecretManagers(cancellationToken);
            return result;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { SecretManagerProviderLog.DeleteSecretManagerFailed(_logger, name) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new SecretManagerContext
        {
            SecretManagers = _secretManagers,
            AvailableTypes = _availableTypes,
            SelectedManager = _selectedManager,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnRefresh = () => LoadSecretManagers(),
            OnCreate = request => HandleCreate(request),
            OnUpdate = (name, request) => HandleUpdate(name, request),
            OnDelete = name => HandleDelete(name),
            OnSelect = name => HandleSelect(name)
        };
    }
}
