<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fdw.Data.DataStores.Rest</RootNamespace>
    <AssemblyName>Fdw.Data.DataStores.Rest</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn> <!-- Suppress missing XML comments temporarily -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Configuration.Abstractions\Fdw.Configuration.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\Fdw.Messages\Fdw.Messages.csproj" />
    <ProjectReference Include="..\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Data.DataContainers.Abstractions\Fdw.Data.DataContainers.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Data.Builders\Fdw.Data.Builders.csproj" />
    <ProjectReference Include="..\Fdw.Collections\Fdw.Collections.csproj" />

    <!-- Source Generators -->
    <ProjectReference Include="..\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Data.Importers.Abstractions\Fdw.Data.Importers.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Data.JsonSchema\Fdw.Data.JsonSchema.csproj" />
    <ProjectReference Include="..\Fdw.Services.Connections\Fdw.Services.Connections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schema Importers -->
    <PackageReference Include="Microsoft.OpenApi.Readers" />
    <PackageReference Include="Microsoft.OData.Edm" />
  </ItemGroup>
</Project>
