<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Fdw.TUI.Management</RootNamespace>

    <!-- Package Information -->
    <PackageId>Fdw.TUI.Management</PackageId>
    <Title>Fdw TUI Management</Title>
    <Description>Console-based management application for Fdw. Provides configuration management, monitoring, and log viewing via terminal UI.</Description>
    <Authors>Fdw</Authors>
    <Copyright>Copyright © Fdw</Copyright>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.UI.Rendering.Spectre\Fdw.UI.Rendering.Spectre.csproj" />
    <ProjectReference Include="..\Fdw.UI.Components\Fdw.UI.Components.csproj" />
    <ProjectReference Include="..\Fdw.UI.Themes\Fdw.UI.Themes.csproj" />
    <ProjectReference Include="..\Fdw.Configuration.Abstractions\Fdw.Configuration.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Collections\Fdw.Collections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fdw.Web.Clients\Fdw.Web.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Connections.Clients\Fdw.Services.Connections.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Web.Http.Authentication\Fdw.Web.Http.Authentication.csproj" />
    <ProjectReference Include="..\Fdw.Services.Registration\Fdw.Services.Registration.csproj" />
    <ProjectReference Include="..\Fdw.Registration.SourceGenerators\Fdw.Registration.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fdw.Services.Registration.SourceGenerators\Fdw.Services.Registration.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fdw.Services.Data.Clients\Fdw.Services.Data.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Pipelines.Clients\Fdw.Services.Pipelines.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.SecretManagers.Clients\Fdw.Services.SecretManagers.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Notifications.Clients\Fdw.Services.Notifications.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Scheduling.Clients\Fdw.Services.Scheduling.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Users.Clients\Fdw.Services.Users.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Authorization.Clients\Fdw.Services.Authorization.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Settings.Clients\Fdw.Services.Settings.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Multitenancy.Clients\Fdw.Services.Multitenancy.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Quality.Clients\Fdw.Services.Quality.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Etl.Projects.Clients\Fdw.Services.Etl.Projects.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\Fdw.Messages\Fdw.Messages.csproj" />
    <ProjectReference Include="..\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
  </ItemGroup>

</Project>
