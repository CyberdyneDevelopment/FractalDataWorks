<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Fdw.Configuration.Endpoints</RootNamespace>

    <!-- NuGet Package Properties -->
    <PackageId>Fdw.Configuration.Endpoints</PackageId>
    <Title>Fdw.Configuration.Endpoints</Title>
    <Description>Generic endpoint base classes and DTOs for managing configuration instances via FastEndpoints.</Description>
    <Authors>Fdw</Authors>
    <PackageTags>fdw;endpoints;configuration;api;fastendpoints</PackageTags>
