<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <DefineConstants>$(DefineConstants);ROSLYN4_0_OR_GREATER</DefineConstants>
    <!-- Suppress XML documentation warnings for internal generator implementation files (forked from Microsoft.Extensions.Logging) -->
    <NoWarn>$(NoWarn);CS1591;NU5128;NU5118</NoWarn>
    <!-- Source generators have inherent Roslyn complexity -->
    <FDW_MaxMethodLines>500</FDW_MaxMethodLines>
    <FDW_MaxCyclomaticComplexity>200</FDW_MaxCyclomaticComplexity>

    <!-- Source Generator Specific -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- Package Properties -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageDescription>Source generator for logging methods that return IGenericMessage. Fork of Microsoft.Extensions.Logging generators with extended return type support.</PackageDescription>
    <PackageTags>logging;messages;source-generator;roslyn;logger-message</PackageTags>

    <!-- Suppress warnings for analyzer-only packages -->
    <NoWarn>$(NoWarn);NU5128;NU5118</NoWarn>

    <!-- Resource Generation -->
    <GenerateResxSource>true</GenerateResxSource>
    <GenerateResxSourceEmitFormatMethods>true</GenerateResxSourceEmitFormatMethods>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <!-- Generator Debugging -->
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)g</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fdw.MessageLogging.SourceGenerators.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Bcl.HashCode" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include resource files -->
    <EmbeddedResource Include="Resources\Strings.resx">
      <LogicalName>Fdw.MessageLogging.Generators.Strings.resources</LogicalName>
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Package generator DLL in analyzers folder -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\$(AssemblyName).props" Pack="true" PackagePath="build\" Visible="false" Condition="Exists('build\$(AssemblyName).props')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fdw.Abstractions\Fdw.Abstractions.csproj" />
  </ItemGroup>

</Project>
