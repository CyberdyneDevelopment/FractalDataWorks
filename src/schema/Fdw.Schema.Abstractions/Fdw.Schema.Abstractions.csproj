<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Information -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Fdw.Schema.Abstractions</PackageId>
    <Authors>Fdw</Authors>
    <Description>Schema abstractions for Fdw including PropertyRole type system</Description>
    <PackageTags>schema;metadata;property;role;typecollection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\foundation\collections\Fdw.Collections\Fdw.Collections.csproj" />
    <ProjectReference Include="..\..\foundation\collections\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\foundation\abstractions\Fdw.Types.Abstractions\Fdw.Types.Abstractions.csproj" />
  </ItemGroup>
</Project>
