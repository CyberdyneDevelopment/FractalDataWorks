@namespace Fdw.UI.Themes.Components.Themes
@using Fdw.UI.Providers
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Threading
@using System.Threading.Tasks
@using System.Collections.Generic
@using System.Linq
@using Fdw.UI.Themes.Clients.ApiClients
@using Fdw.UI.Themes.Clients.Models
@using Fdw.Results
@using Fdw.UI.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    [Parameter] public RenderFragment<ThemeContext>? ChildContent { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private ThemeApiClient? _themeApi;
    [Inject] private ILogger<ThemeProvider>? LoggerParam { get; set; }

    private ILogger<ThemeProvider> _logger = NullLogger<ThemeProvider>.Instance;

    // ── State ──────────────────────────────────────────────────────────────────

    private IReadOnlyList<ThemeSummaryPayload> _themes = [];
    private ThemeConfiguration? _currentTheme;
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private ThemeContext _context = new();
    private bool _initialized;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _themeApi = new ThemeApiClient(HttpClientFactory.CreateClient("ThemeClient"), LoggerFactory?.CreateLogger<ThemeApiClient>()!);
        _logger = LoggerParam ?? NullLogger<ThemeProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadThemes();
        }
    }

    // ── Methods (exposed as callbacks via ThemeContext) ─────────────────────

    private async Task LoadThemes(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _themeApi!.GetThemes(cancellationToken);
            if (result.IsSuccess)
            {
                _themes = result.Value?.ToList() ?? [];
            }
            else
            {
                UiProviderLog.LoadFailed(_logger, "ThemeProvider", "themes");
                _lastResult = result;
                _themes = [];
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.LoadException(_logger, ex, "ThemeProvider", "themes"));
            _themes = [];
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task LoadDefaultTheme(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _themeApi!.GetDefaultTheme(cancellationToken);
            if (result.IsSuccess)
            {
                _currentTheme = result.Value;
            }
            else
            {
                UiProviderLog.DetailLoadFailed(_logger, "ThemeProvider", "theme", "default");
                _lastResult = result;
                _currentTheme = null;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.LoadException(_logger, ex, "ThemeProvider", "theme"));
            _currentTheme = null;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<bool> SetDefaultTheme(string name, CancellationToken cancellationToken = default)
    {
        try
        {
            var result = await _themeApi!.SetDefaultTheme(name, cancellationToken);
            if (result.IsSuccess)
            {
                await LoadThemes(cancellationToken);
                await LoadDefaultTheme(cancellationToken);
            }
            return result.IsSuccess;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.OperationException(_logger, ex, "ThemeProvider", "set default theme"));
            RebuildContext();
            StateHasChanged();
            return false;
        }
    }

    private async Task<bool> DeleteTheme(string name, CancellationToken cancellationToken = default)
    {
        try
        {
            var result = await _themeApi!.DeleteTheme(name, cancellationToken);
            if (result.IsSuccess)
            {
                _themes = _themes.Where(t => t.Name != name).ToList();
                RebuildContext();
                StateHasChanged();
            }
            return result.IsSuccess;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.DeleteException(_logger, ex, "ThemeProvider", "theme"));
            RebuildContext();
            StateHasChanged();
            return false;
        }
    }

    private async Task<ThemeConfiguration?> GetTheme(string name, CancellationToken cancellationToken = default)
    {
        try
        {
            var result = await _themeApi!.GetTheme(name, cancellationToken);
            if (result.IsSuccess)
            {
                return result.Value;
            }

            _lastResult = GenericResult.Failure(UiProviderLog.DetailLoadFailed(_logger, "ThemeProvider", "theme", name));
            RebuildContext();
            StateHasChanged();
            return default;
        }
        catch (OperationCanceledException)
        {
            return default;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.LoadException(_logger, ex, "ThemeProvider", "theme"));
            RebuildContext();
            StateHasChanged();
            return default;
        }
    }

    private async Task<ThemeConfiguration?> CreateTheme(CreateThemeRequest request, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _themeApi!.CreateTheme(request, cancellationToken);
            if (result.IsSuccess)
            {
                await LoadThemes(cancellationToken);
                return result.Value;
            }

            _lastResult = GenericResult.Failure(UiProviderLog.CreateFailed(_logger, "ThemeProvider", "theme"));
            return default;
        }
        catch (OperationCanceledException)
        {
            return default;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.CreateException(_logger, ex, "ThemeProvider", "theme"));
            return default;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task<ThemeConfiguration?> UpdateTheme(string name, UpdateThemeRequest request, CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var result = await _themeApi!.UpdateTheme(name, request, cancellationToken);
            if (result.IsSuccess)
            {
                await LoadThemes(cancellationToken);
                return result.Value;
            }

            _lastResult = GenericResult.Failure(UiProviderLog.UpdateFailed(_logger, "ThemeProvider", "theme", name));
            return default;
        }
        catch (OperationCanceledException)
        {
            return default;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(UiProviderLog.UpdateException(_logger, ex, "ThemeProvider", "theme"));
            return default;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new ThemeContext
        {
            Themes = _themes,
            CurrentTheme = _currentTheme,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnLoadThemes = () => LoadThemes(),
            OnLoadDefaultTheme = () => LoadDefaultTheme(),
            OnSetDefaultTheme = name => SetDefaultTheme(name),
            OnDeleteTheme = name => DeleteTheme(name),
            OnGetTheme = name => GetTheme(name),
            OnCreateTheme = request => CreateTheme(request),
            OnUpdateTheme = (name, request) => UpdateTheme(name, request)
        };
    }
}
