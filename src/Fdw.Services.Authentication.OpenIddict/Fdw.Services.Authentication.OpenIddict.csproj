<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fdw.Services.Authentication.OpenIddict</RootNamespace>

    <Title>Fdw OpenIddict Authentication Service</Title>
    <Description>DataGateway-backed OpenIddict stores and hosting extensions for Fdw OAuth2/OIDC authority.</Description>
    <PackageTags>authentication;oauth2;openiddict;openid;authorization</PackageTags>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Why: DynamicProxyGenAssembly2 allows Moq to create mocks of internal types in unit tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" PublicKey="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\Fdw.Commands.Data\Fdw.Commands.Data.csproj" />
    <ProjectReference Include="..\Fdw.Commands.Data.Fluency\Fdw.Commands.Data.Fluency.csproj" />
    <ProjectReference Include="..\Fdw.Services.Data.Abstractions\Fdw.Services.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />

    <!-- Auth seam + ServiceType machinery -->
    <ProjectReference Include="..\Fdw.Services.Authentication\Fdw.Services.Authentication.csproj" />
    <ProjectReference Include="..\Fdw.Services.Authentication.Abstractions\Fdw.Services.Authentication.Abstractions.csproj" />

    <!-- Permission + org resolution for claim baking -->
    <ProjectReference Include="..\Fdw.Services.Authorization.Abstractions\Fdw.Services.Authorization.Abstractions.csproj" />
    <!-- Why: DefaultPrincipalResolver (core Authentication package) needs UserRoleConfigurationProvider and
         RoleConfigurationProvider (concrete providers), which this project registers in DI, to load user role
         assignments and resolve role names for JWT "roles" claim baking. -->
    <ProjectReference Include="..\Fdw.Services.Authorization\Fdw.Services.Authorization.csproj" />
    <ProjectReference Include="..\Fdw.Services.Multitenancy.Abstractions\Fdw.Services.Multitenancy.Abstractions.csproj" />

    <!-- Secret manager for signing key loading -->
    <ProjectReference Include="..\Fdw.Services.SecretManagers.Abstractions\Fdw.Services.SecretManagers.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Services.SecretManagers\Fdw.Services.SecretManagers.csproj" />

    <!-- User credential validation for password/agent_key grants -->
    <ProjectReference Include="..\Fdw.Services.Users.Abstractions\Fdw.Services.Users.Abstractions.csproj" />

    <ProjectReference Include="..\Fdw.Data.SourceGenerators\Fdw.Data.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Why: Collections.SourceGenerators processes [TypeOption] attributes and generates module initializers
         that register POCO mappers with PocoMapperCollection at runtime. Without this, the mapper classes
         exist but are never registered and PocoMapperCollection.ByName returns NotFound. -->
    <ProjectReference Include="..\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Why: ConfigurationSourceGenerators generates [ManagedConfiguration] + [GenerateMapper]-needed
         DDL artifacts and the ManagedConfigurationAttribute itself (internal per-assembly) for
         OpenIddictAuthenticationConfiguration, exactly as it does for MsSqlConnectionConfiguration. -->
    <ProjectReference Include="..\Fdw.Configuration.SourceGenerators\Fdw.Configuration.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.Services.TokenManagers\Fdw.Services.TokenManagers.csproj" />
    <ProjectReference Include="..\Fdw.Services.TokenManagers.Abstractions\Fdw.Services.TokenManagers.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Services.ExternalIdentityProviders\Fdw.Services.ExternalIdentityProviders.csproj" />
    <ProjectReference Include="..\Fdw.Services.ExternalIdentityProviders.Abstractions\Fdw.Services.ExternalIdentityProviders.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why: FrameworkReference provides all ASP.NET Core APIs without bundling them in the output. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why: ConnectTokenEndpoint is a FastEndpoints endpoint (the FDW way) — not an MVC controller —
         so the OpenIddict assembly is never registered as an MVC ApplicationPart, which would pollute
         the shared ApplicationPartManager that FastEndpoints scans. Version pinned centrally to match
         the sibling Fdw.Services.Authentication.Endpoints package. -->
    <PackageReference Include="FastEndpoints" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenIddict 7.5.0: Apache-2.0, OpenID-certified -->
    <PackageReference Include="OpenIddict.Abstractions" />
    <PackageReference Include="OpenIddict.Core" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" />
    <PackageReference Include="OpenIddict.Validation.SystemNetHttp" />
  </ItemGroup>

</Project>
