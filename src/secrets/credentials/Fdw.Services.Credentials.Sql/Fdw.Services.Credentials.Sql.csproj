<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fdw.Services.Credentials.Sql</RootNamespace>

    <!-- Why: Services.Connections.MsSql grants IVT to this assembly (for CreatePooledConnection).
         Both assemblies reference Configuration.SourceGenerators which emits an internal
         ManagedConfigurationAttribute. IVT makes the MsSql-emitted copy visible here, causing CS0436.
         The compiler already picks the locally-generated copy (correct behavior); the warning is
         spurious. Suppressed at this project level only — not globally. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>

    <!-- Package properties -->
    <PackageId>Fdw.Services.Credentials.Sql</PackageId>
    <Description>SQL Server-backed credential service (vault-backed PAT and agent key) for Fdw.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fdw Core (ProjectReferences to local projects) -->
    <ProjectReference Include="..\..\..\foundation\abstractions\Fdw.Abstractions\Fdw.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\foundation\results\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\..\..\foundation\messagelogging\Fdw.Messages\Fdw.Messages.csproj" />
    <ProjectReference Include="..\..\..\foundation\security\Fdw.Security.Hashing\Fdw.Security.Hashing.csproj" />

    <!-- Credential service domain (header config, typed-body provider, runtime provider) -->
    <!-- Merged from Fdw.Services.Credentials (fold 6) -->
    <ProjectReference Include="..\Fdw.Services.Credentials.Abstractions\Fdw.Services.Credentials.Abstractions.csproj" />

    <!-- POCO Mapper + ManagedConfiguration generation -->
    <ProjectReference Include="..\..\..\configuration\Fdw.Configuration.Abstractions\Fdw.Configuration.Abstractions.csproj" />
    <!-- Why: PrivateAssets="all" prevents the generated attribute types (e.g. ManagedConfigurationAttribute)
         from flowing transitively to consumers, which would cause CS0436 conflicts when a downstream
         project also references Configuration.SourceGenerators. -->
    <ProjectReference Include="..\..\..\configuration\Fdw.Configuration.SourceGenerators\Fdw.Configuration.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\foundation\collections\Fdw.Collections\Fdw.Collections.csproj" />
    <ProjectReference Include="..\..\..\foundation\collections\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\data\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\data\Fdw.Data.SourceGenerators\Fdw.Data.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />

    <!-- DataGateway (connection-type-agnostic data access for typed-body provider) -->
    <ProjectReference Include="..\..\..\data\Fdw.Services.Data.Abstractions\Fdw.Services.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\commands\Fdw.Commands.Data\Fdw.Commands.Data.csproj" />
    <ProjectReference Include="..\..\..\commands\Fdw.Commands.Data.Fluency\Fdw.Commands.Data.Fluency.csproj" />

    <!-- Microsoft Extensions (external packages) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Merged from Fdw.Services.DataVault.MsSql (fold 7) -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\secretmanagers\Fdw.Services.SecretManagers.Abstractions\Fdw.Services.SecretManagers.Abstractions.csproj" />
    <ProjectReference Include="..\..\secretmanagers\Fdw.Services.SecretManagers\Fdw.Services.SecretManagers.csproj" />
    <ProjectReference Include="..\..\..\identity\authentication\Fdw.Services.Authentication.Abstractions\Fdw.Services.Authentication.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\foundation\messagelogging\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\foundation\messagelogging\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.Services.DataVault.Abstractions\Fdw.Services.DataVault.Abstractions.csproj" />
    <!-- Merged from Fdw.Services.DataVault.MsSql (fold 7) -->
    <ProjectReference Include="..\..\..\connections\Fdw.Services.Connections.MsSql\Fdw.Services.Connections.MsSql.csproj" />
    <ProjectReference Include="..\..\..\connections\Fdw.Services.Connections.Abstractions\Fdw.Services.Connections.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\foundation\services\Fdw.Services\Fdw.Services.csproj" />
    <ProjectReference Include="..\..\..\foundation\services\Fdw.Services.Abstractions\Fdw.Services.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\configuration\Fdw.Configuration\Fdw.Configuration.csproj" />
    <ProjectReference Include="..\Fdw.Services.DataVault\Fdw.Services.DataVault.csproj" />
    <ProjectReference Include="..\Fdw.Services.Credentials\Fdw.Services.Credentials.csproj" />
    <ProjectReference Include="..\..\..\foundation\validation\Fdw.Validation\Fdw.Validation.csproj" />
  </ItemGroup>

</Project>
