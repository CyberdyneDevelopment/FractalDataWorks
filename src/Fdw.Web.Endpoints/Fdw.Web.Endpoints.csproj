<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Fdw.Web.Endpoints</RootNamespace>

    <!-- NuGet Package Properties -->
    <PackageId>Fdw.Web.Endpoints</PackageId>
    <Title>Fdw.Web.Endpoints</Title>
    <Description>Shared DTOs, base classes, and infrastructure for Fdw REST API endpoints.</Description>
    <Authors>Fdw</Authors>
    <PackageTags>fdw;endpoints;fastendpoints;api;management;dto</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Services.SessionState.Abstractions\Fdw.Services.SessionState.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fdw.Messages\Fdw.Messages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
  </ItemGroup>

</Project>
