<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>netstandard2.0</TargetFramework>
    
    <!-- Language and Compiler Settings -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA1202;SA1201;SA1208;</NoWarn>
    <!-- Roslyn type comparison logic is inherently branchy - raise conventions thresholds -->
    <FDW_MaxCyclomaticComplexity>25</FDW_MaxCyclomaticComplexity>
    
    <!-- Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    
    <!-- Source Generator Specific -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- Build Settings -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnablePackageValidation>false</EnablePackageValidation>
    
    <!-- NuGet Package Properties -->
    <PackageTags>testing;code-generation;roslyn;compilation;csharp</PackageTags>
    <PackageDescription>C# testing utilities for Fdw CodeBuilder - compile and test generated code</PackageDescription>
    
    <!-- Strong Naming -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)..\..\Fdw.snk')">$(MSBuildThisFileDirectory)..\..\Fdw.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  
  
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="System.Runtime.Loader" />
    
    <!-- Build Tools -->
    <!-- These are provided by Directory.Build.props -->
  </ItemGroup>


  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Fdw.CodeBuilder.Analysis\Fdw.CodeBuilder.Analysis.csproj" />
    <ProjectReference Include="..\Fdw.CodeBuilder.Abstractions\Fdw.CodeBuilder.Abstractions.csproj" />
  </ItemGroup>
</Project>
