@page "/orchestration"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components

<PageTitle>Orchestration - Cyberdyne</PageTitle>

<OrchestrationNodeProvider>
    <ChildContent Context="ctx">
        <div>
            <PageHeader Eyebrow="Pipelines & Scheduling" Title="Orchestration" Subtitle="Orchestration nodes — hierarchical execution policy.">
                <Actions>
                    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/orchestration/edit")'>
                        New Node
                    </button>
                </Actions>
            </PageHeader>

            <div class="filters">
                <input type="text"
                       class="finput u-flex-1"
                       placeholder="Search nodes..."
                       value="@ctx.SearchString"
                       @oninput="e => ctx.OnSearchStringChanged(e.Value?.ToString() ?? string.Empty)" />
            </div>

            @if (ctx.ErrorMessage is not null)
            {
                <div class="card b-fail" style="margin-bottom:14px;padding:14px 16px;">
                    <span class="mono u-fs-12" style="color:var(--signal);">@ctx.ErrorMessage</span>
                </div>
            }

            @if (ctx.IsLoading)
            {
                <div class="card fdw-empty-square">
                    <span class="mono u-fg-n500">Loading nodes…</span>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-h"><h3>Root Nodes</h3></div>
                    <div class="card-b fdw-table-body">
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Stage Policy</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var node in ctx.FilteredRootNodes)
                                {
                                    <tr>
                                        <td>
                                            <button class="cellpad nm u-bg-none u-b-0" style="cursor:pointer;text-align:left;font-family:inherit;"
                                                    @onclick='() => Nav.NavigateTo($"/orchestration/edit/{node.Id}")'>
                                                @node.Name
                                            </button>
                                        </td>
                                        <td class="mut">
                                            @(node.Description ?? "-")
                                        </td>
                                        <td>
                                            @if (node.IsEnabled)
                                            {
                                                <span class="badge b-ok"><span class="bd"></span>Enabled</span>
                                            }
                                            else
                                            {
                                                <span class="badge b-idle"><span class="bd"></span>Disabled</span>
                                            }
                                        </td>
                                        <td class="mut">
                                            @(node.StageFailurePolicy ?? "inherit")
                                        </td>
                                        <td>
                                            <div class="actions">
                                                <button class="btn btn-ghost btn-sm"
                                                        @onclick='() => Nav.NavigateTo($"/orchestration/edit/{node.Id}")'>
                                                    Edit
                                                </button>
                                                <button class="btn btn-ghost btn-sm u-fg-signal"
                                                        @onclick="() => DeleteNode(ctx, node.Id)">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!ctx.FilteredRootNodes.Any())
                                {
                                    <tr>
                                        <td colspan="5" style="padding:32px;text-align:center;color:var(--n-500);">
                                            No orchestration nodes found.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</OrchestrationNodeProvider>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private async Task DeleteNode(OrchestrationNodeContext ctx, Guid id)
    {
        await ctx.OnDeleteNode(id);
    }
}
