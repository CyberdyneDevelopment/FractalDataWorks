@namespace Fdw.Web.Analytics.Components.Promotions
@using Fdw.UI.Providers
@using Fdw.Results
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Web.Analytics.Clients.ApiClients
@using Fdw.Web.Analytics.Clients.Models
@using Fdw.Web.Analytics.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    // ── Parameters ──────────────────────────────────────────────────────────────

    [Parameter] public RenderFragment<PromotionContext>? ChildContent { get; set; }

    // ── Injected Services ───────────────────────────────────────────────────────

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private PromotionApiClient? _promotionApi;
    [Inject] private ILogger<PromotionProvider>? LoggerParam { get; set; }

    private ILogger<PromotionProvider> _logger = NullLogger<PromotionProvider>.Instance;

    // ── State ───────────────────────────────────────────────────────────────────

    private IReadOnlyList<PromotionPayload> _requests = [];
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private PromotionContext _context = new();
    private bool _initialized;

    // ── Lifecycle ───────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _promotionApi = new PromotionApiClient(HttpClientFactory.CreateClient("PromotionClient"), LoggerFactory?.CreateLogger<PromotionApiClient>()!);
        _logger = LoggerParam ?? NullLogger<PromotionProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadRequests();
        }
    }

    // ── Private Operations ─────────────────────────────────────────────────────

    private async Task<IGenericResult> LoadRequests(CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        PromotionProviderLog.LoadStarted(_logger);

        try
        {
            var result = await _promotionApi!.GetPendingPromotions(ct);
            if (!result.IsSuccess)
            {
                PromotionProviderLog.LoadFailed(_logger);
                _lastResult = result;
                _requests = [];
                return result;
            }

            _requests = result.Value?.ToList() ?? [];
            PromotionProviderLog.LoadCompleted(_logger, _requests.Count);
            return result;
        }
        catch (OperationCanceledException)
        {
            return ProviderContextBase.Cancelled();
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(PromotionProviderLog.LoadException(_logger, ex));
            _requests = [];
            return _lastResult;
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleCreate(CreatePromotionPayload request, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        PromotionProviderLog.Creating(_logger, request.Name);

        try
        {
            var result = await _promotionApi!.CreatePromotion(request, ct);
            if (!result.IsSuccess)
            {
                PromotionProviderLog.CreateFailed(_logger, request.Name);
                _lastResult = result;
                return;
            }

            PromotionProviderLog.Created(_logger, request.Name);
            await LoadRequests(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(PromotionProviderLog.CreateException(_logger, ex, request.Name));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleApprove(Guid id, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        PromotionProviderLog.Approving(_logger, id);

        try
        {
            var result = await _promotionApi!.ApprovePromotion(id, ct);
            if (!result.IsSuccess)
            {
                PromotionProviderLog.ApproveFailed(_logger, id);
                _lastResult = result;
                return;
            }

            PromotionProviderLog.Approved(_logger, id);
            await LoadRequests(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(PromotionProviderLog.ApproveException(_logger, ex, id));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task HandleReject(Guid id, CancellationToken ct = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        PromotionProviderLog.Rejecting(_logger, id);

        try
        {
            var result = await _promotionApi!.RejectPromotion(id, ct);
            if (!result.IsSuccess)
            {
                PromotionProviderLog.RejectFailed(_logger, id);
                _lastResult = result;
                return;
            }

            PromotionProviderLog.Rejected(_logger, id);
            await LoadRequests(ct);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(PromotionProviderLog.RejectException(_logger, ex, id));
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    // ── Context Builder ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new PromotionContext
        {
            Requests = _requests,
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnCreate = request => HandleCreate(request),
            OnApprove = id => HandleApprove(id),
            OnReject = id => HandleReject(id),
            OnRefresh = () => LoadRequests()
        };
    }
}
