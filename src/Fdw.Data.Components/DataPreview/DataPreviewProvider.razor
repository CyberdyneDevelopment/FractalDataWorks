@namespace Fdw.Data.Components.DataPreview
@using Fdw.UI.Providers
@using Fdw.Results
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Services.Data.Clients
@using Fdw.Services.Data.Clients.Models
@using Fdw.Data.Components.Logging
@using System.Net.Http

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    /// <summary>
    /// Headless provider for data preview mode selection, DataStore/DataSet loading, and connection selection.
    /// No UI markup.
    /// </summary>
    /// <remarks>
    /// Headless chain:
    /// <list type="bullet">
    ///   <item><description>Consumer (before): page shells with markup only</description></item>
    ///   <item><description>This (provider): <see cref="DataPreviewProvider"/> — owns loading state, exposes via <see cref="DataPreviewContext"/></description></item>
    ///   <item><description>Context (after): <see cref="DataPreviewContext"/> — sealed; passed to consumer RenderFragment</description></item>
    /// </list>
    /// </remarks>
    [Parameter] public RenderFragment<DataPreviewContext>? ChildContent { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }

    private DataStoreApiClient? _dataStoreApi;
    private DataSetApiClient? _dataSetApi;
    [Inject] private ILogger<DataPreviewProvider>? LoggerParam { get; set; }

    private ILogger<DataPreviewProvider> _logger = NullLogger<DataPreviewProvider>.Instance;

    // ── Mode ───────────────────────────────────────────────────────────────────

    private string _mode = PreviewModes.DataStore.Name;

    // ── DataStore state ────────────────────────────────────────────────────────

    private IReadOnlyList<DataStoreSummaryPayload> _dataStoreList = [];
    private string _selectedDataStoreName = string.Empty;
    private DataStoreDetailPayload? _selectedDataStoreDetail;
    private DataStoreContainerPayload? _selectedContainer;
    private string _dsPathName = string.Empty;
    private string _dsContainerName = string.Empty;
    private bool _isLoadingDataStores;
    private bool _isLoadingDataStoreDetail;
    private bool _dataStoresLoaded;

    // ── DataSet state ──────────────────────────────────────────────────────────

    private IReadOnlyList<DataSetSummaryPayload> _dataSets = [];
    private string _selectedDataSetName = string.Empty;
    private DataSetDetailPayload? _selectedDataSetDetail;
    private bool _isLoadingDataSets;
    private bool _dataSetsLoaded;

    // ── Connection/Table state ─────────────────────────────────────────────────

    private string _selectedConnection = string.Empty;
    private string _dataSetConnection = string.Empty;
    private string _schemaName = string.Empty;
    private string _tableName = string.Empty;
    private int _maxRows = 100;

    // ── Error ──────────────────────────────────────────────────────────────────

    private IGenericResult? _lastResult;

    // ── Context ────────────────────────────────────────────────────────────────

    private DataPreviewContext _context = new();
    private bool _initialized;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _dataStoreApi = new DataStoreApiClient(HttpClientFactory.CreateClient("DataStoreClient"), LoggerFactory?.CreateLogger<DataStoreApiClient>()!);
        _dataSetApi = new DataSetApiClient(HttpClientFactory.CreateClient("DataSetClient"), LoggerFactory?.CreateLogger<DataSetApiClient>()!);
        _logger = LoggerParam ?? NullLogger<DataPreviewProvider>.Instance;
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadDataStores();
            StateHasChanged();
        }
    }

    // ── Public Methods (exposed as callbacks via DataPreviewContext) ───────────

    /// <summary>Loads all available DataStores from the API. Lazy-load guard: no-op if already loaded.</summary>
    public async Task LoadDataStores(CancellationToken cancellationToken = default)
    {
        if (_dataStoresLoaded) return;

        _isLoadingDataStores = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        DataPreviewProviderLog.LoadingDataStores(_logger);

        try
        {
            var result = await _dataStoreApi!.GetDataStores(cancellationToken);
            if (result.IsSuccess && result.Value is not null)
            {
                _dataStoreList = result.Value;
                _dataStoresLoaded = true;
                DataPreviewProviderLog.LoadedDataStores(_logger, _dataStoreList.Count);
            }
            else
            {
                DataPreviewProviderLog.LoadDataStoresFailed(
                    _logger, new InvalidOperationException(result.CurrentMessage ?? "API returned failure"));
                _lastResult = result;
                _dataStoreList = [];
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { DataPreviewProviderLog.LoadDataStoresFailed(_logger, ex) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            _dataStoreList = [];
        }
        finally
        {
            _isLoadingDataStores = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    /// <summary>Called when the user selects a DataStore. Resets container state and loads detail.</summary>
    public async Task OnDataStoreChanged(string dataStoreName, CancellationToken cancellationToken = default)
    {
        _selectedDataStoreName = dataStoreName;
        _selectedDataStoreDetail = null;
        _selectedContainer = null;
        _dsPathName = string.Empty;
        _dsContainerName = string.Empty;
        _lastResult = null;

        RebuildContext();
        StateHasChanged();

        if (string.IsNullOrEmpty(dataStoreName))
        {
            return;
        }

        _isLoadingDataStoreDetail = true;
        RebuildContext();
        StateHasChanged();

        DataPreviewProviderLog.LoadingDataStoreDetail(_logger, dataStoreName);

        try
        {
            var result = await _dataStoreApi!.GetDataStore(dataStoreName, cancellationToken);
            if (result.IsSuccess && result.Value is not null)
            {
                _selectedDataStoreDetail = result.Value;
                DataPreviewProviderLog.LoadedDataStoreDetail(_logger, dataStoreName);
            }
            else
            {
                DataPreviewProviderLog.LoadDataStoreDetailFailed(
                    _logger,
                    new InvalidOperationException(result.CurrentMessage ?? "API returned failure"),
                    dataStoreName);
                _lastResult = result;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { DataPreviewProviderLog.LoadDataStoreDetailFailed(_logger, ex, dataStoreName) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
        }
        finally
        {
            _isLoadingDataStoreDetail = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    /// <summary>Called when the user clicks a container in the DataStore schema browser.</summary>
    public Task OnContainerSelected(DataStorePathPayload path, DataStoreContainerPayload container, CancellationToken cancellationToken = default)
    {
        _dsPathName = path.PhysicalPath;
        _dsContainerName = container.PhysicalName;
        _selectedContainer = container;

        DataPreviewProviderLog.ContainerSelected(_logger, _dsPathName, _dsContainerName);

        RebuildContext();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Loads all available DataSets from the API. Lazy-load guard: no-op if already loaded.</summary>
    public async Task LoadDataSets(CancellationToken cancellationToken = default)
    {
        if (_dataSetsLoaded) return;

        _isLoadingDataSets = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        DataPreviewProviderLog.LoadingDataSets(_logger);

        try
        {
            var result = await _dataSetApi!.GetDataSets(cancellationToken);
            if (result.IsSuccess && result.Value is not null)
            {
                _dataSets = result.Value;
                _dataSetsLoaded = true;
                DataPreviewProviderLog.LoadedDataSets(_logger, _dataSets.Count);
            }
            else
            {
                DataPreviewProviderLog.LoadDataSetsFailed(
                    _logger, new InvalidOperationException(result.CurrentMessage ?? "API returned failure"));
                _lastResult = result;
                _dataSets = [];
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(new[] { DataPreviewProviderLog.LoadDataSetsFailed(_logger, ex) }.Concat(ExceptionResultExtensions.FlattenException(ex)));
            _dataSets = [];
        }
        finally
        {
            _isLoadingDataSets = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    /// <summary>Called when the user selects a DataSet. Loads detail for field display.</summary>
    public async Task OnDataSetChanged(string dataSetName, CancellationToken cancellationToken = default)
    {
        _selectedDataSetName = dataSetName;
        _selectedDataSetDetail = null;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        if (string.IsNullOrEmpty(dataSetName))
        {
            return;
        }

        DataPreviewProviderLog.LoadingDataSetDetail(_logger, dataSetName);

        try
        {
            var result = await _dataSetApi!.GetDataSet(dataSetName, cancellationToken);
            if (result.IsSuccess && result.Value is not null)
            {
                _selectedDataSetDetail = result.Value;
                DataPreviewProviderLog.LoadedDataSetDetail(_logger, dataSetName);
            }
            else
            {
                DataPreviewProviderLog.LoadDataSetDetailFailed(
                    _logger,
                    new InvalidOperationException(result.CurrentMessage ?? "API returned failure"),
                    dataSetName);
                _lastResult = result;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(DataPreviewProviderLog.LoadDataSetDetailFailed(_logger, ex, dataSetName));
        }
        finally
        {
            RebuildContext();
            StateHasChanged();
        }
    }

    /// <summary>Called when the user changes the DataSet connection override.</summary>
    public Task OnDataSetConnectionChanged(string connectionName, CancellationToken cancellationToken = default)
    {
        _dataSetConnection = connectionName;
        RebuildContext();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Called when the user switches preview mode. Triggers lazy data loading as needed.</summary>
    public async Task OnModeChanged(string mode, CancellationToken cancellationToken = default)
    {
        _mode = mode;
        DataPreviewProviderLog.ModeChanged(_logger, mode);
        RebuildContext();
        StateHasChanged();

        if (PreviewModes.ByName(mode) == PreviewModes.DataSet)
        {
            await LoadDataSets(cancellationToken);
        }
        else if (PreviewModes.ByName(mode) == PreviewModes.DataStore)
        {
            await LoadDataStores(cancellationToken);
        }
    }

    /// <summary>Called when the user selects a connection in Table mode. Resets schema/table state.</summary>
    public Task OnConnectionChanged(string connectionName, CancellationToken cancellationToken = default)
    {
        _selectedConnection = connectionName;
        _schemaName = string.Empty;
        _tableName = string.Empty;
        RebuildContext();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Called when the user clicks a table or view in the schema browser tree.</summary>
    public Task OnTableSelected(string schemaName, string tableName, CancellationToken cancellationToken = default)
    {
        _schemaName = schemaName;
        _tableName = tableName;
        DataPreviewProviderLog.TableSelected(_logger, schemaName, tableName);
        RebuildContext();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Called when the user changes the max-rows value.</summary>
    public Task OnMaxRowsChanged(int maxRows, CancellationToken cancellationToken = default)
    {
        _maxRows = maxRows;
        RebuildContext();
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ── Private Helpers ────────────────────────────────────────────────────────

    private void RebuildContext()
    {
        _context = new DataPreviewContext
        {
            Mode = _mode,
            DataStores = _dataStoreList,
            SelectedDataStoreName = _selectedDataStoreName,
            SelectedDataStoreDetail = _selectedDataStoreDetail,
            SelectedContainer = _selectedContainer,
            DsPathName = _dsPathName,
            DsContainerName = _dsContainerName,
            IsLoadingDataStores = _isLoadingDataStores,
            IsLoadingDataStoreDetail = _isLoadingDataStoreDetail,
            DataSets = _dataSets,
            SelectedDataSetName = _selectedDataSetName,
            SelectedDataSetDetail = _selectedDataSetDetail,
            IsLoadingDataSets = _isLoadingDataSets,
            SelectedConnection = _selectedConnection,
            DataSetConnection = _dataSetConnection,
            SchemaName = _schemaName,
            TableName = _tableName,
            MaxRows = _maxRows,
            LastResult = _lastResult,
            OnDataStoreChanged = name => OnDataStoreChanged(name),
            OnContainerSelected = (path, container) => OnContainerSelected(path, container),
            OnDataSetChanged = name => OnDataSetChanged(name),
            OnDataSetConnectionChanged = name => OnDataSetConnectionChanged(name),
            OnModeChanged = mode => OnModeChanged(mode),
            OnConnectionChanged = name => OnConnectionChanged(name),
            OnTableSelected = (schema, table) => OnTableSelected(schema, table),
            OnMaxRowsChanged = maxRows => OnMaxRowsChanged(maxRows)
        };
    }
}
