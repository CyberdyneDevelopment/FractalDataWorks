<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Package Information -->
    <PackageId>Fdw.Data.Components</PackageId>
    <Title>Fdw Data Components</Title>
    <Description>Razor component library for Fdw Data domain UI elements.</Description>

    <!-- NuGet -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
<ProjectReference Include="..\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.Services.Data.Clients\Fdw.Services.Data.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Schema.Clients\Fdw.Schema.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Connections.Clients\Fdw.Services.Connections.Clients.csproj" />
    <ProjectReference Include="..\Fdw.UI.Pipelines.Clients.Abstractions\Fdw.UI.Pipelines.Clients.Abstractions.csproj" />
<ProjectReference Include="..\Fdw.Services.Catalog.Clients\Fdw.Services.Catalog.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Services.Data.Abstractions\Fdw.Services.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Operations.Clients\Fdw.Operations.Clients.csproj" />
    <!-- Merged from Fdw.UI.DrillDown -->
    <ProjectReference Include="..\Fdw.UI.Abstractions\Fdw.UI.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.Operations.Abstractions\Fdw.Operations.Abstractions.csproj" />
    <ProjectReference Include="..\Fdw.UI.Wizard\Fdw.UI.Wizard.csproj" />
    <ProjectReference Include="..\Fdw.UI.Components\Fdw.UI.Components.csproj" />
    <!-- Why: CalculatedDataSetProvider is a headless UI component that calls the API via
         ICalculationApiClient; the server-side domain service (Services.Calculations) is not
         available in the UI process and must not be referenced here. -->
    <ProjectReference Include="..\Fdw.Web.Calculations.Clients\Fdw.Web.Calculations.Clients.csproj" />
    <ProjectReference Include="..\Fdw.Data.DataNodes\Fdw.Data.DataNodes.csproj" />
    <ProjectReference Include="..\Fdw.Data.Configuration\Fdw.Data.Configuration.csproj" />
    <ProjectReference Include="..\Fdw.UI\Fdw.UI.csproj" />
    <ProjectReference Include="..\Fdw.Results\Fdw.Results.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="**/*.razor" Pack="true" PackagePath="razor-sources/%(RecursiveDir)" />
  </ItemGroup>
</Project>
