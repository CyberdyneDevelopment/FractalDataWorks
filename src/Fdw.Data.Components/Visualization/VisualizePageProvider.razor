@namespace Fdw.Data.Components.Visualization
@using Fdw.UI.Providers
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Threading
@using System.Threading.Tasks
@using System.Net.Http
@using Fdw.Results
@using Fdw.Services.Data.Clients
@using Fdw.Services.Data.Clients.Models
@using Fdw.UI.Abstractions.Charts
@using Fdw.Data.Components.Logging

@*
    Headless provider for the Visualize (chart) page.
    Owns dataset list loading, preview fetching, chart model construction, and encoding management.
    No UI markup — all rendering is delegated to the consumer via ChildContent.
*@

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    /// <summary>
    /// The consumer RenderFragment that receives a <see cref="VisualizeContext"/>.
    /// </summary>
    [Parameter] public RenderFragment<VisualizeContext>? ChildContent { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }
    [Inject] private ILogger<VisualizePageProvider>? LoggerParam { get; set; }

    private DataSetApiClient? _dataSetApi;
    private ILogger<VisualizePageProvider> _logger = NullLogger<VisualizePageProvider>.Instance;

    // ── State ──────────────────────────────────────────────────────────────────

    private IReadOnlyList<DataSetSummaryPayload> _dataSets = [];
    private string _selectedDataSetName = string.Empty;
    private IReadOnlyList<string> _columns = [];
    private IReadOnlyList<IReadOnlyDictionary<string, object?>> _rows = [];
    private IReadOnlyList<IChartType> _chartTypes = [];
    private string _selectedChartTypeName = string.Empty;

    // Why: role name → column name; keyed with Ordinal comparison (registry names are case-sensitive).
    private Dictionary<string, string> _encodingBindings = new(StringComparer.Ordinal);

    private ChartModel? _chartModel;
    private bool _isLoading;
    private IGenericResult? _lastResult;
    private bool _initialized;
    private VisualizeContext _context = new();

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _dataSetApi = new DataSetApiClient(
            HttpClientFactory.CreateClient("DataSetClient"),
            LoggerFactory?.CreateLogger<DataSetApiClient>()!);
        _logger = LoggerParam ?? NullLogger<VisualizePageProvider>.Instance;

        // Populate chart type list from the TypeCollection (no API call needed).
        _chartTypes = ChartTypes.All().ToList();
        if (_chartTypes.Count > 0)
            _selectedChartTypeName = _chartTypes[0].Name;

        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadDataSets();
        }
    }

    // ── Private Helpers ────────────────────────────────────────────────────────

    private async Task LoadDataSets(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _lastResult = null;
        RebuildContext();
        StateHasChanged();

        VisualizationProviderLog.LoadingDataSets(_logger);

        try
        {
            var result = await _dataSetApi!.GetDataSets(cancellationToken);
            if (!result.IsSuccess)
            {
                // Why: the result already carries its own code, message chain and root cause -- propagate it
                // whole rather than extracting a string, which is what discarded the diagnosis before.
                VisualizationProviderLog.LoadDataSetsFailed(_logger, result.CurrentMessage ?? string.Empty);
                _lastResult = result;
                _dataSets = [];
            }
            else
            {
                _dataSets = result.Value?.ToList() ?? [];
                VisualizationProviderLog.DataSetsLoaded(_logger, _dataSets.Count);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(VisualizationProviderLog.LoadDataSetsException(_logger, ex));
            _dataSets = [];
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task SelectDataSet(string dataSetName, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(dataSetName)) return;

        _isLoading = true;
        _lastResult = null;
        _selectedDataSetName = dataSetName;
        _columns = [];
        _rows = [];
        _encodingBindings = new Dictionary<string, string>(StringComparer.Ordinal);
        RebuildContext();
        StateHasChanged();

        VisualizationProviderLog.PreviewingDataSet(_logger, dataSetName);

        try
        {
            var result = await _dataSetApi!.PreviewDataSet(
                dataSetName,
                new DataPreviewRequestPayload { MaxRows = 500 },
                cancellationToken);

            if (!result.IsSuccess)
            {
                // Why: pass the result's own failure message through; if it carried none, log a
                // distinct fail-loud event — never substitute a fabricated default (NO FALLBACKS rule).
                // Why: the result already carries its own code, message chain and root cause --
                // propagate it whole rather than extracting a string, which is what discarded the
                // diagnosis before.
                VisualizationProviderLog.PreviewFailed(_logger, dataSetName, result.CurrentMessage ?? string.Empty);
                _lastResult = result;
                _columns = [];
                _rows = [];
            }
            else
            {
                var preview = result.Value;
                if (preview is null || preview.Rows.Count == 0)
                {
                    // Why: fail-loud per FDW conventions — do not fabricate rows or silently show an empty chart.
                    VisualizationProviderLog.PreviewFailed(
                        _logger, dataSetName, "Preview returned 0 rows");
                    _lastResult = result;
                    _columns = [];
                    _rows = [];
                }
                else
                {
                    _columns = preview.Columns.Select(c => c.Name).ToList();
                    _rows = preview.Rows;
                    VisualizationProviderLog.PreviewLoaded(_logger, dataSetName, _rows.Count, _columns.Count);
                    RebuildChartModel();
                }
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _lastResult = GenericResult.Failure(VisualizationProviderLog.PreviewException(_logger, dataSetName, ex));
            _columns = [];
            _rows = [];
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private async Task SelectChartType(string chartTypeName, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrEmpty(chartTypeName)) return;
        if (string.Equals(_selectedChartTypeName, chartTypeName, StringComparison.Ordinal)) return;

        _selectedChartTypeName = chartTypeName;
        // Why: encodings are role-specific — reset when chart type changes so stale bindings don't carry over.
        _encodingBindings = new Dictionary<string, string>(StringComparer.Ordinal);
        VisualizationProviderLog.ChartTypeSelected(_logger, chartTypeName);
        RebuildChartModel();
        RebuildContext();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task BindEncoding(string roleName, string columnName, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrEmpty(roleName)) return;
        _encodingBindings[roleName] = columnName;
        VisualizationProviderLog.EncodingBound(_logger, roleName, columnName);
        RebuildChartModel();
        RebuildContext();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task HandleChartTypeChanged(IChartType chartType, CancellationToken cancellationToken = default)
    {
        // Why: ChartHost raises this when its own dropdown changes chart type — sync our state.
        if (chartType == ChartTypes.NotFound) return;
        await SelectChartType(chartType.Name, cancellationToken);
    }

    private void RebuildChartModel()
    {
        if (string.IsNullOrEmpty(_selectedDataSetName)) return;

        var chartType = ChartTypes.ByName(_selectedChartTypeName);
        if (chartType == ChartTypes.NotFound) return;

        var encodings = new List<ChartEncoding>();
        foreach (var binding in _encodingBindings)
        {
            if (string.IsNullOrEmpty(binding.Value)) continue;
            var role = ChartEncodingRoles.ByName(binding.Key);
            if (role == ChartEncodingRoles.NotFound) continue;
            encodings.Add(new ChartEncoding(role, binding.Value));
        }

        _chartModel ??= new ChartModel();
        _chartModel.Title = _selectedDataSetName;
        _chartModel.ChartType = chartType;
        _chartModel.DataSource = new ChartDataSource(_selectedDataSetName);
        _chartModel.Encodings = encodings;
    }

    private void RebuildContext()
    {
        _context = new VisualizeContext
        {
            DataSets = _dataSets,
            SelectedDataSetName = _selectedDataSetName,
            Columns = _columns,
            Rows = _rows,
            ChartTypes = _chartTypes,
            ChartModel = _chartModel,
            SelectedChartTypeName = _selectedChartTypeName,
            EncodingBindings = new Dictionary<string, string>(_encodingBindings, StringComparer.Ordinal),
            IsLoading = _isLoading,
            LastResult = _lastResult,
            OnSelectDataSet = name => SelectDataSet(name),
            OnSelectChartType = name => SelectChartType(name),
            OnBindEncoding = (role, col) => BindEncoding(role, col),
            OnChartTypeChanged = ct => HandleChartTypeChanged(ct)
        };
    }
}
