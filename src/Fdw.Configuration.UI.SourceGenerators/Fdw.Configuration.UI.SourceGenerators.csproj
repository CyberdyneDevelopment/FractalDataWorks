<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>

    <!-- Package Information -->
    <PackageId>Fdw.Configuration.UI.SourceGenerators</PackageId>
    <Title>Fdw Configuration UI Source Generators</Title>
    <Description>Incremental source generator that creates Web, Blazor, and TUI components from [PersistConfiguration] attributes.</Description>
    <PackageTags>sourcegenerator;roslyn;ui;blazor;tui;codegen</PackageTags>

    <!-- Source Generator Packaging -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Source generators are inherently branchy - raise conventions thresholds -->
    <FDW_MaxCyclomaticComplexity>30</FDW_MaxCyclomaticComplexity>
    <FDW_MaxMethodLines>100</FDW_MaxMethodLines>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />

    <!-- Project References -->
    <ProjectReference Include="..\Fdw.SourceGenerators\Fdw.SourceGenerators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the generator into the analyzer directory -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

    <!-- Include dependencies in package -->
    <None Include="$(OutputPath)\Fdw.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
