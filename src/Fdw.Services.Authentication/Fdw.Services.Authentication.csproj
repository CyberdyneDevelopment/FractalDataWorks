  <!-- Why a FrameworkReference: the inbound-token validation domain registers ASP.NET authentication
       schemes, and JwtBearer ships in the Microsoft.AspNetCore.App shared framework. Same shape
       Fdw.Services.Authorization already uses for the authorization bridge. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Why a package and not the FrameworkReference above: JwtBearer is the one authentication handler
       that ships outside the Microsoft.AspNetCore.App shared framework. Microsoft.Extensions.* comes
       from the FrameworkReference. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

