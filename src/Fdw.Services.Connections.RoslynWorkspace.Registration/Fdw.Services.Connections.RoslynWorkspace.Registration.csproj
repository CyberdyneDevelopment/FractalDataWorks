<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Why: inherited from the implementation. Microsoft.Build.Locator refuses (MSBL001) any
         Microsoft.Build.* PackageReference lacking ExcludeAssets=runtime/PrivateAssets=all, and
         transitive pinning materializes exactly such a reference for Microsoft.Build.Framework.
         The implementation opts out for the same reason; referencing it inherits the problem. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Fdw.Services.Connections.RoslynWorkspace.Registration</RootNamespace>

    <PackageId>Fdw.Services.Connections.RoslynWorkspace.Registration</PackageId>
    <Description>The Roslyn workspace connection service-type registration: the [ServiceTypeOption] only. References the implementation, so referencing THIS package brings the implementation with it and registers the option.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Why the implementation and not the reverse: referencing the implementation gets you its
         factory, service and configuration with no registration; referencing this package gets you
         the registration as well. Registration is opt-in, so a library can depend on the
         implementation without silently registering an option into its consumer's collection. -->
    <ProjectReference Include="..\Fdw.Services.Connections.RoslynWorkspace\Fdw.Services.Connections.RoslynWorkspace.csproj" />
  </ItemGroup>

</Project>
