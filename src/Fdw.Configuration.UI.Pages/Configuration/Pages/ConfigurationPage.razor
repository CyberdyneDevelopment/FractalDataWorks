@page "/configuration"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Configuration - Cyberdyne</PageTitle>

<ConfigurationPageProvider>
    <ChildContent Context="page">
        @{ var ctx = page.Inner; }
        <div>
            <PageHeader Eyebrow="System" Title="Configuration" Subtitle="Database-backed configuration POCOs — DDL, validators and UI are generated per domain.">
                <Actions>
                </Actions>
            </PageHeader>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="danger u-mb-14"><div class="t"><p>@_errorMessage</p></div></div>
            }

            @if (ctx.IsLoading && ctx.Types.Count == 0)
            {
                <div class="split">
                    <div class="card"><div class="card-b" style="padding:20px;color:var(--n-500);">Loading…</div></div>
                    <div class="card"><div class="card-b" style="padding:20px;color:var(--n-500);">Loading…</div></div>
                </div>
            }
            else
            {
                <div class="split">
                    <!-- Category Sidebar -->
                    <div class="card">
                        <div class="card-h"><h3>Categories</h3></div>
                        <div class="card-b" style="padding:0 8px 12px;">
                            <nav>
                                @foreach (var category in ctx.Types)
                                {
                                    <button class="nav-item @(string.Equals(_selectedCategory, category.Category, StringComparison.Ordinal) ? "active" : "") u-bg-transparent u-b-0"
                                            style="width:100%;text-align:left;cursor:pointer;flex-direction:column;align-items:flex-start;gap:2px;"
                                            @onclick="() => SelectCategory(category, ctx, page)">
                                        <div style="display:flex;justify-content:space-between;width:100%;align-items:center;">
                                            <span>@category.Category</span>
                                            <span class="tpill">@category.TypeName</span>
                                        </div>
                                        <div class="mono u-fs-10" style="color:var(--n-500);">@category.Name</div>
                                    </button>
                                }
                            </nav>
                            @if (ctx.Types.Count == 0)
                            {
                                <div class="u-fs-13" style="padding:16px;text-align:center;color:var(--n-500);">No configuration types found</div>
                            }
                        </div>
                    </div>

                    <!-- Instance Detail -->
                    <div>
                        @if (string.IsNullOrEmpty(_selectedCategory))
                        {
                            <EmptyState SquarePadding="true" Class="u-fg-n500">
                                <p class="u-fs-13">Select a category to view and manage configuration instances.</p>
                            </EmptyState>
                        }
                        else
                        {
                            <div style="display:flex;flex-direction:column;gap:14px;">
                                <!-- Instances List -->
                                <div class="card">
                                    <div class="card-h">
                                        <div>
                                            <h3>@_selectedCategory / @_selectedTypeName</h3>
                                            <span class="meta">@ctx.Instances.Count INSTANCES</span>
                                        </div>
                                        <button class="btn btn-primary btn-sm" @onclick="ShowCreateForm">
                                            <Icon Name="AddAlt" />
                                            New Instance
                                        </button>
                                    </div>
                                    <div class="card-b" style="padding:0 8px 8px;">
                                        @if (_instancesLoading)
                                        {
                                            <div style="padding:32px;text-align:center;color:var(--n-500);">Loading…</div>
                                        }
                                        else if (ctx.Instances.Count == 0)
                                        {
                                            <div class="u-fs-13" style="padding:32px;text-align:center;color:var(--n-500);">No instances configured.</div>
                                        }
                                        else
                                        {
                                            <div class="act">
                                                @foreach (var inst in ctx.Instances)
                                                {
                                                    <div class="a" style="justify-content:space-between;align-items:center;cursor:pointer;"
                                                         @onclick="() => SelectInstance(inst.Name, ctx)">
                                                        <div style="display:flex;align-items:center;gap:12px;">
                                                            <span class="nm u-fw-500" style="color:var(--n-100);">@inst.Name</span>
                                                            <span class="badge b-ok"><span class="bd"></span>Active</span>
                                                        </div>
                                                        <div style="display:flex;align-items:center;gap:8px;">
                                                            <button class="btn btn-ghost btn-sm danger"
                                                                    @onclick="() => DeleteInstance(inst.Name, ctx)" @onclick:stopPropagation="true">
                                                                <Icon Name="Delete" />
                                                            </button>
                                                            <Icon Name="ChevronRight" Style="width:15px;height:15px;color:var(--n-600);" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Instance Detail / Edit Form -->
                                @if (_selectedInstance != null)
                                {
                                    <div class="card">
                                        <div class="card-h"><h3>@_selectedInstance.Name</h3></div>
                                        <div class="card-b">
                                            @foreach (var prop in _selectedInstanceValues)
                                            {
                                                <div class="frow">
                                                    <label>@prop.Key</label>
                                                    @if (IsSecretField(prop.Key))
                                                    {
                                                        <div style="display:flex;gap:8px;">
                                                            <input class="finput mono u-flex-1" type="@(_revealedFields.Contains(prop.Key) ? "text" : "password")"
                                                                   value="@prop.Value"
                                                                   @onchange="e => UpdateProperty(prop.Key, e.Value?.ToString() ?? string.Empty)" />
                                                            <button class="btn btn-secondary btn-sm" @onclick="() => ToggleReveal(prop.Key)">
                                                                @(_revealedFields.Contains(prop.Key) ? "Hide" : "Show")
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input class="finput" value="@prop.Value"
                                                               @onchange="e => UpdateProperty(prop.Key, e.Value?.ToString() ?? string.Empty)" />
                                                    }
                                                </div>
                                            }
                                            <div style="display:flex;gap:8px;padding-top:8px;border-top:1px solid var(--hair);">
                                                <button class="btn btn-primary btn-sm" @onclick="() => SaveInstance(ctx)">Save</button>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Create Form -->
                                @if (_showCreateForm)
                                {
                                    <div class="card">
                                        <div class="card-h"><h3>New Instance</h3></div>
                                        <div class="card-b">
                                            <div class="frow">
                                                <label>Name</label>
                                                <input class="finput" @bind="_newInstanceName" placeholder="Instance name" />
                                            </div>
                                            @if (page.TypeProperties.Count > 0)
                                            {
                                                @foreach (var prop in page.TypeProperties)
                                                {
                                                    <div class="frow">
                                                        <label>
                                                            @prop.Name
                                                            @if (prop.IsRequired)
                                                            {
                                                                <span class="danger">*</span>
                                                            }
                                                        </label>
                                                        <input class="finput" placeholder="@(prop.DefaultValue ?? string.Empty)"
                                                               @onchange="e => _newInstanceProperties[prop.Name] = e.Value?.ToString() ?? string.Empty" />
                                                        @if (!string.IsNullOrEmpty(prop.Description))
                                                        {
                                                            <p class="hint">@prop.Description</p>
                                                        }
                                                    </div>
                                                }
                                            }
                                            <div style="display:flex;gap:8px;padding-top:8px;border-top:1px solid var(--hair);">
                                                <button class="btn btn-primary btn-sm" @onclick="() => CreateInstance(ctx)">Create</button>
                                                <button class="btn btn-ghost btn-sm" @onclick="() => _showCreateForm = false">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</ConfigurationPageProvider>

@code {

    [Inject] private ILogger<ConfigurationPage> Logger { get; set; } = default!;

    private bool _instancesLoading;
    private ConfigurationInstanceDetailPayload? _selectedInstance;
    private Dictionary<string, object?> _selectedInstanceValues = new();
    private string _selectedCategory = "";
    private string _selectedTypeName = "";
    private bool _showCreateForm;
    private string _newInstanceName = "";
    private string _newServiceType = "";
    private Dictionary<string, object?> _newInstanceProperties = new(StringComparer.OrdinalIgnoreCase);
    private string? _errorMessage;
    private HashSet<string> _revealedFields = new();

    private async Task SelectCategory(ConfigurationTypeSummary type, ConfigurationContext ctx, ConfigurationPageContext page)
    {
        _selectedCategory = type.Category;
        _selectedTypeName = type.Name;
        _newServiceType = type.ServiceType;
        _selectedInstance = null;
        _showCreateForm = false;
        _instancesLoading = true;
        ConfigurationLog.TypeSelected(Logger, type.Name);

        try
        {
            var instancesTask = ctx.OnLoadInstances(type.Category);
            var typeDetailTask = page.OnLoadTypeDetail(type.Category, type.ServiceType);
            await Task.WhenAll(instancesTask, typeDetailTask);
            ConfigurationLog.InstancesLoaded(Logger, type.Name, ctx.Instances.Count);
            if (page.TypeProperties.Count == 0)
            {
                ConfigurationLog.NoPropertiesDefined(Logger, type.Name);
            }
        }
        catch (HttpRequestException ex)
        {
            ConfigurationLog.ConfigurationOperationFailed(Logger, ex, type.Name);
        }
        catch (TaskCanceledException) { PageLog.OperationCancelled(Logger, nameof(Configuration), "selectCategory"); }
        finally
        {
            _instancesLoading = false;
        }
    }

    private async Task SelectInstance(string name, ConfigurationContext ctx)
    {
        try
        {
            var result = await ctx.OnGetInstanceDetails(_selectedCategory, name);
            _selectedInstance = result;
            _selectedInstanceValues = _selectedInstance?.Values != null
                ? new Dictionary<string, object?>(_selectedInstance.Values, StringComparer.OrdinalIgnoreCase)
                : new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            _showCreateForm = false;
            ConfigurationLog.InstanceLoaded(Logger, name);
        }
        catch (HttpRequestException ex)
        {
            ConfigurationLog.ConfigurationOperationFailed(Logger, ex, _selectedTypeName);
        }
        catch (TaskCanceledException) { PageLog.OperationCancelled(Logger, nameof(Configuration), "selectInstance"); }
    }

    private void ShowCreateForm()
    {
        _showCreateForm = true;
        _selectedInstance = null;
        _newInstanceName = "";
        _newInstanceProperties = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
    }

    private async Task CreateInstance(ConfigurationContext ctx)
    {
        if (string.IsNullOrWhiteSpace(_newInstanceName)) return;
        _errorMessage = null;

        try
        {
            var result = await ctx.OnCreateInstance(_selectedCategory, new CreateConfigurationInstanceRequest
            {
                ServiceType = _newServiceType,
                Name = _newInstanceName,
                Values = _newInstanceProperties
            });
            if (result is null)
            {
                _errorMessage = "Failed to create instance";
                return;
            }
            ConfigurationLog.InstanceCreated(Logger, _selectedTypeName);
            _showCreateForm = false;
            await ctx.OnLoadInstances(_selectedCategory);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            ConfigurationLog.ConfigurationOperationFailed(Logger, ex, _selectedTypeName);
        }
    }

    private void UpdateProperty(string key, string value)
    {
        _selectedInstanceValues[key] = value;
    }

    private async Task SaveInstance(ConfigurationContext ctx)
    {
        if (_selectedInstance == null) return;
        _errorMessage = null;
        try
        {
            var result = await ctx.OnUpdateInstance(_selectedCategory, _selectedInstance.Name, new UpdateConfigurationInstanceRequest
            {
                Values = _selectedInstanceValues
            });
            if (result is null)
            {
                _errorMessage = "Failed to update instance";
                return;
            }
            ConfigurationLog.InstanceUpdated(Logger, _selectedInstance.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            ConfigurationLog.ConfigurationOperationFailed(Logger, ex, _selectedTypeName);
        }
    }

    private async Task DeleteInstance(string name, ConfigurationContext ctx)
    {
        _errorMessage = null;
        try
        {
            await ctx.OnDeleteInstance(_selectedCategory, name);
            ConfigurationLog.InstanceDeleted(Logger, name);
            await ctx.OnLoadInstances(_selectedCategory);
            if (_selectedInstance?.Name == name)
                _selectedInstance = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            ConfigurationLog.ConfigurationOperationFailed(Logger, ex, _selectedTypeName);
        }
    }

    private bool IsSecretField(string key) =>
        key.Contains("Password", StringComparison.OrdinalIgnoreCase) ||
        key.Contains("Secret", StringComparison.OrdinalIgnoreCase) ||
        key.Contains("Key", StringComparison.OrdinalIgnoreCase) ||
        key.Contains("Token", StringComparison.OrdinalIgnoreCase);

    private void ToggleReveal(string key)
    {
        if (!_revealedFields.Remove(key))
            _revealedFields.Add(key);
    }
}
