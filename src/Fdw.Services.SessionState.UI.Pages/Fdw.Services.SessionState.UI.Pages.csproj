<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Why: razor component namespaces derive from RootNamespace + folder path. Holding the
         original root keeps every generated component namespace identical to the consolidated
         package, so no page type's typeof(...) reference has to change. -->
    <RootNamespace>Fdw.UI.Pages</RootNamespace>
    <PackageId>Fdw.Services.SessionState.UI.Pages</PackageId>
    <Title>Fdw SessionState UI Pages</Title>
    <Description>Razor pages for the SessionState domain.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fdw.UI\Fdw.UI.csproj" />
    <ProjectReference Include="..\Fdw.Services.SessionState.Components\Fdw.Services.SessionState.Components.csproj" />
  </ItemGroup>

</Project>
