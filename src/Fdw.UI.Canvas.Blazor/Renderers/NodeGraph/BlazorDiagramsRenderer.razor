@namespace Fdw.UI.Canvas.Blazor.Renderers.NodeGraph
@using System.Linq
@using Fdw.UI.Abstractions.Canvas
@using Microsoft.AspNetCore.Components

@* Why: render guard — Model is EditorRequired but guard against null defensively since Blazor
   can render before parameters are set in some prerender paths. *@
@if (Model is null)
{
    return;
}

<div style="position:relative;width:100%;height:100%;display:flex;flex-direction:column;background:#08090b;">

    @* ── Blazor Diagrams canvas ───────────────────────────────────────────────────── *@
    @* Why: the vendor <DiagramCanvas> (Blazor.Diagrams.Components) and its CascadingValue wrapper
       are emitted from the code-behind via RenderTreeBuilder (RenderDiagramCanvas), not as markup
       tags. A razor @using for the vendor namespace would bind "Blazor" to THIS package
       (Fdw.UI.Canvas.Blazor) and fail to resolve; the code-behind resolves it through
       a file-scoped using that binds in the global namespace where the vendor's "Blazor" wins. *@
    <div style="flex:1;width:100%;height:100%;overflow:hidden;">
        @RenderDiagramCanvas
    </div>

    @* ── Canvas title ─────────────────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(Model.Title))
    {
        <div style="position:absolute;top:10px;left:14px;font-family:monospace;font-size:12px;color:#64748b;pointer-events:none;">
            @Model.Title
        </div>
    }

    @* ── Empty state ─────────────────────────────────────────────────────────────── *@
    @if (!Model.Nodes.Any())
    {
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
            <span style="font-family:monospace;font-size:12px;color:#334155;">No nodes to display.</span>
        </div>
    }

</div>
