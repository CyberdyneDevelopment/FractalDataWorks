<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fdw.Data.DataStores.SqlServer</RootNamespace>
    <AssemblyName>Fdw.Data.DataStores.SqlServer</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\configuration\Fdw.Configuration.Abstractions\Fdw.Configuration.Abstractions.csproj" />
    <ProjectReference Include="..\..\foundation\results\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\..\foundation\messagelogging\Fdw.Messages\Fdw.Messages.csproj" />
    <ProjectReference Include="..\..\foundation\messagelogging\Fdw.MessageLogging.Abstractions\Fdw.MessageLogging.Abstractions.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Data.Builders\Fdw.Data.Builders.csproj" />
    <ProjectReference Include="..\..\foundation\collections\Fdw.Collections\Fdw.Collections.csproj" />

    <!-- Source Generators -->
    <ProjectReference Include="..\..\foundation\messagelogging\Fdw.MessageLogging.SourceGenerators\Fdw.MessageLogging.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\foundation\collections\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\data\Fdw.Data.Importers.Abstractions\Fdw.Data.Importers.Abstractions.csproj" />
    <ProjectReference Include="..\..\connections\Fdw.Services.Connections\Fdw.Services.Connections.csproj" />
    <ProjectReference Include="..\..\connections\Fdw.Services.Connections.MsSql\Fdw.Services.Connections.MsSql.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Services.Data.Abstractions\Fdw.Services.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\data\Fdw.Services.Data\Fdw.Services.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>
  <ItemGroup>
    <!-- A connection or storage adapter: it may use ADO.NET directly (FDW052, FDW-3579). -->
    <AssemblyAttribute Include="Fdw.Conventions.DataAccessAdapterAttribute" />
  </ItemGroup>

</Project>
