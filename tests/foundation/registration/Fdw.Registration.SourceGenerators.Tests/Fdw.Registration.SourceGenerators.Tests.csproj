<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <Include>[Fdw.Registration.SourceGenerators]*</Include>
    <Exclude></Exclude>
    <Threshold>75</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source Generator Testing -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" />
    <!-- Test packages inherited from tests/Directory.Build.props -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\foundation\registration\Fdw.Registration.SourceGenerators\Fdw.Registration.SourceGenerators.csproj" />
    <ProjectReference Include="..\..\..\..\src\foundation\collections\Fdw.Collections\Fdw.Collections.csproj" />
    <ProjectReference Include="..\..\..\..\src\foundation\results\Fdw.Results\Fdw.Results.csproj" />
    <ProjectReference Include="..\..\..\..\src\configuration\Fdw.Configuration\Fdw.Configuration.csproj" />
    <ProjectReference Include="..\..\..\..\src\data\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
  </ItemGroup>

</Project>
