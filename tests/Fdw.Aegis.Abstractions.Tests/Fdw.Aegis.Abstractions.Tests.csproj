<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Aegis.Abstractions\Fdw.Aegis.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Aegis.Configuration\Fdw.Aegis.Configuration.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Only include the two Phase 0 Aegis packages in coverage -->
    <Include>[Fdw.Aegis.Abstractions]*,[Fdw.Aegis.Configuration]*</Include>
    <!-- Exclude everything else -->
    <Exclude>[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
