    <ProjectReference Include="..\..\..\..\src\secrets\secretmanagers\Fdw.Services.SecretManagers\Fdw.Services.SecretManagers.csproj" />
    <!-- Why here and not in the test project: the Implementation module-initializer generator scans
         REFERENCED assemblies only, never the compilation it runs in. An option declared alongside the
         generator is silently never registered, so the option must live in its own assembly that the
         consumer references. -->
    <ProjectReference Include="..\..\..\..\src\foundation\collections\Fdw.Collections.SourceGenerators\Fdw.Collections.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

