<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Emit generated files for debugging -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Services.EtlMappers.Dynamic\Fdw.Services.EtlMappers.Dynamic.csproj" />
    <!-- Why Pooled as well: EtlRowMapperTypesTests asserts over the EtlRowMapperTypes collection with
         BOTH mapper types in the compilation, since each declares RestrictToCurrentCompilation. -->
    <ProjectReference Include="..\..\src\Fdw.Services.EtlMappers.Pooled\Fdw.Services.EtlMappers.Pooled.csproj" />
    <!-- Registration generator scans referenced assemblies and generates module initializers in this entry point -->
    <ProjectReference Include="..\..\src\Fdw.Registration.SourceGenerators\Fdw.Registration.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>
</Project>
