<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Data.Transformers.Abstractions\Fdw.Data.Transformers.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <Include>[Fdw.Data.Transformers.Abstractions]*</Include>
    <Exclude>[Fdw.Collections]*;[Fdw.Results]*;[xunit.*]*;[Moq]*;[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
