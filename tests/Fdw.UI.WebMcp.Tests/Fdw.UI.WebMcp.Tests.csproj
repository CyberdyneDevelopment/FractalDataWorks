<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.UI.WebMcp\Fdw.UI.WebMcp.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Aui.Abstractions\Fdw.Aui.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Results\Fdw.Results.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why: xunit.v3, xunit.runner.visualstudio, Shouldly, Moq, coverlet.collector are
         auto-included for all *.Tests projects via tests/Directory.Build.props — declaring
         them again here trips NU1504 (duplicate PackageReference). Only the extras unique to
         this bUnit project are listed. -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
