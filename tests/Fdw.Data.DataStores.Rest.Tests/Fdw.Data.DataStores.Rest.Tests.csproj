<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Data.DataStores.Rest\Fdw.Data.DataStores.Rest.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Only include Fdw.Data.DataStores.Rest in coverage -->
    <Include>[Fdw.Data.DataStores.Rest]*</Include>
    <!-- Exclude everything else -->
    <Exclude>[Fdw.*.Abstractions]*,[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>