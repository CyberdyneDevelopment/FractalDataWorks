<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="configurationSchema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="config-data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Why: Connectors.Abstractions (netstandard2.0) pulls Microsoft.Bcl.AsyncInterfaces 6.0.0
         as a transitive dep. Pinning here resolves the MSB3277 version conflict with net10.0. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Services.Connections.FileSystem\Fdw.Services.Connections.FileSystem.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Registration.SourceGenerators\Fdw.Registration.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Fdw.Data.RowSources.Json\Fdw.Data.RowSources.Json.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Data.RowSources.Xml\Fdw.Data.RowSources.Xml.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Data.RowSources.Delimited\Fdw.Data.RowSources.Delimited.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Data.RowSources.FixedWidth\Fdw.Data.RowSources.FixedWidth.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Services.SecretManagers\Fdw.Services.SecretManagers.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Services.SecretManagers.EnvironmentVariable\Fdw.Services.SecretManagers.EnvironmentVariable.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Services.Data\Fdw.Services.Data.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Commands.Data\Fdw.Commands.Data.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Commands.Data.Fluency\Fdw.Commands.Data.Fluency.csproj" />
    <ProjectReference Include="..\Fdw.Services.SecretManagers.TestDouble\Fdw.Services.SecretManagers.TestDouble.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Services.Connections.FileSystem.Registration\Fdw.Services.Connections.FileSystem.Registration.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <Include>[Fdw.Services.Connections.FileSystem]*</Include>
    <Exclude>[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
