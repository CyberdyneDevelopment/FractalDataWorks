<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.CodeBuilder.Analysis.CSharp\Fdw.CodeBuilder.Analysis.CSharp.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Only include Fdw.CodeBuilder.Analysis.CSharp in coverage -->
    <Include>[Fdw.CodeBuilder.Analysis.CSharp]*</Include>
    <!-- Exclude everything else -->
    <Exclude>[Fdw.*.Abstractions]*,[Fdw.Messages]*,[Fdw.EnhancedEnums]*,[Fdw.Abstractions]*</Exclude>
  </PropertyGroup>
</Project>
