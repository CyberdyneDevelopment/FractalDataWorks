<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Why: Microsoft.Build.Locator refuses (MSBL001) any Microsoft.Build.* PackageReference that
         lacks ExcludeAssets=runtime/PrivateAssets=all. Transitive pinning materializes exactly
         such a reference for Microsoft.Build.Framework, so this project opts out. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Roslyn.Commands\Fdw.Roslyn.Commands.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Roslyn.Commands.Abstractions\Fdw.Roslyn.Commands.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Workspace.Roslyn\Fdw.Workspace.Roslyn.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Results\Fdw.Results.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Only include Fdw.Roslyn.Commands in coverage -->
    <Include>[Fdw.Roslyn.Commands]*</Include>
    <!-- Exclude everything else -->
    <Exclude>[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
