    <ProjectReference Include="..\..\..\src\foundation\messagelogging\Fdw.Messages\Fdw.Messages.csproj" />
    <ProjectReference Include="..\..\..\src\data\Fdw.Services.Data\Fdw.Services.Data.csproj" />
