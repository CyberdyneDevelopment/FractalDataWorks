<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Why: Microsoft.Build.Locator refuses (MSBL001) any Microsoft.Build.* PackageReference that
         lacks ExcludeAssets=runtime/PrivateAssets=all. Transitive pinning materializes exactly
         such a reference for Microsoft.Build.Framework, so this project opts out. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Workspace.Management\Fdw.Workspace.Management.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why: transitive of MSBuild family — Build.Locator's MSBL001 check forbids its runtime DLL
         being copied to bin/ (would conflict with MSBuild's in-process copy). Compile-only. -->
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
