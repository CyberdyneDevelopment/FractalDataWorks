<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;Release;Test</Configurations>
    <IsPublicProject>true</IsPublicProject>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fdw.Data\Fdw.Data.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Data.Abstractions\Fdw.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Data.DataSets\Fdw.Data.DataSets.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Data.DataSets.Abstractions\Fdw.Data.DataSets.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Fdw.Commands.Abstractions\Fdw.Commands.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Include Fdw.Data.DataSets and DataSets.Abstractions in coverage -->
    <Include>[Fdw.Data.DataSets]*,[Fdw.Data.DataSets.Abstractions]*</Include>
    <!-- Exclude everything else -->
    <Exclude>[Fdw.Messages]*,[Fdw.EnhancedEnums]*,[Fdw.Abstractions]*,[Fdw.Results]*,[Fdw.Collections]*,[Fdw.Configuration]*</Exclude>
  </PropertyGroup>
</Project>
