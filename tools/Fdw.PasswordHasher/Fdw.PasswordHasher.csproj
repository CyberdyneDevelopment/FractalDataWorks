<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Fdw.PasswordHasher</RootNamespace>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fdw-hash</ToolCommandName>
    <PackageId>Fdw.PasswordHasher</PackageId>
    <Title>Fdw Password Hasher</Title>
    <Description>CLI for hashing and verifying passwords using FDW's exact Pbkdf2PasswordHashAlgorithm. Produces bytes-for-bytes identical output to runtime auth so seed hashes can be generated and verified offline.</Description>
    <PackageTags>fdw;cli;password;hash;pbkdf2;verify</PackageTags>

    <!-- Why: Exclude from main solution build by default; ServiceManager pattern -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Why: Use the actual FDW algorithm so verifier output matches the running app exactly. -->
    <ProjectReference Include="..\..\src\Fdw.Security.Hashing\Fdw.Security.Hashing.csproj" />
  </ItemGroup>

</Project>
