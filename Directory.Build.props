<Project>
  <PropertyGroup>
	  <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Suppress the verbose pruning output -->
    <NuGetPruneVerbosity>quiet</NuGetPruneVerbosity>
	  <!-- Language version and framework settings -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Build configuration settings -->
    <!-- Base configs: Debug, Develop, Release, Test -->
    <Configurations>Debug;Develop;Release;Test</Configurations>


    <!-- Build settings -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    
    <!-- Package settings -->
    <!-- Default to not packable, src projects override below -->
    <IsPackable>false</IsPackable>
    <IsPackable Condition="$(MSBuildProjectDirectory.Contains('/src/')) OR $(MSBuildProjectDirectory.Contains('\src\'))">true</IsPackable>

    <Authors>Fdw Team</Authors>
    <Company>Cyberdyne Development</Company>
    <Copyright>Copyright © $(Company) $([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/CyberdyneDevelopment/FractalDataWorks.git</RepositoryUrl>
    <PackageDescription>Development tools and utilities for the Fdw ecosystem.</PackageDescription>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Suppress SourceLink warning when not in CI (source control info not available locally) -->
    <WarnOnNonCIBuild Condition="'$(CI)' != 'true'">false</WarnOnNonCIBuild>
    <!-- Disable SourceLink when not in CI to avoid warnings about missing source control info -->
    <EnableSourceLink Condition="'$(CI)' != 'true'">false</EnableSourceLink>
    
    <!-- Symbol packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Include README.md in NuGet packages (only if it exists) -->
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)\README.md')">README.md</PackageReadmeFile>
    
    <!-- Central Package Management -->
	  <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Exclude samples from central package management and global settings -->
    <ManagePackageVersionsCentrally Condition="$(MSBuildProjectDirectory.Contains('/samples/')) OR $(MSBuildProjectDirectory.Contains('\samples\'))">false</ManagePackageVersionsCentrally>
    
    <!-- Disable specific warnings globally (one per line: code — description — justification) -->
    <NoWarn>$(NoWarn)</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD200</NoWarn>   <!-- Use Async suffix — FDW convention omits Async suffix on all methods -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>      <!-- Identifiers should not match keywords — FDW uses Execute, Default etc. C#-only repo -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>      <!-- No static members on generic types — TypeCollection pattern requires them -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>      <!-- Use LoggerMessage delegates — FDW uses its own MessageLogging source generator -->
    <NoWarn>$(NoWarn);CA1834</NoWarn>      <!-- Use StringBuilder.Append(char) — unavailable in netstandard2.0 targets -->
    <NoWarn>$(NoWarn);MA0051</NoWarn>      <!-- Method is too long — replaced by FDW006 (lines) + FDW007 (complexity) with [ConventionOverride] support -->
    <NoWarn>$(NoWarn);MA0048</NoWarn>      <!-- File name must match type name — replaced by FDW005 with MoveTypeToFile code fix support -->
    <NoWarn>$(NoWarn);FDW011</NoWarn>     <!-- Misplaced implementation type (warning) — not enforced yet, pending architectural review -->
    <NoWarn>$(NoWarn);NU5123</NoWarn>     <!-- NuGet long path warning — only affects legacy systems without long path support -->

    <NoWarn>$(NoWarn);CA1711</NoWarn>      <!-- Identifiers should not have incorrect suffix — FDW uses Collection, Permission suffixes intentionally -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>      <!-- Identifiers should not contain underscores — allows _camelCase for private/protected fields -->
    <NoWarn>$(NoWarn);NETSDK1195</NoWarn>  <!-- .NET SDK trimming warning — not relevant for non-trimmed builds -->
    
    
  </PropertyGroup>

  <!-- Conventions Analyzer Configuration -->
  <PropertyGroup>
    <FDW_MaxMethodLines>60</FDW_MaxMethodLines>
    <FDW_MaxCyclomaticComplexity>15</FDW_MaxCyclomaticComplexity>
    <FDW_DefaultStringComparison>Ordinal</FDW_DefaultStringComparison>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="FDW_MaxMethodLines" />
    <CompilerVisibleProperty Include="FDW_MaxCyclomaticComplexity" />
    <CompilerVisibleProperty Include="FDW_DefaultStringComparison" />
  </ItemGroup>

  <!--
    Ship .razor source files in all packable UI packages so consuming apps can run
    Tailwind CSS against the actual component source. Files land at:
      {package-id}/{version}/razor-sources/**/*.razor
    in the NuGet global packages folder. BuildAction=None prevents recompilation
    in consuming projects — these files are for Tailwind scanning only.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="**/*.razor"
          Pack="true"
          PackagePath="razor-sources/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- Debug: Minimal checks for fast development -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <AnalysisLevel>none</AnalysisLevel>
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Develop: Development with analyzers, warnings not errors -->
  <PropertyGroup Condition="'$(Configuration)' == 'Develop'">
    <DefineConstants>TRACE;DEVELOP</DefineConstants>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RunAnalyzers>true</RunAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <ReportAnalyzer>true</ReportAnalyzer>
  </PropertyGroup>

  <!-- Release: Production ready, strict checks -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE;RELEASE</DefineConstants>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RunAnalyzers>true</RunAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Test: Test builds -->
  <PropertyGroup Condition="'$(Configuration)' == 'Test'">
    <DefineConstants>TRACE;TEST</DefineConstants>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <AnalysisLevel>none</AnalysisLevel>
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Target Framework for Fdw.net -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fdw.net'">
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <!-- IsExternalInit package for netstandard2.0 projects (required for init-only properties) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="IsExternalInit" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- FrozenDictionary polyfill for netstandard2.0 Abstractions projects -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' AND $(MSBuildProjectName.Contains('Abstractions'))">
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>


  <!-- Version: EXPLICIT and hand-set, and since the allocated release (FDW-4784) only the LINE. The major.minor of VersionPrefix is the line that
       development builds and consumers float on (<FdwLine>); a release gives each package that changed its OWN version, decided by
       the release tooling from the built public API (public/tools/versioning, scripts/release-allocated.sh), and passes it for that
       project only. Nothing here stamps a released package. Moving the line is the /version-bump skill.

       Why not MinVer/tag inference: the line must change only when we decide it changes.

       When no release passes a version (a local build), the package version is VersionPrefix + optional -VersionSuffix
       => 1.0.2 + rc.1 = 1.0.2-rc.1 (SemVer 2.0, 3-digit + prerelease). AssemblyVersion/FileVersion are the 4-part form
       (1.0.0.0) because assembly identity is always 4-part and cannot carry a prerelease tag; NuGet normalizes the trailing zero
       revision away. A release sets both per assembly: FileVersion from the package's x.y.z, AssemblyVersion never below the floor
       the baseline release recorded (a dll that is not rebuilt asks for its dependencies at the version it was built against). -->
  <PropertyGroup>
    <VersionPrefix>1.5.7</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>

  <!-- Microsoft.Build.Framework for MSBuild/Roslyn workspace projects -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Fdw.Tools.')) OR $(MSBuildProjectName) == 'Fdw.Workspace.Roslyn'">
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Source Link -->
  <ItemGroup Condition="!$(MSBuildProjectDirectory.Contains('/samples/')) AND !$(MSBuildProjectDirectory.Contains('\samples\'))">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Include README.md in package if it exists -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Analyzers - Applied to all projects except samples -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' AND !$(MSBuildProjectDirectory.Contains('/samples/')) AND !$(MSBuildProjectDirectory.Contains('\samples\'))">
    <PackageReference Include="AsyncFixer" PrivateAssets="All" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="All" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="All" />
    <PackageReference Include="SecurityCodeScan.VS2019" PrivateAssets="All" />
  </ItemGroup>

  <!-- Fdw Code Style Analyzers - Applied to all projects except samples and the analyzers themselves -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' AND !$(MSBuildProjectDirectory.Contains('/samples/')) AND !$(MSBuildProjectDirectory.Contains('\samples\')) AND '$(MSBuildProjectName)' != 'Fdw.Analyzers' AND '$(MSBuildProjectName)' != 'Fdw.CodeFixes' AND '$(MSBuildProjectName)' != 'Fdw.Conventions.Analyzers' AND '$(MSBuildProjectName)' != 'Fdw.Conventions.CodeFixes' AND '$(MSBuildProjectName)' != 'Fdw.ServiceTypes.Analyzers' AND '$(MSBuildProjectName)' != 'Fdw.Collections.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\foundation\analyzers\Fdw.Analyzers\Fdw.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\foundation\analyzers\Fdw.CodeFixes\Fdw.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\foundation\analyzers\Fdw.Conventions.Analyzers\Fdw.Conventions.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\foundation\analyzers\Fdw.Conventions.CodeFixes\Fdw.Conventions.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\foundation\analyzers\Fdw.ServiceTypes.Analyzers\Fdw.ServiceTypes.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\foundation\collections\Fdw.Collections.Analyzers\Fdw.Collections.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>