<?xml version="1.0" encoding="utf-8"?>
<!--
  Default NuGet configuration for FractalDataWorks solution.

  LOCAL DEVELOPMENT WORKFLOW:
  ==========================
  1. Setup (one-time):
     PowerShell:   .\scripts\powershell\setup-local-nuget.ps1 [-Path C:\development\local-nuget]
     Bash:         ./scripts/bash/setup-local-nuget.sh [path]

  2. Set environment variable:
     PowerShell:   $env:LocalNugetFolder = "C:\development\local-nuget"
     Bash:         export LocalNugetFolder="$HOME/development/local-nuget"

  3. Pack and test:
     PowerShell:   .\scripts\powershell\pack-local.ps1
     Bash:         ./scripts/bash/pack-local.sh

  The pack scripts will:
  - Clean old packages from local folder and NuGet cache
  - Generate Fdw.Local.nuget.config in LocalNugetFolder with source mapping
  - Pack all FractalDataWorks.* packages to local folder

  Projects in samples/ReferenceSolution automatically use local packages when:
  - LocalNugetFolder environment variable is set
  - Building in Debug/Alpha/Beta (not Release configuration)

  CI/CD builds use this default config (nuget.org only).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>