<Project>
  <!-- Why this file ships with the template: the projects reference these packages without a version,
       which only restores under central package management. It is the nearest Directory.Packages.props
       to the generated projects, so the solution restores the same way inside a repo that manages its
       versions and outside one. Move these lines into your own repo's file if you want one place for them. -->
  <PropertyGroup>
    <!-- The shared FractalDataWorks helpers float on this base, as the reference apps float theirs: the newest published version that matches. -->
    <FdwVersion>1.4.2-rc*</FdwVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Why: without this a floating PackageVersion is NU1011. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Roslyn 5.3.0 is the version the FractalDataWorks generators build against. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" />
    <PackageVersion Include="Fdw.SourceGenerators" Version="$(FdwVersion)" />
    <PackageVersion Include="Fdw.CodeBuilder.Abstractions" Version="$(FdwVersion)" />
    <PackageVersion Include="Fdw.CodeBuilder.CSharp" Version="$(FdwVersion)" />
    <!-- UseExistingRuntime=true: add a PackageVersion here for your runtime package (the template's
         ExistingRuntimePackage). Its version is yours to state, so the template does not guess one. -->
  </ItemGroup>
</Project>
